---
/**
 * Footer — brand blurb, quick links, "Built with cricket passion", copyright.
 */
import Logo from './Logo.astro';

const year = new Date().getFullYear();

const quickLinks = [
  { href: '/', label: 'Home' },
  { href: '/play', label: 'Play' },
  { href: '#eras', label: 'Eras' },
  { href: '#how', label: 'How to play' },
  { href: '#daily', label: 'Daily challenge' },
];
---
<footer class="site-footer" id="footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <a href="/" class="site-footer__brand-link" aria-label="BeatMy11 home">
        <Logo variant="full" class="site-footer__logo" />
      </a>
      <p class="site-footer__blurb">
        The all-time Test XI showdown. Spin six times, draft your legends across
        seven eras, and take the house team down in a five-match Test series.
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <h2 class="site-footer__nav-title">Quick links</h2>
      <ul class="site-footer__links">
        {quickLinks.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="site-footer__note">
      <h2 class="site-footer__nav-title">The game</h2>
      <p>
        Six spins. Two picks each. One keeper, twelve players,
        one 12th man — and a series scoreline worth bragging about.
      </p>
    </div>
  </div>

  <div class="site-footer__base">
    <p>© {year} BeatMy11. All rights reserved.</p>
    <p class="site-footer__passion">
      Built with cricket passion
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M12 21s-7.5-4.9-10-9.3C.4 8.6 2.2 5 5.7 5c2 0 3.4 1.1 4.2 2.3h4.2C14.9 6.1 16.3 5 18.3 5c3.5 0 5.3 3.6 3.7 6.7C19.5 16.1 12 21 12 21Z" opacity="0" />
        <path d="M12 21c-5.5-3.8-9-7.6-9-11.2C3 6.6 5.4 4.5 8 4.5c1.7 0 3.2.9 4 2.2.8-1.3 2.3-2.2 4-2.2 2.6 0 5 2.1 5 5.3 0 3.6-3.5 7.4-9 11.2Z" />
      </svg>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--bm11-border);
    background:
      radial-gradient(80% 120% at 50% 120%, rgba(34, 197, 94, 0.06), transparent 70%),
      var(--bm11-surface);
  }

  .site-footer__inner {
    max-width: 80rem;
    margin: 0 auto;
    padding: 3rem 1rem 2rem;
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .site-footer__inner {
      grid-template-columns: 1.4fr 1fr 1fr;
      padding: 3.5rem 1.5rem 2.5rem;
    }
  }

  .site-footer__brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--bm11-text);
    margin-bottom: 0.9rem;
  }

  .site-footer__logo {
    height: 2.75rem;
    width: auto;
    display: block;
  }

  .site-footer__blurb {
    color: var(--bm11-muted);
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0;
    max-width: 26rem;
  }

  .site-footer__nav-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--bm11-muted);
    margin: 0 0 0.9rem;
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .site-footer__links a {
    color: var(--bm11-text);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .site-footer__links a:hover,
  .site-footer__links a:focus-visible {
    color: var(--bm11-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .site-footer__note p {
    color: var(--bm11-muted);
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0;
    max-width: 24rem;
  }

  .site-footer__base {
    max-width: 80rem;
    margin: 0 auto;
    padding: 1.25rem 1rem 1.5rem;
    border-top: 1px solid var(--bm11-border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    align-items: center;
    justify-content: space-between;
  }

  .site-footer__base p {
    margin: 0;
    font-size: 0.82rem;
    color: var(--bm11-muted);
  }

  .site-footer__passion {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .site-footer__passion svg {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--bm11-primary);
  }
</style>
