---
/**
 * Navbar — sticky top nav with dark glass background.
 * Mobile shows just the brand plus a compact Play button (no burger menu);
 * the full link menu appears at 768px and up.
 */
import Logo from './Logo.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/play', label: 'Play' },
  { href: '#eras', label: 'Eras' },
  { href: '#footer', label: 'About' },
];

const isPlayPage = Astro.url.pathname.replace(/\/$/, '') === '/play';
---
<header class="navbar" id="top">
  <nav class="navbar__inner" aria-label="Primary">
    <a href="/" class="navbar__brand" aria-label="BeatMy11 home">
      <Logo variant="full" class="navbar__logo" />
    </a>

    {!isPlayPage && (
      <a class="bm11-btn bm11-btn-primary navbar__mobile-cta" href="/play">Play</a>
    )}

    <ul class="navbar__menu">
      {links.map((l) => (
        <li>
          <a class="navbar__link" href={l.href}>{l.label}</a>
        </li>
      ))}
      <li class="navbar__menu-cta">
        <a class="bm11-btn bm11-btn-primary navbar__cta" href="/play">Start Building</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bm11-bg) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--bm11-border);
  }

  .navbar__inner {
    position: relative;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0.7rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .navbar__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--bm11-text);
  }

  .navbar__logo {
    height: 2.4rem;
    width: auto;
    display: block;
  }

  .navbar__mobile-cta {
    padding: 0.55rem 1.1rem;
    font-size: 0.9rem;
    flex-shrink: 0;
  }

  .navbar__menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: none;
  }

  .navbar__link {
    display: block;
    padding: 0.75rem 0.5rem;
    color: var(--bm11-muted);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    border-radius: 0.5rem;
  }

  .navbar__link:hover,
  .navbar__link:focus-visible {
    color: var(--bm11-text);
    background: rgba(148, 163, 184, 0.08);
  }

  .navbar__menu-cta {
    margin-top: 0.5rem;
  }

  .navbar__cta {
    display: inline-flex;
    width: 100%;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .navbar__inner {
      padding: 0.7rem 1.5rem;
    }
    .navbar__mobile-cta {
      display: none;
    }
    .navbar__menu {
      display: flex;
      align-items: center;
      gap: 0.25rem;
      position: static;
      background: transparent;
      border: 0;
      padding: 0;
    }
    .navbar__link {
      padding: 0.55rem 0.85rem;
    }
    .navbar__menu-cta {
      margin: 0 0 0 0.5rem;
    }
    .navbar__cta {
      width: auto;
    }
  }
</style>
