---
/**
 * PlayerAvatar — inline SVG cricketer silhouette medallion.
 *
 * No external image URLs: the artwork is generated in frontmatter and served
 * as a data: URI, so there is nothing to fetch and nothing to fake.
 * Background is a dark radial tint of the player's era accent color.
 *
 * Props:
 *   name  - player name (used for the accessible label)
 *   era   - era id ('legends' | '1970s' | ... | '2020s'); arrays use first entry
 *   size  - tailwind size classes, default 'w-12 h-12'
 *   class - extra classes appended to the <img>
 */
interface Props {
  name: string;
  era?: string | string[];
  size?: string;
  class?: string;
}

const { name, era = 'legends', size = 'w-12 h-12', class: extraClass = '' } = Astro.props;

const ERA_ACCENTS: Record<string, string> = {
  legends: '#C9A227',
  '1970s': '#C26936',
  '1980s': '#D64045',
  '1990s': '#2AA198',
  '2000s': '#3B82F6',
  '2010s': '#8B5CF6',
  '2020s': '#2DD4BF',
};

const eraId = (Array.isArray(era) ? era[0] : era) ?? 'legends';
const accent = ERA_ACCENTS[eraId] ?? '#94A3B8';
const figure = '#DDE6F2';

// Batsman silhouette (facing left, bat raised) on an era-tinted dark medallion.
const svg =
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">` +
  `<defs><radialGradient id="bm11av" cx="35%" cy="28%" r="85%">` +
  `<stop offset="0%" stop-color="${accent}" stop-opacity="0.38"/>` +
  `<stop offset="100%" stop-color="#0D1424" stop-opacity="1"/>` +
  `</radialGradient></defs>` +
  `<circle cx="32" cy="32" r="30.5" fill="url(#bm11av)" stroke="${accent}" stroke-opacity="0.55" stroke-width="1.6"/>` +
  `<ellipse cx="30" cy="55" rx="13" ry="2.4" fill="#000000" opacity="0.35"/>` +
  `<circle cx="33" cy="12.5" r="6.4" fill="${figure}"/>` +
  `<g stroke="${figure}" stroke-linecap="round" fill="none">` +
  `<path d="M33 21 C31.5 27 30.5 32 30 38" stroke-width="9"/>` +
  `<path d="M31 27 L21 34" stroke-width="6.5"/>` +
  `<path d="M20 35 L8.5 16.5" stroke-width="6"/>` +
  `<path d="M30 38 L23 53" stroke-width="7.5"/>` +
  `<path d="M30 38 L39 52" stroke-width="7.5"/>` +
  `</g></svg>`;

const src = `data:image/svg+xml,${encodeURIComponent(svg)}`;
---
<img
  src={src}
  alt={name}
  loading="lazy"
  draggable="false"
  class={`rounded-full object-cover select-none ${size} ${extraClass}`}
  style={`--era-accent:${accent};background-color:#0D1424;`}
/>
