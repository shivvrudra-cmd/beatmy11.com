---
/**
 * matchup.astro — the five-Test series result, "Floodlit night" design
 * (rebuilt 2026-09-29).
 *
 * The client script reads the user's XI from localStorage
 * ('beatmy11.userXI.v1', slot order) and each pick's declared role from the
 * draft blob ('beatmy11.draft.v1'), scores it with the seven-metric engine,
 * then plays the series with src/lib/series.ts: the XI's rank among drafted
 * XIs (src/data/series-calibration.json) plus a seeded wobble picks the
 * scoreline, and each Test gets a venue and a headline from the side that
 * won it. The same XI always gets the same series.
 *
 * Owner decisions: the two team scores are NOT shown (the result comes from
 * the XI's rank, so raw scores side by side would read as contradictory);
 * instead the page shows the scoreline, the Test-by-Test story, the XI's
 * rank among drafts, and — revealed here for the first time — every
 * player's rating.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import type { ResultFormat } from '../lib/formats/result-format';

export interface Props {
  /** What differs per format: opponent, wording, venues, engine, sharing. */
  format: ResultFormat;
  title: string;
  description: string;
  /** The fixed opponent XI, the engine's scoring context (ranking populations) and the
   *  calibration sample for the "top X% of drafts" line, all for this format. */
  houseXI: unknown;
  scoringContext: unknown;
  calibration: unknown;
}
const { format, title, description, houseXI, scoringContext, calibration } = Astro.props;

const safe = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
const scoringContextJson = safe(scoringContext);
const houseJson = safe(houseXI);
const calibrationJson = safe(calibration);
const formatJson = safe(format);
---
<BaseLayout title={title} description={description}>
  <meta name="robots" content="noindex" slot="head" />
  <div class="rs">
    <div class="rs-lights" aria-hidden="true"></div>

    <main id="main">
      <!-- Phone: three full-screen panels, one swipe apart (see the CSS). All three are in the
           page from the start and never change height, so the page cannot move by itself; the
           contents of screens 2 and 3 stay invisible until the series has been revealed. -->
      <div class="rs-panel rs-p1">
        <header class="rs-top">
          <a class="rs-brand" href={format.homeHref} aria-label="Beat My 11 home">BEAT MY 11</a>
          <button type="button" class="rs-sound" id="rs-sound" aria-pressed="true" aria-label="Sound on. Turn sound off"></button>
        </header>

        <section class="rs-verdict" aria-labelledby="rs-title">
          <p class="rs-eyebrow">{format.eyebrow}</p>
          <h1 class="rs-title" id="rs-title">{format.startTitle}</h1>
          <div class="rs-score" aria-hidden="true">
            <div class="rs-side"><span class="rs-num" id="rs-user">0</span><span class="rs-lab">Your XI</span></div>
            <span class="rs-dash">–</span>
            <div class="rs-side"><span class="rs-num" id="rs-house">0</span><span class="rs-lab">{format.opponent}</span></div>
          </div>
          <p class="rs-sub" id="rs-sub" aria-live="polite"></p>
          <p class="rs-rank" id="rs-rank" hidden></p>
          <button type="button" class="rs-skip" id="rs-skip">Skip to result</button>
        </section>

        <ol class="rs-tests" id="rs-tests" aria-label={`The five ${format.matchPlural}`}></ol>
        <p class="rs-pots" id="rs-pots" hidden></p>
        <a class="rs-again-bottom" href={format.playHref} data-rs-again>Draft again</a>
        <a class="rs-more" id="rs-more-1" href="#rs-grade-panel" hidden>How strong was your XI <span aria-hidden="true">↓</span></a>
      </div>

      <!-- Screen 2: the XI's strength, grade and a tip (owner, 2026-10-02). -->
      <section class="rs-panel rs-pg" id="rs-grade-panel" aria-labelledby="rs-grade-title">
        <header class="rs-top">
          <a class="rs-brand" href={format.homeHref} aria-label="Beat My 11 home">BEAT MY 11</a>
        </header>
        <div class="rs-mid">
        <h2 class="rs-h2" id="rs-grade-title">How your XI measures up</h2>
        <p class="rs-note">Strength out of 100 for each part of the game.</p>
        <div class="rs-strength" id="rs-strength"></div>
        <div class="rs-overall" id="rs-overall"></div>
        <div class="rs-grade" id="rs-grade" aria-live="polite"></div>
        <p class="rs-tip" id="rs-tip"></p>
        <a class="rs-again-bottom" href={format.playHref} data-rs-again>Draft again</a>
        <a class="rs-more" href="#rs-p2">Your share card <span aria-hidden="true">↓</span></a>
        </div>
      </section>

      <div class="rs-panel rs-p2" id="rs-p2">
        <header class="rs-top">
          <a class="rs-brand" href={format.homeHref} aria-label="Beat My 11 home">BEAT MY 11</a>
        </header>
        <div class="rs-mid">
        <p class="rs-error" id="rs-error" hidden></p>
        <p class="rs-daily" id="rs-daily" hidden></p>
        <div class="rs-daily" id="rs-challenge" hidden>
          <p id="rs-challenge-text"></p>
          <button type="button" class="rs-leave" id="rs-leave">Leave the challenge</button>
        </div>

        <!-- The card's box is held open from the start, so nothing moves when the picture arrives. -->
        <figure class="rs-card" id="rs-card">
          <img id="rs-card-img" hidden width="1080" height="1350" alt="Your share card: the series scoreline and both XIs" />
        </figure>

        <div class="rs-actions" id="rs-actions">
          <button type="button" class="rs-share" id="rs-share">Share result</button>
          <a class="rs-again" href={format.playHref} data-rs-again>Draft again</a>
          <a class="rs-save" id="rs-save">Save the card</a>
          <p class="rs-copied" id="rs-copied" role="status"></p>
        </div>
        </div>
      </div>

    </main>
  </div>

  <script id="bm11-house-xi" type="application/json" set:html={houseJson} />
  <script id="bm11-scoring-context" type="application/json" set:html={scoringContextJson} />
  <script id="bm11-series-calibration" type="application/json" set:html={calibrationJson} />
  <script id="bm11-result-format" type="application/json" set:html={formatJson} />

  <script>
    import { compareXIs, teamBlend } from '../lib/seven-metrics';
    import { compareWbXIs, wbTeamBlend, WB_FORMATS } from '../lib/white-ball-metrics';
    import { playSeries, xiSeed } from '../lib/series';
    import { shareResultsFor, shareTextFor, encodeXI } from '../lib/share-results';
    import { drawShareCard, cardBlob } from '../lib/share-card';
    import { reportScore, reportEvent } from '../lib/telemetry';
    import { gradeFor, gradeTitle, shapeTitle, pickTip, pickXiTip, FULL_CREDIT_MATCHES } from '../lib/result-insights';
    import { mulberry32 } from '../lib/series';
    import { sfx, isMuted, setMuted, soundReady } from '../lib/sfx';
    import { fetchBoard, postDaily, hasPosted, canPost, boardLine } from '../lib/leaderboard';
    import {
      utcDayKey, dayNumber, loadDaily, saveDaily, recordResult, hasPlayed, currentStreak,
      activeDailyDay, dailyShareText,
    } from '../lib/daily';
    import { currentMode, switchMode, modeFor, formatOfMode, kindOfMode } from '../lib/draft-slots';
    import {
      encodeSpins, encodeSpinsWith, loadChallenge, saveChallenge, betterOf, challengeOutcome, challengeShareText, scorelineText,
    } from '../lib/challenge';

    const read = (id) => JSON.parse(document.getElementById(id).textContent || 'null');
    const HOUSE_XI = read('bm11-house-xi') || [];
    const SCORING_CONTEXT = read('bm11-scoring-context') || {};
    const CALIBRATION = read('bm11-series-calibration');
    /** Per-format wording, venues, engine and sharing (src/lib/formats/result-format.ts). */
    const FORMAT = read('bm11-result-format');
    const OPP = FORMAT.opponent;
    // Each format keeps its own saved draft; make this page's format the live one.
    // (A daily or a friend's challenge of THIS format stays live; anything else is parked.)
    if (formatOfMode(currentMode()) !== FORMAT.id) switchMode(modeFor(FORMAT.id, 'normal'));
    const SCOPE = FORMAT.id;
    const MODE_KIND = kindOfMode(currentMode());

    // ---------- normalization of stored players (lenient; never zero-fills) ----------
    const VALID_ROLES = new Set(['opener', 'middle-order', 'all-rounder', 'wicketkeeper', 'spinner', 'fast-bowler']);
    const normalizeRole = (r) => String(r ?? '').trim().toLowerCase().replace(/\s+/g, '-');
    const normalizeSecondaryRoles = (raw) => {
      const arr = Array.isArray(raw) ? raw : typeof raw === 'string' && raw ? [raw] : [];
      return arr.map(normalizeRole).filter((r) => VALID_ROLES.has(r));
    };
    const eraString = (era, fallback) => {
      const e = era ?? fallback ?? 'legends';
      return Array.isArray(e) ? String(e[0]) : String(e);
    };
    const finOrNull = (v) => { const n = Number(v); return Number.isFinite(n) ? n : null; };
    const posOrNull = (v) => { const n = Number(v); return Number.isFinite(n) && n > 0 ? n : null; };
    function toScoringPlayer(p, sourceEra) {
      const uid = String(p.uid ?? p.id ?? '');
      const inferredEra = uid.includes(':') ? uid.split(':')[0] : undefined;
      const s = p.stats ?? {};
      if (FORMAT.id !== 'test') {
        // White-ball formats: the engine reads the career stats as stored (nothing to remap).
        return {
          id: String(p.id ?? uid ?? p.name ?? ''), uid, name: String(p.name ?? ''), nation: String(p.nation ?? ''),
          era: eraString(p.draftEra ?? p.era ?? p.displayEra, sourceEra),
          primaryRole: normalizeRole(p.primaryRole), secondaryRoles: normalizeSecondaryRoles(p.secondaryRoles), stats: s,
        };
      }
      return {
        id: String(p.id ?? uid ?? p.name ?? ''),
        uid,
        name: String(p.name ?? ''),
        nation: String(p.nation ?? ''),
        era: eraString(p.draftEra ?? p.era ?? p.displayEra, inferredEra ?? sourceEra),
        primaryRole: normalizeRole(p.primaryRole),
        secondaryRoles: normalizeSecondaryRoles(p.secondaryRoles),
        stats: {
          testAverage: posOrNull(s.testAverage),
          testRuns: finOrNull(s.testRuns),
          testMatches: finOrNull(s.testMatches),
          testCenturies: finOrNull(s.testCenturies),
          testWickets: finOrNull(s.testWickets),
          testBowlingAverage: posOrNull(s.testBowlingAverage),
          bowlingAverage: posOrNull(s.bowlingAverage),
          fiveWs: finOrNull(s.fiveWs),
          tenWs: finOrNull(s.tenWs),
          dismissals: finOrNull(s.dismissals),
        },
      };
    }
    function readDeclaredRoles() {
      try {
        const draft = JSON.parse(localStorage.getItem('beatmy11.draft.v1') || 'null');
        const picks = Array.isArray(draft?.picks) ? draft.picks : [];
        const map = {};
        for (const pk of picks) if (pk && typeof pk.uid === 'string' && typeof pk.role === 'string') map[pk.uid] = pk.role;
        return map;
      } catch {
        return {};
      }
    }
    function readUserXI() {
      try {
        const arr = JSON.parse(localStorage.getItem('beatmy11.userXI.v1') || 'null');
        if (!Array.isArray(arr) || arr.length !== 11) return null;
        return arr.every((p) => p && typeof p === 'object' && (p.uid || p.id) && typeof p.name === 'string' && p.name) ? arr : null;
      } catch {
        return null;
      }
    }

    // ---------- display helpers ----------
    const esc = (v) =>
      String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    const ROLE_SHORT = { opener: 'OPN', 'middle-order': 'BAT', wicketkeeper: 'WK', 'all-rounder': 'AR', spinner: 'SPIN', 'fast-bowler': 'PACE' };
    const NATION_CODES = FORMAT.teamCodes;
    const ORDINAL = ['1st', '2nd', '3rd', '4th', '5th'];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = (id) => document.getElementById(id);
    const ROOT = document.querySelector('.rs');

    // Sounds (same mute setting as the draft). The page plays them by itself, so each one checks
    // that audio is actually running: browsers keep it suspended until the visitor taps the page.
    const play = (name, arg) => { if (soundReady()) sfx[name](arg); };
    const SOUND_ON = '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M3 10v4h4l5 4V6L7 10H3z"/><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"/></svg>';
    const SOUND_OFF = '<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M3 10v4h4l5 4V6L7 10H3z"/><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M16 9l5 6M21 9l-5 6"/></svg>';
    function renderSound() {
      const on = !isMuted();
      const b = $('rs-sound');
      b.innerHTML = on ? SOUND_ON : SOUND_OFF;
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
      b.setAttribute('aria-label', on ? 'Sound on. Turn sound off' : 'Sound off. Turn sound on');
      b.classList.toggle('is-off', !on);
    }
    $('rs-sound').addEventListener('click', () => { setMuted(!isMuted()); renderSound(); sfx.select(); });
    renderSound();
    // Any tap on the page wakes the audio, so the sounds that follow can be heard.
    document.addEventListener('pointerup', () => { soundReady(); }, { once: true });

    function verdictCopy(s) {
      if (s.user === 5) return { title: 'Whitewash.', sub: `You beat the ${OPP} five–nil. That almost never happens.` };
      if (s.house === 5) return { title: 'Whitewashed.', sub: `The ${OPP} won all five. Time for a new XI.` };
      if (s.draws === 1 && s.user === s.house) return { title: 'Series drawn', sub: `You held the ${OPP} to ${s.user}–${s.house}.` };
      if (s.user > s.house) {
        return s.user === 3
          ? { title: `You beat the ${OPP}`, sub: '' }
          : { title: `You beat the ${OPP}`, sub: `A ${s.user}–${s.house} series win. Convincing.` };
      }
      return s.house === 3
        ? { title: 'So close', sub: '' }
        : { title: `${OPP} wins`, sub: `Beaten ${s.user}–${s.house}. Your next XI could do better.` };
    }

    function testHTML(t, running) {
      const res = t.result === 'user' ? 'Won' : t.result === 'house' ? 'Lost' : FORMAT.flavour.kind !== 'test' ? 'Level' : 'Drawn';
      return (
        `<li class="rs-test is-${t.result}">` +
        `<div class="rs-test-head"><span class="rs-test-n">${ORDINAL[t.number - 1]} ${esc(FORMAT.matchNoun)} · ${esc(t.venue)}</span>` +
        `<span class="rs-chip">${res}</span></div>` +
        `<p class="rs-test-sum">${esc(t.summary)}</p>` +
        `<div class="rs-test-foot">` +
        (t.hero ? `<p class="rs-test-hero"><span aria-hidden="true">★</span> ${esc(t.hero)}${t.heroSide === 'house' ? ` <em>(${esc(OPP)})</em>` : ''}</p>` : '') +
        `<p class="rs-test-run">${running}</p>` +
        `</div>` +
        (t.also ? `<p class="rs-test-also">${esc(t.also)}${t.alsoSide === 'house' ? ` <em>(${esc(OPP)})</em>` : ' <em>(Your XI)</em>'}</p>` : '') +
        `</li>`
      );
    }

    function run() {
      const userRaw = readUserXI();
      if (!userRaw) {
        window.location.href = FORMAT.playHref;
        return;
      }
      const declared = readDeclaredRoles();
      const userEntries = userRaw.map((p) => ({
        player: toScoringPlayer(p, 'legends'),
        declaredRole: declared[String(p.uid ?? p.id ?? '')] ?? null,
      }));
      const houseEntries = HOUSE_XI.map((p) => ({ player: toScoringPlayer(p, 'legends'), declaredRole: normalizeRole(p.primaryRole) }));

      let cmp;
      try {
        cmp = FORMAT.id === 'test'
          ? compareXIs(userEntries, houseEntries, SCORING_CONTEXT)
          : compareWbXIs(userEntries, houseEntries, SCORING_CONTEXT, WB_FORMATS[FORMAT.id]);
      } catch {
        $('rs-error').hidden = false;
        $('rs-error').textContent = 'A statistic this XI needs is missing from our data, so the series can’t be played. Draft again with a different XI.';
        $('rs-skip').hidden = true;
        $('rs-more-1').hidden = false;
        $('rs-share').hidden = true;
        ROOT.classList.add('is-revealed');
        return;
      }

      const toSeries = (entries, scores) =>
        entries.map((e, i) => ({
          id: e.player.id,
          name: e.player.name,
          nation: e.player.nation,
          era: e.player.era,
          role: scores[i].role,
          rating: scores[i].score ?? 0,
          stats: e.player.stats,
        }));
      const userXI = toSeries(userEntries, cmp.userPlayers);
      const houseXI = toSeries(houseEntries, cmp.opponentPlayers);
      const series = playSeries({
        userScore: cmp.userScore,
        houseScore: cmp.opponentScore,
        userXI,
        houseXI,
        calibration: CALIBRATION,
        seed: xiSeed(userXI.map((p) => ({ id: p.id, role: p.role }))),
        flavour: FORMAT.flavour,
        parGap: FORMAT.parGap,
      });
      // Anonymous score for recalibrating the series bands (src/lib/telemetry.ts). Test only, so
      // other formats never mix into the Test calibration data.
      if (FORMAT.telemetry) reportScore({
        seed: xiSeed(userXI.map((p) => ({ id: p.id, role: p.role }))),
        userScore: cmp.userScore,
        houseScore: cmp.opponentScore,
        user: series.user,
        house: series.house,
        draws: series.draws,
      });

      // Daily Challenge: record today's result once (streak, best) and show it.
      let dailyShare = '';
      const dailyDay = utcDayKey();
      if (MODE_KIND === 'daily' && activeDailyDay(SCOPE) === dailyDay) {
        const result = { user: series.user, house: series.house, draws: series.draws };
        let state = loadDaily(SCOPE);
        const firstResult = !hasPlayed(state, dailyDay);
        if (!hasPlayed(state, dailyDay)) {
          state = recordResult(state, dailyDay, result);
          saveDaily(state, SCOPE);
          reportEvent('daily_completed', FORMAT.id);
        }
        const streak = currentStreak(state, dailyDay);
        const mine = state.results[dailyDay] || result;
        dailyShare = dailyShareText(dailyDay, mine, streak, FORMAT.id === 'test' ? {} : { label: FORMAT.dailyLabel, xiNoun: FORMAT.xiNoun, opponent: OPP });
        const el = $('rs-daily');
        el.innerHTML =
          `<strong>${FORMAT.dailyLabel ? `${esc(FORMAT.dailyLabel)} ` : ''}Daily Challenge #${dayNumber(dailyDay)}</strong> done · ` +
          (streak > 1 ? `🔥 ${streak}-day streak (best ${state.best})` : 'streak started — come back tomorrow') +
          `<span>New spins at 00:00 UTC. Everyone drafted the same draws today.</span>` +
          `<div class="rs-board" id="rs-board" hidden></div>`;
        el.hidden = false;
        // Daily leaderboard (PROPOSAL, docs/plans/daily-leaderboard.md). Shown only when the
        // board answers (it does not until the owner applies the migration) and only for the
        // day's one scored result. Nothing is sent unless the player presses the button.
        const scored = firstResult || (mine.user === series.user && mine.house === series.house);
        const boardEl = $('rs-board');
        const boardHref = `/daily-board?f=${FORMAT.id}`;
        const showStanding = (b) => {
          boardEl.innerHTML = `<p>${esc(boardLine(b, OPP))} <a href="${boardHref}">See the board</a></p>`;
          boardEl.hidden = false;
        };
        fetchBoard(FORMAT.id, dailyDay, cmp.userScore).then((b) => {
          if (!b) return;
          if (hasPosted(FORMAT.id, dailyDay) || !scored || !canPost()) { showStanding(hasPosted(FORMAT.id, dailyDay) ? b : { ...b, rank: undefined }); return; }
          boardEl.innerHTML =
            `<label class="rs-board-name">Name (optional) <input type="text" id="rs-board-name" maxlength="20" autocomplete="nickname" /></label>` +
            `<button type="button" class="rs-board-add" id="rs-board-add">Add my score to today’s board</button>`;
          boardEl.hidden = false;
          $('rs-board-add').addEventListener('click', async () => {
            $('rs-board-add').disabled = true;
            const sent = await postDaily({
              format: FORMAT.id, day: dailyDay, seed: xiSeed(userXI.map((p) => ({ id: p.id, role: p.role }))),
              score: cmp.userScore, user: series.user, house: series.house, draws: series.draws, name: $('rs-board-name').value,
            });
            if (!sent) { boardEl.innerHTML = '<p>Could not add your score. Try again later.</p>'; return; }
            const after = await fetchBoard(FORMAT.id, dailyDay, cmp.userScore);
            if (after) showStanding(after); else boardEl.innerHTML = `<p>Added. <a href="${boardHref}">See the board</a></p>`;
          });
        });
      }

      // Challenge-a-friend: compare with the scoreline to beat, count the tries.
      let challengeShare = '';
      const ch = MODE_KIND === 'challenge' ? loadChallenge(SCOPE) : null;
      if (ch) {
        const mine = { user: series.user, house: series.house };
        const best = betterOf(ch.best, mine);
        saveChallenge({ ...ch, best }, SCOPE);
        const out = challengeOutcome(ch.vs, mine);
        const tries = Math.max(1, ch.tries);
        const head =
          out === 'beat' ? `You beat your friend’s ${scorelineText(ch.vs)}!`
          : out === 'matched' ? `You matched your friend’s ${scorelineText(ch.vs)}.`
          : `Your friend’s ${scorelineText(ch.vs)} still stands.`;
        const el = $('rs-challenge-text');
        el.innerHTML =
          `<strong>${head}</strong> You got ${scorelineText(mine)} on attempt ${tries}` +
          (tries > 1 ? ` (best ${scorelineText(best)})` : '') +
          `<span>Same six spins as your friend. ${out === 'short' ? 'Redraft and try to top it.' : 'Share it back, or redraft for a better one.'}</span>`;
        $('rs-challenge').hidden = false;
        challengeShare = challengeShareText(ch.vs, mine, tries);
        reportEvent('challenge_completed', FORMAT.id);
        // "Draft again" retries the same challenge (same spins, next attempt).
        for (const a of document.querySelectorAll('[data-rs-again]')) a.setAttribute('href', `${FORMAT.playHref}?c=${encodeURIComponent(ch.spins)}&vs=${ch.vs.user}-${ch.vs.house}`);
      }

      // ---- screen 2: strength bars, overall score, grade, titles and a tip ----
      // Per-player ratings are NOT shown anywhere (owner, 2026-10-02): they taught players which
      // names to pick. The three unit strengths and the overall team score are.
      const blend = (entries) => (FORMAT.id === 'test' ? teamBlend(entries, SCORING_CONTEXT) : wbTeamBlend(entries, SCORING_CONTEXT, WB_FORMATS[FORMAT.id]));
      const mine = blend(userEntries);
      const theirs = blend(houseEntries);
      const clamp = (v) => Math.max(0, Math.min(100, v));
      const barRow = (label, v, cls) =>
        `<div class="rs-str ${cls}" role="img" aria-label="${label} ${Math.round(v)} out of 100"><span class="rs-str-lab">${label}</span>` +
        `<span class="rs-bar"><span class="rs-bar-fill" data-rs-fill="${clamp(v)}"></span></span><b class="rs-bar-val" data-rs-count="${Math.round(v)}">0</b></div>`;
      $('rs-strength').innerHTML = barRow('Batting', mine.teamBatting, '') + barRow('Bowling', mine.teamBowling, '') + barRow('Fielding', mine.teamFielding, '');
      $('rs-overall').innerHTML = barRow('Overall', cmp.userScore, 'is-overall');
      const grade = gradeFor(series.percentile);
      $('rs-grade').innerHTML =
        `<span class="rs-grade-letter">${grade}</span>` +
        `<span class="rs-grade-words"><b>${esc(gradeTitle(grade, series.user))}</b><i>${esc(shapeTitle(mine.teamBatting, mine.teamBowling))}</i></span>`;
      // The tip is about THIS XI (owner, 2026-10-02): the unit that costs most against the
      // opponent, or another true fact about the eleven. Counts and unit scores only: it never
      // names a player or shows a single rating. The same XI always reads the same tip.
      let tipText;
      try {
        const matchesOf = (e) => Number(FORMAT.id === 'test' ? e.player.stats.testMatches : e.player.stats.matches);
        const keeperAt = cmp.userPlayers.findIndex((p) => p.role === 'wicketkeeper');
        const ks = keeperAt >= 0 ? userEntries[keeperAt].player.stats : null;
        const km = ks ? Number(FORMAT.id === 'test' ? ks.testMatches : ks.matches) : 0;
        const keeperPerMatch = !ks ? null : Number.isFinite(Number(ks.dismissalsPerMatch)) && ks.dismissalsPerMatch !== null ? Number(ks.dismissalsPerMatch) : km > 0 && Number.isFinite(Number(ks.dismissals)) && ks.dismissals !== null ? Number(ks.dismissals) / km : null;
        tipText = pickXiTip(FORMAT.id, {
          mine: { batting: mine.teamBatting, bowling: mine.teamBowling, fielding: mine.teamFielding },
          theirs: { batting: theirs.teamBatting, bowling: theirs.teamBowling, fielding: theirs.teamFielding },
          opponent: OPP,
          shortCareers: userEntries.filter((e) => Number.isFinite(matchesOf(e)) && matchesOf(e) < FULL_CREDIT_MATCHES[FORMAT.id]).length,
          allRounders: cmp.userPlayers.filter((p) => p.role === 'all-rounder').length,
          overseasUsed: FORMAT.id === 'ipl' ? userRaw.filter((p) => p.overseas === true).length : undefined,
          keeperPerMatch,
        }, mulberry32(xiSeed(userEntries.map((e, i) => ({ id: e.player.id, role: cmp.userPlayers[i].role }))) ^ 0x71b5));
      } catch {
        // Fallback: a general, true statement about how scoring works.
        tipText = pickTip(FORMAT.id, {
          batting: theirs.teamBatting - mine.teamBatting,
          bowling: theirs.teamBowling - mine.teamBowling,
          fielding: theirs.teamFielding - mine.teamFielding,
        });
      }
      $('rs-tip').innerHTML = `<b>Tip</b> ${esc(tipText)}`;
      // The three bars fill together, then the overall bar, then the grade appears. Runs once,
      // when the screen scrolls into view.
      let barsPlayed = false;
      function playBars() {
        if (barsPlayed) return;
        barsPlayed = true;
        const fill = (root, ms) => {
          for (const el of root.querySelectorAll('[data-rs-fill]')) {
            el.style.transitionDuration = `${ms}ms`;
            el.style.width = `${el.getAttribute('data-rs-fill')}%`;
          }
          for (const el of root.querySelectorAll('[data-rs-count]')) {
            const to = Number(el.getAttribute('data-rs-count'));
            if (!ms) { el.textContent = String(to); continue; }
            const t0 = performance.now();
            const tick = (now) => {
              const k = Math.min(1, (now - t0) / ms);
              el.textContent = String(Math.round(to * k));
              if (k < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          }
        };
        const d = reduceMotion ? 0 : 1200;
        fill($('rs-strength'), d);
        if (d) play('bars', d);
        window.setTimeout(() => { fill($('rs-overall'), d); if (d) play('bars', d); }, d ? d + 200 : 0);
        window.setTimeout(() => { $('rs-grade-panel').classList.add('is-graded'); play('grade'); }, d ? 2 * d + 400 : 0);
      }
      if ('IntersectionObserver' in window) {
        new IntersectionObserver((entries, obs) => {
          if (entries.some((e) => e.isIntersecting)) { playBars(); obs.disconnect(); }
        }, { threshold: 0.5 }).observe($('rs-grade-panel'));
      }

      // The best pick in the user's XI: marked on the share card, without a number.
      const bestId = [...userXI].sort((a, b) => b.rating - a.rating)[0].id;

      const copy = verdictCopy(series);
      const pct = Math.round(series.percentile * 100);
      const rankText =
        series.topPercent <= 50
          ? `Your XI ranks in the top ${series.topPercent}% of all drafts.`
          : `Your XI ranks in the bottom ${Math.max(1, pct)}% of all drafts.`;

      // ---- the reveal ----
      const testsEl = $('rs-tests');
      let shown = 0;
      let u = 0;
      let h = 0;
      let timer = 0;
      let revealed = false;
      let cardFile = null; // the share card, once drawn (see "share" below)
      const finish = () => {
        window.clearTimeout(timer);
        while (shown < 5) step(true);
        $('rs-title').textContent = copy.title;
        $('rs-sub').textContent = copy.sub;
        $('rs-rank').textContent = rankText;
        $('rs-rank').hidden = false;
        $('rs-skip').hidden = true;
        $('rs-more-1').hidden = false;
        ROOT.classList.add('is-revealed');
        if (!('IntersectionObserver' in window)) playBars();
        if (series.playerOfSeries) {
          $('rs-pots').classList.toggle('is-house', series.playerOfSeries.side === 'house');
          $('rs-pots').innerHTML = `<span>Player of the series</span><b>${esc(series.playerOfSeries.name)}</b><em><i>${esc(series.playerOfSeries.stat)}</i>${series.playerOfSeries.side === 'house' ? esc(OPP) : 'Your XI'}</em>`;
          $('rs-pots').hidden = false;
        }
        revealed = true;
        play(series.user > series.house ? 'seriesWon' : series.user < series.house ? 'seriesLost' : 'seriesLevel');
        document.querySelector('.rs-verdict').classList.add(
          series.user > series.house ? 'is-win' : series.user < series.house ? 'is-loss' : 'is-draw',
          ...(series.user === 5 ? ['is-whitewash'] : []),
        );
      };
      function step(instant) {
        const t = series.tests[shown];
        if (t.result === 'user') u++;
        if (t.result === 'house') h++;
        shown++;
        $('rs-user').textContent = String(u);
        $('rs-house').textContent = String(h);
        testsEl.insertAdjacentHTML('beforeend', testHTML(t, `${u}–${h}`));
        const li = testsEl.lastElementChild;
        if (!instant && !reduceMotion) li.classList.add('is-new');
        if (!instant) play(t.result === 'user' ? 'matchWon' : t.result === 'house' ? 'matchLost' : 'matchLevel');
        $('rs-sub').textContent = shown < 5 ? `After the ${ORDINAL[shown - 1]} ${FORMAT.matchNoun} at ${t.venue}: ${u}–${h}` : '';
        if (!instant && shown < 5) timer = window.setTimeout(() => step(false), 1100);
        else if (!instant) timer = window.setTimeout(finish, 900);
      }
      $('rs-skip').addEventListener('click', finish);
      // Swiping down before the reveal has ended ends it, so the next screen is never blank.
      window.addEventListener('scroll', () => { if (!revealed && window.scrollY > 24) finish(); }, { passive: true });
      if (reduceMotion) finish();
      else timer = window.setTimeout(() => step(false), 600);

      // ---- share ----
      // The link goes to the scoreline's page (/r/3-2, whose link preview
      // shows that result) and carries the XI so the page can list it. The
      // XI itself travels as a picture: the share card, drawn here.
      const slug = `${series.user}-${series.house}`;
      // The six spins this XI was drafted from ride along, so a friend can draft from the same draws.
      let spinsParam = '';
      try {
        const hist = JSON.parse(localStorage.getItem('beatmy11.draft.v1') || 'null')?.spinHistory;
        if (Array.isArray(hist) && hist.length === 6) {
          const spins = hist.map((h) => ({ era: h.era, nation: h.nation }));
          spinsParam = FORMAT.id === 'test' ? encodeSpins(spins) : encodeSpinsWith(spins, { eras: Object.keys(FORMAT.eraNames), teamCodes: FORMAT.teamCodes });
        }
      } catch {
        /* no spins: the link still works as a normal share */
      }
      // Every format has its own share pages: /r/<slug> (Test), /odi/r/<slug> and so on.
      const url = FORMAT.shareLinks
        ? `${location.origin}${FORMAT.id === 'test' ? '' : `/${FORMAT.id}`}/r/${slug}?xi=${encodeXI(userXI.map((p) => ({ id: p.id, role: p.role })))}${spinsParam ? `&c=${spinsParam}` : ''}`
        : `${location.origin}${FORMAT.homeHref}`;
      const XI = FORMAT.xiNoun;
      // One wording for the card, the message and the /r pages (src/lib/share-results.ts).
      const words = { opponent: OPP, xiNoun: XI, matchNoun: FORMAT.matchNoun };
      const shareText = challengeShare || dailyShare || shareTextFor(series.user, series.house, words);
      const cardHeadline = shareResultsFor(words).find((r) => r.slug === slug)?.imageHeadline ?? 'Beat My 11';

      // Drawn straight away so it's ready when the reveal ends; the share
      // sheet must open within the tap's activation window.
      const fileName = `beat-my-11-${slug}.png`;
      drawShareCard({
        user: series.user,
        house: series.house,
        draws: series.draws,
        headline: cardHeadline,
        seriesLabel: FORMAT.eyebrow,
        opponent: OPP,
        challengeLine: FORMAT.id === 'test' ? undefined : `Can your ${XI} do better?`,
        xi: userXI.map((p) => ({ name: p.name, role: ROLE_SHORT[p.role] || '', nation: NATION_CODES[p.nation] || p.nation, best: p.id === bestId })),
        opponentXI: houseXI.map((p) => ({ name: p.name, role: ROLE_SHORT[p.role] || '', nation: NATION_CODES[p.nation] || p.nation })),
        rank: series.topPercent <= 50 ? `Top ${series.topPercent}% of drafts` : '',
      })
        .then(cardBlob)
        .then((blob) => {
          if (!blob) return;
          cardFile = new File([blob], fileName, { type: 'image/png' });
          const href = URL.createObjectURL(blob);
          $('rs-card-img').src = href;
          $('rs-card-img').alt = `Your share card: ${series.user}–${series.house}. My XI: ${userXI.map((x) => x.name).join(', ')}. ${OPP}: ${houseXI.map((x) => x.name).join(', ')}.`;
          $('rs-save').href = href;
          $('rs-save').download = fileName;
          $('rs-card-img').hidden = false;
          $('rs-save').classList.add('is-ready');
        })
        .catch(() => {
          /* no card — sharing falls back to text and link */
        });
      $('rs-share').addEventListener('click', async () => {
        reportEvent('shared', FORMAT.id);
        const message = `${shareText} ${url}`;
        try {
          // Picture + link where the platform can share files (phones).
          if (cardFile && navigator.canShare?.({ files: [cardFile] })) {
            await navigator.share({ files: [cardFile], title: 'Beat My 11', text: message });
            return;
          }
          if (navigator.share) {
            await navigator.share({ title: 'Beat My 11', text: shareText, url });
            return;
          }
          // Desktop: save the card and copy the message.
          await navigator.clipboard.writeText(message);
          if (cardFile) {
            $('rs-save').click();
            $('rs-copied').textContent = 'Card saved and link copied. Post them anywhere.';
          } else {
            $('rs-copied').textContent = 'Copied. Paste it anywhere.';
          }
        } catch (err) {
          if (err && err.name === 'AbortError') return; // share sheet dismissed
          try {
            await navigator.clipboard.writeText(message);
            $('rs-copied').textContent = 'Link copied. Paste it anywhere.';
          } catch {
            /* clipboard blocked too — nothing more to do */
          }
        }
      });
    }

    $('rs-leave')?.addEventListener('click', () => {
      saveChallenge(null, SCOPE);
      $('rs-challenge').hidden = true;
    });

    // "Draft again" starts a fresh draft (a challenge stays on, with the same spins).
    for (const a of document.querySelectorAll('[data-rs-again]')) {
      a.addEventListener('click', () => {
        try {
          localStorage.removeItem('beatmy11.userXI.v1');
          localStorage.removeItem('beatmy11.draft.v1');
        } catch {
          /* storage unavailable — navigation still works */
        }
      });
    }
    run();
  </script>

