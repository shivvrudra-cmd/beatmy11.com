---
/**
 * SharedResult.astro — where a shared series result lands: /r/<user>-<house> for the Test game
 * and /<format>/r/<user>-<house> for ODI, T20I and IPL.
 *
 * The page exists for its link preview: title and image name the scoreline, so "I beat the
 * World XI 3–2" shows as such in WhatsApp, X, iMessage and the rest. A friend who opens it sees
 * the result as a challenge, the sender's XI (from `?xi=`, see encodeXI in share-results.ts) and
 * one button to start their own draft, or to draft from the same six spins (`?c=`).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloodlitShell from './FloodlitShell.astro';
import type { ShareResult } from '../lib/share-results';

export interface Props {
  r: ShareResult;
  /** id → [name, short team code] for every player the page may list. */
  names: Record<string, [string, string]>;
  /** "The five-Test series" */
  eyebrow: string;
  opponent: string;
  /** "/play", "/ipl/play" … */
  playHref: string;
  /** Link-preview image, e.g. "/og/3-2.png". */
  ogImage: string;
}
const { r, names, eyebrow, opponent, playHref, ogImage } = Astro.props;
const namesJson = JSON.stringify(names).replace(/</g, '\\u003c');

const won = r.user > r.house;
const lost = r.user < r.house;
---
<BaseLayout
  title={`${r.title} — Beat My 11`}
  description={r.challenge}
  ogImage={ogImage}
  ogImageAlt={`${r.title}. ${eyebrow} on Beat My 11.`}
>
  <meta name="robots" content="noindex" slot="head" />
  <FloodlitShell>
    <section class="sr" aria-labelledby="sr-title">
      <p class="fs-eyebrow">{eyebrow}</p>
      <h1 class="fs-title" id="sr-title">
        {won ? <span class="fs-hl">{r.imageHeadline}</span> : r.imageHeadline}
      </h1>
      <div class="sr-score" role="img" aria-label={`Their XI ${r.user}, ${opponent} ${r.house}${r.draws ? `, ${r.draws} drawn` : ''}`}>
        <div class:list={['sr-side', { 'is-win': won }]}><span class="sr-num">{r.user}</span><span class="sr-lab">Their XI</span></div>
        <span class="sr-dash" aria-hidden="true">–</span>
        <div class:list={['sr-side', { 'is-loss': lost }]}><span class="sr-num">{r.house}</span><span class="sr-lab">{opponent}</span></div>
      </div>
      <p class="fs-lede">{r.challenge}</p>
      <div class="sr-xi" id="sr-xi" hidden>
        <h2 class="sr-h2">Their XI</h2>
        <ol class="sr-sheet" id="sr-sheet"></ol>
      </div>
      <a class="fs-cta" href={playHref} id="sr-cta" data-slug={r.slug} data-play={playHref}>Draft your XI</a>
      <a class="fs-link" href={playHref} id="sr-own" hidden>Or draft your own, random spins</a>
      <a class="fs-link" href="/">How it works</a>
    </section>
  </FloodlitShell>

  <script id="sr-names" type="application/json" set:html={namesJson} />
  <script>
    import { decodeXI } from '../lib/share-results';

    const ROLE_SHORT = { opener: 'OPN', 'middle-order': 'BAT', wicketkeeper: 'WK', 'all-rounder': 'AR', spinner: 'SPIN', 'fast-bowler': 'PACE' };
    const names = JSON.parse(document.getElementById('sr-names')?.textContent || '{}');
    const picks = decodeXI(new URLSearchParams(location.search).get('xi'), (id) => Object.hasOwn(names, id));
    // A challenge link carries the sender's six spins: offer them as the main action.
    const spins = new URLSearchParams(location.search).get('c');
    if (spins && /^[A-Za-z0-9.\-]{10,200}$/.test(spins)) {
      const cta = document.getElementById('sr-cta');
      cta.textContent = 'Take the challenge: same spins';
      cta.setAttribute('href', `${cta.dataset.play}?c=${encodeURIComponent(spins)}&vs=${cta.dataset.slug}`);
      document.getElementById('sr-own').hidden = false;
    }
    if (picks) {
      const sheet = document.getElementById('sr-sheet');
      picks.forEach((p, i) => {
        const [name, nation] = names[p.id];
        const li = document.createElement('li');
        const cells = [
          ['sr-n', String(i + 1)],
          ['sr-name', name],
          ['sr-nation', nation],
          ['sr-role', ROLE_SHORT[p.role]],
        ];
        for (const [cls, text] of cells) {
          const span = document.createElement('span');
          span.className = cls;
          span.textContent = text;
          li.append(span);
        }
        sheet.append(li);
      });
      document.getElementById('sr-xi').hidden = false;
    }
  </script>

  <style is:global>
    .sr { margin: 10vh auto 0; text-align: center; }
    .sr-score { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 4px 0 16px; }
    .sr-side { display: flex; flex-direction: column; align-items: center; min-width: 96px; }
    .sr-num { font: 400 clamp(88px, 28vw, 150px)/0.88 var(--fs-display); }
    .sr-lab { font: 600 11px Inter, sans-serif; letter-spacing: 0.2em; text-transform: uppercase; color: var(--fs-muted); }
    .sr-side.is-win .sr-num { color: var(--fs-lime); text-shadow: 0 0 40px rgba(198, 255, 61, 0.45); }
    .sr-side.is-loss .sr-num { color: var(--fs-loss); }
    .sr-xi { max-width: 460px; margin: 22px auto 0; text-align: left; }
    .sr-xi[hidden] { display: none; }
    .sr-h2 { margin: 0 0 8px; text-align: center; font: 600 12px Inter, sans-serif; letter-spacing: 0.24em; text-transform: uppercase; color: var(--fs-muted); }
    .sr-sheet {
      list-style: none; margin: 0; padding: 6px 14px; border-radius: 16px;
      background: var(--fs-card); border: 1px solid rgba(198, 255, 61, 0.25);
    }
    .sr-sheet li { display: flex; align-items: baseline; gap: 10px; padding: 7px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.07); }
    .sr-sheet li:last-child { border-bottom: 0; }
    .sr-n { width: 20px; flex: none; font: 400 20px/1 var(--fs-display); color: var(--fs-dim); }
    .sr-name { font: 400 23px/1 var(--fs-display); letter-spacing: 0.04em; }
    .sr-nation { flex: 1; font: 600 10.5px Inter, sans-serif; letter-spacing: 0.1em; color: var(--fs-muted); }
    .sr-role { font: 700 10.5px Inter, sans-serif; letter-spacing: 0.12em; color: var(--fs-lime); }
    .sr-dash { font: 400 60px/1 var(--fs-display); color: var(--fs-dim); margin-top: -20px; }
  </style>
</BaseLayout>
