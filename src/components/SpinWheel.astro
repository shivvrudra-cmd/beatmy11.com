---
// Props will be passed from the page
---
<div class="space-y-6">
  <div class="text-center">
    <h2 class="text-xl font-semibold text-gray-900 mb-2">
      Spin the Wheel
    </h2>
    <p class="text-sm text-gray-500">
      {spinsRemaining} spins remaining
    </p>
  </div>

  {/* Spin Button */}
  <button
    class="w-full px-6 py-4 bg-primary-600 text-white font-medium rounded-lg shadow-md hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
    on:click={handleSpin}
    disabled={spinsRemaining <= 0 || isSpinning}
  >
    {isSpinning ? 'Spinning...' : 'Spin the Wheel'}
  </button>

  {/* Reroll Buttons */}
  <div class="flex gap-3">
    <button
      class="flex-1 px-4 py-3 bg-gray-200 text-gray-800 font-medium rounded-lg hover:bg-gray-300 focus:outline-none focus:ring-2 focus-ring-offset-2 focus-ring-gray-300 transition-colors {!teamRerollAvailable ? '' : 'opacity-50 cursor-not-allowed'}"
      on:click={useTeamReroll}
      disabled={!teamRerollAvailable}
    >
      {teamRerollAvailable ? 'Re-roll Team' : 'Team Re-roll Used'}
    </button>
    <button
      class="flex-1 px-4 py-3 bg-gray-200 text-gray-800 font-medium rounded-lg hover:bg-gray-300 focus:outline-none focus:ring-2 focus-ring-offset-2 focus-ring-gray-300 transition-colors {!eraRerollAvailable ? '' : 'opacity-50 cursor-not-allowed'}"
      on:click={useEraReroll}
      disabled={!eraRerollAvailable}
    >
      {eraRerollAvailable ? 'Re-roll Era' : 'Era Re-roll Used'}
    </button>
  </div>

  {/* Current Spin Result */}
  {currentSpin && (
    <div class="bg-white rounded-xl shadow-sm p-6 space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <div class="text-3xl">{currentSpin.eraEmoji}</div>
          <div>
            <p class="font-medium text-gray-900">{currentSpin.era}</p>
            <p class="text-sm text-gray-500">{currentSpin.nationFlag} {currentSpin.nation}</p>
          </div>
        </div>
        <button
          class="text-gray-400 hover:text-gray-500"
          on:click={showPlayerDetails}
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      {/* Player Selection */}
      <div class="space-y-3">
        <h3 class="text-lg font-semibold text-gray-900">
          Choose 2 Players
        </p>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {#if currentSpin.availablePlayers.length > 0}
            {#each currentSpin.availablePlayers as player}
              <PlayerCard
                player={player}
                selected={selectedPlayers.has(player.id)}
                on:select={togglePlayerSelection}
                disabled={isSelectionLocked(player)}
              />
            {/each}
          {:else}
            <p class="text-center text-gray-500 py-8">
              No players available for this combination
            </p>
          {/if}
        </div>

        {/* Selection Counter */}
        <div class="flex justify-between text-sm text-gray-600">
          <span>Selected: {selectedPlayers.size}/2</span>
          <span class="{selectedPlayers.size === 2 ? 'text-green-600' : 'text-red-500'}">
            {selectedPlayers.size === 2 ? 'Ready!' : 'Pick 2 players'}
          </span>
        </div>
      </div>

      {/* Action Buttons */}
      <div class="flex gap-3 pt-4">
        <button
          class="flex-1 px-4 py-3 bg-gray-200 text-gray-800 font-medium rounded-lg hover:bg-gray-300 focus:outline-none focus:ring-2 focus-ring-offset-2 focus-ring-gray-300 transition-colors"
          on:click={resetSelection}
          disabled={selectedPlayers.size === 0}
        >
          Clear Selection
        </button>
        <button
          class="flex-1 px-4 py-3 bg-primary-600 text-white font-medium rounded-lg hover:bg-primary-700 focus:outline-none focus:ring-2 focus-ring-offset-2 focus-ring-primary-500 transition-colors"
          on:click={confirmSelection}
          disabled={selectedPlayers.size !== 2}
        >
          Confirm Picks
        </button>
      </div>
    </div>
  )}
</div>

<style>
  .PlayerCard {
    @apply border rounded-lg p-4 cursor-pointer transition-all hover:shadow-md border-gray-200 hover:border-primary-300;
  }

  .PlayerCard-selected {
    @apply border-primary-300 bg-primary-50;
  }

  .PlayerCard-disabled {
    @apply opacity-50 cursor-not-allowed;
  }

  .PlayerCard-image {
    @apply w-16 h-16 rounded-full mx-auto mb-3 object-cover border border-gray-200;
  }

  .PlayerCard-name {
    @apply text-center font-medium text-gray-900;
  }

  .PlayerCard-role {
    @apply text-center text-sm text-gray-500;
  }

  .PlayerCard-stats {
    @apply text-center text-xs text-gray-400 mt-2;
  }
</style>