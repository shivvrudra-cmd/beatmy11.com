---
/**
 * CricketIcons — original, stroke-based cricket icon set.
 * 24x24 viewBox, stroke="currentColor", no fill. Use:
 *   <CricketIcon name="ball" class="w-6 h-6 text-primary-500" />
 */
export type CricketIconName =
  | 'ball'
  | 'bat'
  | 'stumps'
  | 'trophy'
  | 'helmet'
  | 'pitch'
  | 'captain'
  | 'star'
  | 'wicket';

export interface Props {
  name: CricketIconName;
  class?: string;
}

const { name, class: className } = Astro.props;

const ICONS: Record<CricketIconName, string> = {
  // Cricket ball with dashed seam curves
  ball: `<circle cx="12" cy="12" r="8"/>
    <path d="M8.4 5.6c2.1 2.3 2.1 10.5 0 12.8" stroke-dasharray="2.6 2.1"/>
    <path d="M15.6 5.6c-2.1 2.3-2.1 10.5 0 12.8" stroke-dasharray="2.6 2.1"/>`,

  // Cricket bat, upright
  bat: `<rect x="9" y="9.5" width="6" height="10.5" rx="2"/>
    <path d="M12 9.5V3.5"/>
    <path d="M10.2 5.6h3.6"/>
    <path d="M9.8 15.5h4.4"/>`,

  // Three stumps with bails
  stumps: `<path d="M7 21v-10M12 21V11M17 21v-10"/>
    <path d="M7.2 8.6h3.9M12.9 8.6h3.9"/>`,

  // Trophy cup
  trophy: `<path d="M7 4h10v4.5a5 5 0 0 1-10 0z"/>
    <path d="M7 5.5H4.2a2.9 2.9 0 0 0 3 4.6M17 5.5h2.8a2.9 2.9 0 0 1-3 4.6"/>
    <path d="M12 13.5v2.5M9 20.5h6M10.2 16h3.6"/>`,

  // Batting helmet with grill
  helmet: `<path d="M4.5 13.5a7.5 7.5 0 0 1 15 0v1.5h-15z"/>
    <path d="M4.5 15h15"/>
    <path d="M8.5 15v4.5M12 15v5M15.5 15v4.5"/>
    <path d="M4.5 13.5 2.5 12"/>`,

  // Pitch with crease lines, viewed end-on
  pitch: `<rect x="8" y="2.5" width="8" height="19" rx="1"/>
    <path d="M8 7.5h8M8 16.5h8"/>
    <path d="M12 2.5v3M12 18.5v3"/>`,

  // Captain badge: shield with "C"
  captain: `<path d="M12 2.8l7.2 2.7v5.1c0 4.6-3.1 7.8-7.2 9.6-4.1-1.8-7.2-5-7.2-9.6V5.5z"/>
    <path d="M14.8 9.2a3.6 3.6 0 1 0 0 5.6"/>`,

  // Star badge
  star: `<path d="M12 3.6l2.5 5.2 5.7.8-4.2 4 1 5.7-5-2.7-5 2.7 1-5.7-4.2-4 5.7-.8z"/>`,

  // Wicket taken: middle stump flying, speed lines, ball
  wicket: `<path d="M6.5 21v-8.5M17.5 21v-8.5"/>
    <path d="M11 9.5l3.5-5"/>
    <path d="M3.5 5.5l2 .8M20.5 5.5l-2 .8"/>
    <circle cx="18.5" cy="15.5" r="1.6"/>`,
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  set:html={ICONS[name]}
/>
