---
import '../styles/globals.css';

const { title, description, ogImage, ogImageAlt, siteUrl } = Astro.props;

// Link previews need absolute URLs; crawlers don't resolve relative ones.
const site = Astro.site ?? Astro.url;
const pageUrl = siteUrl ?? new URL(Astro.url.pathname, site).href;
const imageUrl = new URL(ogImage ?? '/og-image.png', site).href;
const imageAlt = ogImageAlt ?? 'Beat My 11 — can your all-time Test XI beat the World XI?';
---
<!DOCTYPE html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#04060c" />

    <!-- Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Social Cards -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Beat My 11" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: 'Beat My 11',
        description,
        url: pageUrl,
      }).replace(/</g, '\\u003c')}
    />
  </head>
  <body class="tap-highlight-color">
    <slot />
    <script>
      // Anonymous page-view counter (src/lib/telemetry.ts): daily totals only.
      import { reportEvent } from '../lib/telemetry';
      const path = location.pathname.replace(/\/+$/, '') || '/';
      if (path === '/') reportEvent('view_home');
      else if (path === '/play') reportEvent('view_play');
      else if (path === '/matchup') reportEvent('view_result');
      else if (path.startsWith('/r/')) reportEvent('view_shared');
    </script>
  </body>
</html>