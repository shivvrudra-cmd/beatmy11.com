---
import BaseLayout from '../layouts/BaseLayout.astro';
import FloodlitShell from '../components/FloodlitShell.astro';

const title = '404 — That one went wide | Beat My 11';
const description =
  'That page was bowled out. Head back home or start drafting your all-time Test XI on Beat My 11.';
---

<BaseLayout title={title} description={description}>
  <meta name="robots" content="noindex, nofollow" slot="head" />
  <FloodlitShell>
    <section class="nf" aria-labelledby="nf-title">
      <p class="nf-code" aria-hidden="true">404</p>
      <p class="fs-eyebrow">Page not found</p>
      <h1 class="fs-title" id="nf-title">That one went <span class="fs-hl">wide.</span></h1>
      <p class="fs-lede">
        The page you were after was bowled out, caught behind, or never made
        it to the crease. The next over starts whenever you’re ready.
      </p>
      <a class="fs-cta" href="/play">Start drafting</a>
      <a class="fs-link" href="/">Back home</a>
    </section>
  </FloodlitShell>

  <style is:global>
    .nf { margin: 9vh auto 0; text-align: center; }
    .nf-code {
      margin: 0 0 6px; font: 400 clamp(110px, 34vw, 190px)/0.85 var(--fs-display); letter-spacing: 0.04em;
      color: transparent; -webkit-text-stroke: 2px var(--fs-lime);
      filter: drop-shadow(0 0 22px rgba(198, 255, 61, 0.35));
    }
  </style>
</BaseLayout>
