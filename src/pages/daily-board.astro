---
/**
 * /daily-board — today's Daily Challenge leaderboard, one tab per format
 * (docs/plans/daily-leaderboard.md). PROPOSAL: on an unmerged pull request. Reads
 * GET /api/daily/<format>/<day>; when that is unavailable (the table does not exist until the
 * owner applies migration 0002) the page says so plainly. Names come from players and are put on
 * the page as text only, never as markup. noindex and out of the sitemap.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloodlitShell from '../components/FloodlitShell.astro';
import SiteLinks from '../components/SiteLinks.astro';

const FORMATS = [
  { id: 'test', label: 'Test', opponent: 'World XI', play: '/play?daily=1' },
  { id: 'odi', label: 'ODI', opponent: 'World XI', play: '/odi/play?daily=1' },
  { id: 't20i', label: 'T20I', opponent: 'World XI', play: '/t20i/play?daily=1' },
  { id: 'ipl', label: 'IPL', opponent: 'All-Star XI', play: '/ipl/play?daily=1' },
];
---

<BaseLayout title="Today’s Daily Challenge board | Beat My 11" description="Today’s best overall scores in the Beat My 11 Daily Challenge, for Test, ODI, T20I and IPL. A friendly board: no sign-up.">
  <meta name="robots" content="noindex" slot="head" />
  <FloodlitShell>
    <section class="db" aria-labelledby="db-title">
      <p class="fs-eyebrow" id="db-day">Daily Challenge</p>
      <h1 class="fs-title" id="db-title">Today’s <span class="fs-hl">board</span></h1>
      <div class="db-tabs" role="tablist" aria-label="Format">
        {FORMATS.map((f, i) => (
          <button type="button" role="tab" class:list={['db-tab', { 'is-on': i === 0 }]} aria-selected={i === 0} data-db-format={f.id} data-db-opponent={f.opponent} data-db-play={f.play}>{f.label}</button>
        ))}
      </div>
      <p class="db-line" id="db-line" aria-live="polite">Loading…</p>
      <ol class="db-list" id="db-list"></ol>
      <a class="fs-cta" id="db-play" href="/play?daily=1">Play today’s challenge</a>
      <p class="db-note">
        A friendly board. One entry per browser a day, added only if the player chooses. Scores are worked
        out on each player’s device, so they cannot be checked. Names are typed by players.
      </p>
    </section>
    <SiteLinks />
  </FloodlitShell>

  <script>
    import { fetchBoard, boardLine } from '../lib/leaderboard';
    import { utcDayKey, dayNumber } from '../lib/daily';

    const day = utcDayKey();
    const $ = (id) => document.getElementById(id);
    $('db-day').textContent = `Daily Challenge #${dayNumber(day)}`;
    async function show(tab) {
      for (const t of document.querySelectorAll('.db-tab')) {
        const on = t === tab;
        t.classList.toggle('is-on', on);
        t.setAttribute('aria-selected', String(on));
      }
      $('db-play').setAttribute('href', tab.dataset.dbPlay);
      $('db-list').replaceChildren();
      $('db-line').textContent = 'Loading…';
      const board = await fetchBoard(tab.dataset.dbFormat, day);
      if (!tab.classList.contains('is-on')) return; // another tab was opened meanwhile
      if (!board) { $('db-line').textContent = 'The board is not available right now.'; return; }
      $('db-line').textContent = boardLine(board, tab.dataset.dbOpponent);
      for (const e of board.entries) {
        const li = document.createElement('li');
        const cells = [['db-rank', String(e.rank)], ['db-name', e.name || 'Anonymous'], ['db-series', `${e.user}–${e.house}`], ['db-score', e.score.toFixed(1)]];
        for (const [cls, text] of cells) {
          const span = document.createElement('span');
          span.className = cls;
          span.textContent = text; // names are text, never markup
          li.append(span);
        }
        if (!e.name) li.classList.add('is-anon');
        $('db-list').append(li);
      }
    }
    for (const t of document.querySelectorAll('.db-tab')) t.addEventListener('click', () => show(t));
    const wanted = new URLSearchParams(location.search).get('f');
    show(document.querySelector(`.db-tab[data-db-format="${CSS.escape(wanted || 'test')}"]`) || document.querySelector('.db-tab'));
  </script>

  <style is:global>
    .db { margin: 6vh auto 0; text-align: center; }
    .db-tabs { display: flex; justify-content: center; gap: 6px; margin: 14px 0 10px; }
    .db-tab { min-height: 36px; padding: 6px 14px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.18); background: transparent; color: var(--fs-muted); font: 700 12.5px Inter, sans-serif; cursor: pointer; }
    .db-tab.is-on { background: var(--fs-lime); border-color: var(--fs-lime); color: #04060c; }
    .db-line { margin: 0 0 12px; min-height: 22px; color: var(--fs-lime); font: 600 14px Inter, sans-serif; }
    .db-list { list-style: none; max-width: 460px; margin: 0 auto 20px; padding: 4px 14px; border-radius: 16px; background: var(--fs-card); border: 1px solid rgba(198, 255, 61, 0.25); text-align: left; }
    .db-list:empty { display: none; }
    .db-list li { display: flex; align-items: baseline; gap: 10px; padding: 8px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.07); }
    .db-list li:last-child { border-bottom: 0; }
    .db-rank { width: 26px; flex: none; font: 400 20px/1 var(--fs-display); color: var(--fs-dim); }
    .db-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font: 600 15px Inter, sans-serif; }
    .is-anon .db-name { color: var(--fs-dim); font-weight: 500; }
    .db-series { font: 600 12px Inter, sans-serif; color: var(--fs-muted); }
    .db-score { width: 48px; text-align: right; font: 400 22px/1 var(--fs-display); color: var(--fs-lime); }
    .db-note { max-width: 460px; margin: 18px auto 0; color: var(--fs-dim); font-size: 12.5px; line-height: 1.5; }
  </style>
</BaseLayout>
