---
/**
 * index.astro — landing page, "Floodlit night" design (rebuilt 2026-09-29).
 *
 * One job: ask the question and get the player drafting. The house XI is
 * shown as the opponent to beat; the only primary action is the draft.
 * If a draft is already in progress (localStorage), the button offers to
 * continue it instead.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteLinks from '@/components/SiteLinks.astro';
import { getHouseXI } from '@/lib/opponent-xi';

const title = 'Beat My 11 — Can Your All-Time Test XI Beat the World XI?';
// Owner-approved 2026-10-02: the description names all the games; the title stays on the Test game.
const description =
  'Spin for an era and a nation, draft an all-time XI and play a five-match series against the World XI. Test, ODI, T20I and IPL, or pick any eleven and challenge a friend.';

const ROLE_SHORT: Record<string, string> = {
  opener: 'OPN',
  'middle-order': 'BAT',
  wicketkeeper: 'WK',
  'all-rounder': 'AR',
  spinner: 'SPIN',
  'fast-bowler': 'PACE',
};
const house = getHouseXI().map((p) => ({ name: p.name, role: ROLE_SHORT[p.primaryRole] ?? '' }));

const steps = [
  { n: '1', title: 'Spin', body: 'Fate draws an era and a nation. Your first spin is always a Legend.' },
  { n: '2', title: 'Draft', body: 'Six spins, eleven picks. No ratings — just the numbers and your judgment.' },
  { n: '3', title: 'Play the series', body: 'Five Tests against the World XI. Win the series and you beat it. 5–0 is legendary.' },
];
---
<BaseLayout title={title} description={description}>
  <div class="hm">
    <div class="hm-lights" aria-hidden="true"></div>
    <header class="hm-top">
      <span class="hm-brand">BEAT MY 11</span>
    </header>

    <main id="main">
      <section class="hm-hero" aria-labelledby="hm-title">
        <p class="hm-eyebrow">The all-time Test draft</p>
        <h1 class="hm-title" id="hm-title">Can your <span class="hm-nw">all&#8209;time&nbsp;XI</span> <span class="hm-hl">beat the <span class="hm-nw">World XI?</span></span></h1>
        <p class="hm-lede">
          Spin for an era and a nation. Draft eleven. Then play five Tests against the World XI —
          Lord’s, the MCG, Eden Gardens, Newlands and Kensington Oval.
        </p>
        <a class="hm-cta" href="/play" id="hm-cta">Start drafting</a>
        <p class="hm-resume"><a href="/play" id="hm-challenge" hidden></a></p>
        <p class="hm-resume" id="hm-resume" hidden>
          <a href="/play" id="hm-fresh">or start a new draft</a>
        </p>
      </section>

      <section class="hm-daily" aria-labelledby="hm-daily-title">
        <p class="hm-daily-eyebrow" id="hm-daily-num">Daily Challenge</p>
        <h2 class="hm-daily-title" id="hm-daily-title">Same spins for everyone, every day</h2>
        <p class="hm-daily-streak" id="hm-daily-streak" hidden></p>
        <a class="hm-daily-cta" href="/play?daily=1" id="hm-daily-cta">Play today’s challenge</a>
        <p class="hm-daily-note" id="hm-daily-note">One scored attempt a day. New spins at 00:00 UTC. Keep your streak alive.</p>
      </section>
      <!-- Directly under the Daily Challenge card (owner, 2026-10-02). -->
      <p class="hm-dailies hm-dailies--under" id="hm-other-dailies">Today’s other dailies:
        <a href="/odi/play?daily=1" data-hm-daily="odi">ODI</a>
        <a href="/t20i/play?daily=1" data-hm-daily="t20i">T20I</a>
        <a href="/ipl/play?daily=1" data-hm-daily="ipl">IPL</a>
      </p>

      <section class="hm-more" aria-labelledby="hm-more-title">
        <h2 class="hm-h2" id="hm-more-title">More ways to play</h2>
        <p class="hm-note">New: three more formats, and a mode with no spins at all.</p>
        <ul class="hm-games">
          <li><a class="hm-game" href="/odi/play"><span class="hm-game-tag">New</span><b>ODI XI</b><i>Spin a nation and a decade. Five ODIs against the World XI.</i></a></li>
          <li><a class="hm-game" href="/t20i/play"><span class="hm-game-tag">New</span><b>T20I XI</b><i>Strike rates and economy rule. Five T20Is against the World XI.</i></a></li>
          <li><a class="hm-game" href="/ipl/play"><span class="hm-game-tag">New</span><b>IPL XI</b><i>Spin a franchise and its seasons. Four overseas players at most.</i></a></li>
          <li><a class="hm-game is-pick" href="/pick"><span class="hm-game-tag">New</span><b>Pick any XI</b><i>No spins. Choose any eleven and dare a friend to beat it.</i></a></li>
        </ul>
        <p class="hm-dailies">How each game works:
          <a class="is-plain" href="/odi/">ODI</a>
          <a class="is-plain" href="/t20i/">T20I</a>
          <a class="is-plain" href="/ipl/">IPL</a>
        </p>
      </section>

      <section class="hm-house" aria-labelledby="hm-house-title">
        <h2 class="hm-h2" id="hm-house-title">The World XI</h2>
        <p class="hm-note">The XI you have to beat.</p>
        <ol class="hm-sheet">
          {house.map((p, i) => (
            <li>
              <span class="hm-n">{i + 1}</span>
              <span class="hm-name">{p.name}</span>
              <span class="hm-role">{p.role}</span>
            </li>
          ))}
        </ol>
      </section>

      <section class="hm-how" aria-labelledby="hm-how-title">
        <h2 class="sr-only" id="hm-how-title">How it works</h2>
        <ol class="hm-steps">
          {steps.map((s) => (
            <li>
              <span class="hm-step-n" aria-hidden="true">{s.n}</span>
              <h3 class="hm-step-t">{s.title}</h3>
              <p class="hm-step-b">{s.body}</p>
            </li>
          ))}
        </ol>
        <a class="hm-cta hm-cta--low" href="/play">Start drafting</a>
      </section>
    </main>
    <SiteLinks />
  </div>

  <script>
    // Daily Challenge card: today's number, your streak, and whether you've played.
    import { utcDayKey, dayNumber, loadDaily, hasPlayed, currentStreak, activeDailyDay, msUntilReset, formatCountdown } from '../lib/daily';
    // The other formats' dailies: mark the ones already played today (each has its own result and streak).
    for (const a of document.querySelectorAll('[data-hm-daily]')) {
      const st = loadDaily(a.getAttribute('data-hm-daily'));
      const today = utcDayKey();
      if (hasPlayed(st, today)) {
        const r = st.results[today];
        a.classList.add('is-done');
        a.textContent = `${a.textContent} ✓ ${r.user}–${r.house}`;
        a.removeAttribute('href');
      }
    }
    (function dailyCard() {
      const day = utcDayKey();
      const st = loadDaily();
      const $ = (id) => document.getElementById(id);
      $('hm-daily-num').textContent = `Daily Challenge #${dayNumber(day)}`;
      const streak = currentStreak(st, day);
      const streakEl = $('hm-daily-streak');
      const cta = $('hm-daily-cta');
      const note = $('hm-daily-note');
      if (hasPlayed(st, day)) {
        const r = st.results[day];
        $('hm-daily-title').textContent = `Done today: ${r.user}–${r.house} vs the World XI`;
        cta.hidden = true;
        const tick = () => { note.textContent = `Next challenge in ${formatCountdown(msUntilReset())}. Come back to keep your streak.`; };
        tick();
        window.setInterval(tick, 30000);
      } else if (activeDailyDay() === day) {
        cta.textContent = 'Continue today’s challenge';
        cta.setAttribute('href', '/play?daily=1');
      }
      if (streak > 0) {
        streakEl.textContent = `🔥 ${streak}-day streak` + (hasPlayed(st, day) ? '' : ' — play today to keep it going');
        streakEl.hidden = false;
      }
    })();
  </script>

  <script>
    // A draft in progress turns the main button into "Continue your draft",
    // with a small link to start fresh instead.
    // Only the NORMAL game's draft counts here: a daily or a friend's challenge keeps its own.
    import { pickCountFor, clearDraftFor, switchMode } from '../lib/draft-slots';
    import { loadChallenge } from '../lib/challenge';
    try {
      const picks = pickCountFor('normal');
      const ch = loadChallenge();
      const chLink = document.getElementById('hm-challenge');
      if (ch && chLink) {
        chLink.textContent = `Your friend’s challenge (beat ${ch.vs.user}–${ch.vs.house}) is waiting — continue`;
        chLink.setAttribute('href', `/play?c=${encodeURIComponent(ch.spins)}&vs=${ch.vs.user}-${ch.vs.house}`);
        chLink.hidden = false;
      }
      if (picks > 0) {
        const cta = document.getElementById('hm-cta');
        const complete = picks >= 11;
        if (cta) {
          cta.textContent = complete ? 'See your series' : `Continue your draft (${picks}/11)`;
          cta.setAttribute('href', complete ? '/matchup' : '/play');
          cta.addEventListener('click', () => switchMode('normal')); // /matchup reads the live draft
        }
        const resume = document.getElementById('hm-resume');
        if (resume) resume.hidden = false;
        document.getElementById('hm-fresh')?.addEventListener('click', () => {
          try {
            clearDraftFor('normal'); // leaves a daily or challenge draft alone
          } catch {
            /* storage unavailable — navigation still works */
          }
        });
      }
    } catch {
      /* storage unavailable — default button stays */
    }
  </script>

  <style is:global>
    /* ============ / — Floodlit night (mobile-first) ============ */
    .hm {
      --hm-text: #eaf0ff;
      --hm-muted: #9aa6c4;
      --hm-dim: #6b7694;
      --hm-lime: #c6ff3d;
      --hm-display: 'Bebas Neue', 'Oswald', 'Arial Narrow', sans-serif;
      position: relative; min-height: 100vh; padding: 12px 16px 48px; overflow-x: clip;
      background: #04060c; color: var(--hm-text); font-family: Inter, system-ui, sans-serif;
    }
    body:has(.hm) { background: #04060c; }
    .hm-lights {
      position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background:
        radial-gradient(60vw 50vh at 6% -12%, rgba(180, 220, 255, 0.22), transparent 60%),
        radial-gradient(60vw 50vh at 94% -12%, rgba(180, 220, 255, 0.22), transparent 60%),
        radial-gradient(90vw 45vh at 50% 115%, rgba(40, 160, 90, 0.26), transparent 70%);
    }
    .hm > *:not(.hm-lights) { position: relative; z-index: 1; }
    .hm :focus-visible { outline: 3px solid var(--hm-lime); outline-offset: 3px; }
    .hm-top { max-width: 900px; margin: 0 auto; }
    .hm-brand { font: 400 26px/1 var(--hm-display); letter-spacing: 0.08em; }

    .hm-hero { max-width: 640px; margin: 8vh auto 0; text-align: center; }
    .hm-eyebrow { margin: 0; font: 600 11px Inter, sans-serif; letter-spacing: 0.3em; text-transform: uppercase; color: var(--hm-muted); }
    .hm-title { margin: 10px 0 12px; font: 400 clamp(48px, 15vw, 96px)/0.92 var(--hm-display); letter-spacing: 0.02em; }
    .hm-nw { white-space: nowrap; }
    .hm-hl { display: block; color: var(--hm-lime); text-shadow: 0 0 34px rgba(198, 255, 61, 0.45); }
    .hm-lede { margin: 0 auto; max-width: 30rem; color: var(--hm-muted); font-size: 16px; line-height: 1.55; }
    .hm-cta {
      display: block; width: min(100%, 360px); margin: 26px auto 0; min-height: 60px; border-radius: 999px;
      background: var(--hm-lime); color: #04060c; text-decoration: none; text-align: center;
      font: 400 28px/60px var(--hm-display); letter-spacing: 0.12em;
      box-shadow: 0 0 0 6px rgba(198, 255, 61, 0.15), 0 0 44px rgba(198, 255, 61, 0.5);
      transition: transform 0.12s, box-shadow 0.2s;
    }
    .hm-cta:hover { transform: scale(1.03); box-shadow: 0 0 0 10px rgba(198, 255, 61, 0.18), 0 0 64px rgba(198, 255, 61, 0.7); }
    .hm-cta:active { transform: scale(0.98); }
    .hm-resume { margin: 12px 0 0; }
    .hm-resume:has(> a[hidden]) { display: none; }
    .hm-resume a { color: var(--hm-muted); font-size: 14px; }

    .hm-house { max-width: 520px; margin: 11vh auto 0; }
    .hm-h2 { margin: 0; text-align: center; font: 400 44px/1 var(--hm-display); letter-spacing: 0.06em; }
    .hm-note { margin: 4px 0 14px; text-align: center; color: var(--hm-muted); font-size: 14px; }
    .hm-sheet {
      list-style: none; margin: 0; padding: 8px 14px; border-radius: 16px;
      background: linear-gradient(160deg, #16223a, #0b1020 70%); border: 1px solid rgba(198, 255, 61, 0.25);
    }
    .hm-sheet li { display: flex; align-items: baseline; gap: 12px; padding: 8px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.07); }
    .hm-sheet li:last-child { border-bottom: 0; }
    .hm-n { width: 20px; flex: none; font: 400 20px/1 var(--hm-display); color: var(--hm-dim); }
    .hm-name { flex: 1; font: 400 24px/1 var(--hm-display); letter-spacing: 0.04em; }
    .hm-role { font: 700 10.5px Inter, sans-serif; letter-spacing: 0.12em; color: var(--hm-lime); }

    .hm-how { max-width: 900px; margin: 10vh auto 0; }
    .hm-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
    .hm-steps li { padding: 16px; border-radius: 14px; background: rgba(255, 255, 255, 0.04); border: 1px solid rgba(255, 255, 255, 0.08); }
    .hm-step-n { font: 400 34px/1 var(--hm-display); color: var(--hm-lime); }
    .hm-step-t { margin: 4px 0 4px; font: 400 26px/1 var(--hm-display); letter-spacing: 0.05em; }
    .hm-step-b { margin: 0; color: var(--hm-muted); font-size: 14.5px; line-height: 1.5; }
    .hm-cta--low { margin-top: 22px; }
    .hm-daily { max-width: 640px; margin: 36px auto 0; padding: 22px 20px; text-align: center; border: 1px solid rgba(198, 255, 61, 0.35); border-radius: 18px; background: rgba(198, 255, 61, 0.07); }
    .hm-more { max-width: 900px; margin: 44px auto 0; text-align: center; }
    .hm-games { list-style: none; margin: 16px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; text-align: left; }
    @media (min-width: 820px) { .hm-games { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
    .hm-game {
      position: relative; display: flex; flex-direction: column; gap: 6px; height: 100%; box-sizing: border-box; padding: 16px 14px; border-radius: 16px; text-decoration: none; color: inherit;
      border: 1px solid rgba(255, 255, 255, 0.14); background: linear-gradient(160deg, #18213a 0%, #0b1020 62%); transition: transform 0.15s, border-color 0.15s;
    }
    .hm-game:hover { transform: translateY(-3px); border-color: rgba(198, 255, 61, 0.6); }
    .hm-game.is-pick { border-color: rgba(198, 255, 61, 0.45); }
    .hm-game b { font: 400 28px/1 var(--hm-display); letter-spacing: 0.04em; }
    .hm-game i { font: 400 13px/1.4 Inter, sans-serif; font-style: normal; color: var(--hm-muted); }
    .hm-game-tag { align-self: flex-start; padding: 2px 7px; border-radius: 5px; background: var(--hm-lime); color: #04060c; font: 700 9.5px Inter, sans-serif; letter-spacing: 0.12em; text-transform: uppercase; }
    .hm-dailies--under { max-width: 640px; margin: 14px auto 0 !important; text-align: center; }
    .hm-dailies { margin: 16px 0 0; font: 600 13px/1.6 Inter, sans-serif; color: var(--hm-muted); }
    .hm-dailies a { display: inline-block; margin-left: 6px; padding: 5px 12px; border-radius: 999px; border: 1px solid rgba(198, 255, 61, 0.45); color: var(--hm-lime); text-decoration: none; }
    .hm-dailies a.is-plain { border-color: rgba(255, 255, 255, 0.18); color: var(--hm-text, #eaf0ff); }
    .hm-dailies a.is-done { border-color: rgba(255, 255, 255, 0.18); color: var(--hm-muted); }
    .hm-daily-eyebrow { margin: 0; font: 600 12px/1 Inter, sans-serif; letter-spacing: 0.14em; text-transform: uppercase; color: var(--hm-lime); }
    .hm-daily-title { margin: 10px 0 0; font: 400 clamp(26px, 6vw, 34px)/1.05 var(--hm-display); letter-spacing: 0.03em; }
    .hm-daily-streak { margin: 10px 0 0; font: 600 15px/1.4 Inter, sans-serif; }
    .hm-daily-streak[hidden], .hm-daily-cta[hidden] { display: none; }
    .hm-daily-cta { display: inline-block; margin-top: 16px; padding: 12px 24px; border-radius: 999px; background: var(--hm-lime); color: #04060c; font: 700 16px Inter, sans-serif; text-decoration: none; }
    .hm-daily-note { margin: 12px 0 0; font: 400 13px/1.5 Inter, sans-serif; color: var(--hm-muted); }
    @media (min-width: 760px) {
      .hm-steps { grid-template-columns: repeat(3, 1fr); }
    }
    @media (prefers-reduced-motion: reduce) {
      .hm-cta { transition: none; }
    }
  </style>
</BaseLayout>
