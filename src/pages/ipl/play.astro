---
/**
 * /ipl/play — the IPL draft (public since 2026-10-02, linked from the home page; see docs/plans/white-ball-formats.md). Same screen and draft rules as
 * /play; the spin draws a franchise and a block of seasons.
 */
import DraftGame from '@/components/DraftGame.astro';
import { iplPlayersByBlock, iplSpinCombos } from '@/lib/formats/ipl-store';
import { IPL_FORMAT } from '@/lib/formats/draft-format';

const combos = iplSpinCombos();
---
<DraftGame
  format={IPL_FORMAT}
  title="Beat My 11 — IPL Draft"
  description="Spin for an IPL team and a block of seasons, draft eleven, then play five matches against the All-Star XI."
  playersByEra={iplPlayersByBlock()}
  round1Combos={combos}
  draftCombos={combos}
/>
