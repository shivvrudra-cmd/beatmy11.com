---
/**
 * matchup.astro — the five-Test series result, "Floodlit night" design
 * (rebuilt 2026-09-29).
 *
 * The client script reads the user's XI from localStorage
 * ('beatmy11.userXI.v1', slot order) and each pick's declared role from the
 * draft blob ('beatmy11.draft.v1'), scores it with the seven-metric engine,
 * then plays the series with src/lib/series.ts: the XI's rank among drafted
 * XIs (src/data/series-calibration.json) plus a seeded wobble picks the
 * scoreline, and each Test gets a venue and a headline from the side that
 * won it. The same XI always gets the same series.
 *
 * Owner decisions: the two team scores are NOT shown (the result comes from
 * the XI's rank, so raw scores side by side would read as contradictory);
 * instead the page shows the scoreline, the Test-by-Test story, the XI's
 * rank among drafts, and — revealed here for the first time — every
 * player's rating.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getHouseXI } from '../lib/opponent-xi';
import { buildScoringContext } from '../lib/seven-metrics';
import { playersForEra, ERA_IDS } from '../lib/player-store';
import type { NormalizedPlayer } from '../lib/player-logic';
import calibration from '../data/series-calibration.json';

const houseXI = getHouseXI();

// Scoring context over every unique player — the population the engine
// ranks against — embedded so the client needs no data files.
const scoringPlayers: NormalizedPlayer[] = [];
{
  const seen = new Set<string>();
  for (const eraId of ERA_IDS) {
    for (const p of playersForEra(eraId)) {
      if (seen.has(p.id)) continue;
      seen.add(p.id);
      scoringPlayers.push(p);
    }
  }
}
const safe = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
const scoringContextJson = safe(buildScoringContext(scoringPlayers));
const houseJson = safe(houseXI);
const calibrationJson = safe(calibration);
---
<BaseLayout
  title="The Series — Beat My 11"
  description="Your all-time Test XI against the World XI over five Tests at Lord's, the MCG, Eden Gardens, Newlands and Kensington Oval."
>
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Bebas+Neue&display=swap" rel="stylesheet" />
  <div class="rs">
    <div class="rs-lights" aria-hidden="true"></div>
    <header class="rs-top">
      <a class="rs-brand" href="/" aria-label="Beat My 11 home">BEAT MY 11</a>
      <a class="rs-again-top" href="/play" data-rs-again>Draft again</a>
    </header>

    <main id="main">
      <section class="rs-verdict" aria-labelledby="rs-title">
        <p class="rs-eyebrow">The five-Test series</p>
        <h1 class="rs-title" id="rs-title">Five Tests. One series.</h1>
        <div class="rs-score" aria-hidden="true">
          <div class="rs-side"><span class="rs-num" id="rs-user">0</span><span class="rs-lab">Your XI</span></div>
          <span class="rs-dash">–</span>
          <div class="rs-side"><span class="rs-num" id="rs-house">0</span><span class="rs-lab">World XI</span></div>
        </div>
        <p class="rs-sub" id="rs-sub" aria-live="polite"></p>
        <p class="rs-rank" id="rs-rank" hidden></p>
        <button type="button" class="rs-skip" id="rs-skip">Skip to result</button>
      </section>

      <ol class="rs-tests" id="rs-tests" aria-label="The five Tests"></ol>

      <figure class="rs-card" id="rs-card" hidden>
        <img id="rs-card-img" width="1080" height="1350" alt="Your share card: the series scoreline and your XI" />
      </figure>

      <div class="rs-actions" id="rs-actions" hidden>
        <button type="button" class="rs-share" id="rs-share">Share result</button>
        <a class="rs-again" href="/play" data-rs-again>Draft again</a>
        <a class="rs-save" id="rs-save" hidden>Save the card</a>
        <p class="rs-copied" id="rs-copied" role="status"></p>
      </div>

      <section class="rs-xis" id="rs-xis" hidden aria-labelledby="rs-xis-title">
        <h2 class="rs-h2" id="rs-xis-title">The ratings, revealed</h2>
        <p class="rs-note">Each player’s rating out of 100, from their career numbers.</p>
        <div class="rs-cols">
          <div>
            <h3 class="rs-h3">Your XI</h3>
            <ol class="rs-list" id="rs-user-xi"></ol>
          </div>
          <div>
            <h3 class="rs-h3">World XI</h3>
            <ol class="rs-list" id="rs-house-xi"></ol>
          </div>
        </div>
      </section>

      <p class="rs-error" id="rs-error" hidden></p>
    </main>
  </div>

  <script id="bm11-house-xi" type="application/json" set:html={houseJson} />
  <script id="bm11-scoring-context" type="application/json" set:html={scoringContextJson} />
  <script id="bm11-series-calibration" type="application/json" set:html={calibrationJson} />

  <script>
    import { compareXIs } from '../lib/seven-metrics';
    import { playSeries, xiSeed } from '../lib/series';
    import { SHARE_RESULTS, encodeXI } from '../lib/share-results';
    import { drawShareCard, cardBlob } from '../lib/share-card';

    const read = (id) => JSON.parse(document.getElementById(id).textContent || 'null');
    const HOUSE_XI = read('bm11-house-xi') || [];
    const SCORING_CONTEXT = read('bm11-scoring-context') || {};
    const CALIBRATION = read('bm11-series-calibration');

    // ---------- normalization of stored players (lenient; never zero-fills) ----------
    const VALID_ROLES = new Set(['opener', 'middle-order', 'all-rounder', 'wicketkeeper', 'spinner', 'fast-bowler']);
    const normalizeRole = (r) => String(r ?? '').trim().toLowerCase().replace(/\s+/g, '-');
    const normalizeSecondaryRoles = (raw) => {
      const arr = Array.isArray(raw) ? raw : typeof raw === 'string' && raw ? [raw] : [];
      return arr.map(normalizeRole).filter((r) => VALID_ROLES.has(r));
    };
    const eraString = (era, fallback) => {
      const e = era ?? fallback ?? 'legends';
      return Array.isArray(e) ? String(e[0]) : String(e);
    };
    const finOrNull = (v) => { const n = Number(v); return Number.isFinite(n) ? n : null; };
    const posOrNull = (v) => { const n = Number(v); return Number.isFinite(n) && n > 0 ? n : null; };
    function toScoringPlayer(p, sourceEra) {
      const uid = String(p.uid ?? p.id ?? '');
      const inferredEra = uid.includes(':') ? uid.split(':')[0] : undefined;
      const s = p.stats ?? {};
      return {
        id: String(p.id ?? uid ?? p.name ?? ''),
        uid,
        name: String(p.name ?? ''),
        nation: String(p.nation ?? ''),
        era: eraString(p.draftEra ?? p.era ?? p.displayEra, inferredEra ?? sourceEra),
        primaryRole: normalizeRole(p.primaryRole),
        secondaryRoles: normalizeSecondaryRoles(p.secondaryRoles),
        stats: {
          testAverage: posOrNull(s.testAverage),
          testRuns: finOrNull(s.testRuns),
          testMatches: finOrNull(s.testMatches),
          testCenturies: finOrNull(s.testCenturies),
          testWickets: finOrNull(s.testWickets),
          testBowlingAverage: posOrNull(s.testBowlingAverage),
          bowlingAverage: posOrNull(s.bowlingAverage),
          fiveWs: finOrNull(s.fiveWs),
          tenWs: finOrNull(s.tenWs),
          dismissals: finOrNull(s.dismissals),
        },
      };
    }
    function readDeclaredRoles() {
      try {
        const draft = JSON.parse(localStorage.getItem('beatmy11.draft.v1') || 'null');
        const picks = Array.isArray(draft?.picks) ? draft.picks : [];
        const map = {};
        for (const pk of picks) if (pk && typeof pk.uid === 'string' && typeof pk.role === 'string') map[pk.uid] = pk.role;
        return map;
      } catch {
        return {};
      }
    }
    function readUserXI() {
      try {
        const arr = JSON.parse(localStorage.getItem('beatmy11.userXI.v1') || 'null');
        if (!Array.isArray(arr) || arr.length !== 11) return null;
        return arr.every((p) => p && typeof p === 'object' && (p.uid || p.id) && typeof p.name === 'string' && p.name) ? arr : null;
      } catch {
        return null;
      }
    }

    // ---------- display helpers ----------
    const esc = (v) =>
      String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    const ROLE_SHORT = { opener: 'OPN', 'middle-order': 'BAT', wicketkeeper: 'WK', 'all-rounder': 'AR', spinner: 'SPIN', 'fast-bowler': 'PACE' };
    const NATION_CODES = {
      Australia: 'AUS', England: 'ENG', India: 'IND', Pakistan: 'PAK', 'West Indies': 'WI',
      'New Zealand': 'NZ', 'South Africa': 'SA', 'Sri Lanka': 'SL', Bangladesh: 'BAN', Zimbabwe: 'ZIM',
    };
    const ORDINAL = ['1st', '2nd', '3rd', '4th', '5th'];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const $ = (id) => document.getElementById(id);

    function verdictCopy(s) {
      const last = s.tests[4];
      if (s.user === 5) return { title: 'Whitewash.', sub: 'You beat the World XI five–nil. That almost never happens.' };
      if (s.house === 5) return { title: 'Whitewashed.', sub: 'The World XI won all five. Time for a new XI.' };
      if (s.draws === 1 && s.user === s.house) return { title: 'Series drawn', sub: `You held the World XI to ${s.user}–${s.house}.` };
      if (s.user > s.house) {
        return s.user === 3
          ? { title: 'You beat the World XI', sub: `Level at 2–2, you won the decider at ${last.venue}.` }
          : { title: 'You beat the World XI', sub: `A ${s.user}–${s.house} series win. Convincing.` };
      }
      return s.house === 3
        ? { title: 'So close', sub: `Level at 2–2 — the World XI took the decider at ${last.venue}.` }
        : { title: 'World XI wins', sub: `Beaten ${s.user}–${s.house}. Your next XI could do better.` };
    }

    function testHTML(t, running) {
      const res = t.result === 'user' ? 'Won' : t.result === 'house' ? 'Lost' : 'Drawn';
      return (
        `<li class="rs-test is-${t.result}">` +
        `<div class="rs-test-head"><span class="rs-test-n">${ORDINAL[t.number - 1]} Test · ${esc(t.venue)}</span>` +
        `<span class="rs-chip">${res}</span></div>` +
        `<p class="rs-test-sum">${esc(t.summary)}</p>` +
        (t.hero ? `<p class="rs-test-hero"><span aria-hidden="true">★</span> ${esc(t.hero)}${t.heroSide === 'house' ? ' <em>(World XI)</em>' : ''}</p>` : '') +
        `<p class="rs-test-run">Series ${running}</p>` +
        `</li>`
      );
    }

    function listHTML(rows, marks) {
      return rows
        .map((r) => {
          const mark = marks[r.id] ? `<span class="rs-badge ${marks[r.id].cls}">${marks[r.id].text}</span>` : '';
          return (
            `<li class="rs-row"><span class="rs-rating">${Math.round(r.rating)}</span>` +
            `<span class="rs-who"><span class="rs-name">${esc(r.name)} ${mark}</span>` +
            `<span class="rs-meta">${esc(ROLE_SHORT[r.role] || r.role)} · ${esc(NATION_CODES[r.nation] || r.nation)} · ${esc(r.era === 'legends' ? 'Legends' : r.era)}</span></span></li>`
          );
        })
        .join('');
    }

    function run() {
      const userRaw = readUserXI();
      if (!userRaw) {
        window.location.href = '/play';
        return;
      }
      const declared = readDeclaredRoles();
      const userEntries = userRaw.map((p) => ({
        player: toScoringPlayer(p, 'legends'),
        declaredRole: declared[String(p.uid ?? p.id ?? '')] ?? null,
      }));
      const houseEntries = HOUSE_XI.map((p) => ({ player: toScoringPlayer(p, 'legends'), declaredRole: normalizeRole(p.primaryRole) }));

      let cmp;
      try {
        cmp = compareXIs(userEntries, houseEntries, SCORING_CONTEXT);
      } catch {
        $('rs-error').hidden = false;
        $('rs-error').textContent = 'A statistic this XI needs is missing from our data, so the series can’t be played. Draft again with a different XI.';
        $('rs-skip').hidden = true;
        $('rs-actions').hidden = false;
        $('rs-share').hidden = true;
        return;
      }

      const toSeries = (entries, scores) =>
        entries.map((e, i) => ({
          id: e.player.id,
          name: e.player.name,
          nation: e.player.nation,
          era: e.player.era,
          role: scores[i].role,
          rating: scores[i].score ?? 0,
          stats: e.player.stats,
        }));
      const userXI = toSeries(userEntries, cmp.userPlayers);
      const houseXI = toSeries(houseEntries, cmp.opponentPlayers);
      const series = playSeries({
        userScore: cmp.userScore,
        houseScore: cmp.opponentScore,
        userXI,
        houseXI,
        calibration: CALIBRATION,
        seed: xiSeed(userXI.map((p) => ({ id: p.id, role: p.role }))),
      });

      // Ratings, revealed: the best pick in the user's XI.
      const sorted = [...userXI].sort((a, b) => b.rating - a.rating);
      const marks = {
        [sorted[0].id]: { text: 'Best pick', cls: 'is-best' },
      };
      $('rs-user-xi').innerHTML = listHTML(userXI, marks);
      $('rs-house-xi').innerHTML = listHTML(houseXI, {});

      const copy = verdictCopy(series);
      const pct = Math.round(series.percentile * 100);
      const rankText =
        series.topPercent <= 50
          ? `Your XI ranks in the top ${series.topPercent}% of all drafts.`
          : `Your XI ranks in the bottom ${Math.max(1, pct)}% of all drafts.`;

      // ---- the reveal ----
      const testsEl = $('rs-tests');
      let shown = 0;
      let u = 0;
      let h = 0;
      let timer = 0;
      let revealed = false;
      let cardFile = null; // the share card, once drawn (see "share" below)
      const finish = () => {
        window.clearTimeout(timer);
        while (shown < 5) step(true);
        $('rs-title').textContent = copy.title;
        $('rs-sub').textContent = copy.sub;
        $('rs-rank').textContent = rankText;
        $('rs-rank').hidden = false;
        $('rs-skip').hidden = true;
        $('rs-actions').hidden = false;
        $('rs-xis').hidden = false;
        revealed = true;
        showCard();
        document.querySelector('.rs-verdict').classList.add(
          series.user > series.house ? 'is-win' : series.user < series.house ? 'is-loss' : 'is-draw',
          ...(series.user === 5 ? ['is-whitewash'] : []),
        );
      };
      function step(instant) {
        const t = series.tests[shown];
        if (t.result === 'user') u++;
        if (t.result === 'house') h++;
        shown++;
        $('rs-user').textContent = String(u);
        $('rs-house').textContent = String(h);
        testsEl.insertAdjacentHTML('beforeend', testHTML(t, `${u}–${h}`));
        const li = testsEl.lastElementChild;
        if (!instant && !reduceMotion) li.classList.add('is-new');
        $('rs-sub').textContent = shown < 5 ? `After the ${ORDINAL[shown - 1]} Test at ${t.venue}: ${u}–${h}` : '';
        if (!instant && shown < 5) timer = window.setTimeout(() => step(false), 1100);
        else if (!instant) timer = window.setTimeout(finish, 900);
      }
      $('rs-skip').addEventListener('click', finish);
      if (reduceMotion) finish();
      else timer = window.setTimeout(() => step(false), 600);

      // ---- share ----
      // The link goes to the scoreline's page (/r/3-2, whose link preview
      // shows that result) and carries the XI so the page can list it. The
      // XI itself travels as a picture: the share card, drawn here.
      const slug = `${series.user}-${series.house}`;
      const url = `${location.origin}/r/${slug}?xi=${encodeXI(userXI.map((p) => ({ id: p.id, role: p.role })))}`;
      const shareText =
        series.user === 5
          ? `I whitewashed the World XI 5–0 with my all-time Test XI 🏏 Can you?`
          : series.user > series.house
            ? `My all-time Test XI beat the World XI ${series.user}–${series.house} 🏏 Can yours?`
            : series.user === series.house
              ? `My all-time Test XI drew ${series.user}–${series.house} with the World XI 🏏 Can you beat it?`
              : `My all-time Test XI lost ${series.user}–${series.house} to the World XI 🏏 Can you beat it?`;

      // Drawn straight away so it's ready when the reveal ends; the share
      // sheet must open within the tap's activation window.
      const fileName = `beat-my-11-${slug}.png`;
      drawShareCard({
        user: series.user,
        house: series.house,
        draws: series.draws,
        headline: SHARE_RESULTS.find((r) => r.slug === slug)?.imageHeadline ?? 'Beat My 11',
        xi: userXI.map((p) => ({ name: p.name, role: ROLE_SHORT[p.role] || '', nation: NATION_CODES[p.nation] || p.nation })),
        rank: series.topPercent <= 50 ? `Top ${series.topPercent}% of drafts` : '',
      })
        .then(cardBlob)
        .then((blob) => {
          if (!blob) return;
          cardFile = new File([blob], fileName, { type: 'image/png' });
          const href = URL.createObjectURL(blob);
          $('rs-card-img').src = href;
          $('rs-save').href = href;
          $('rs-save').download = fileName;
          showCard();
        })
        .catch(() => {
          /* no card — sharing falls back to text and link */
        });
      function showCard() {
        if (!revealed || !cardFile) return;
        $('rs-card').hidden = false;
        $('rs-save').hidden = false;
      }

      $('rs-share').addEventListener('click', async () => {
        const message = `${shareText} ${url}`;
        try {
          // Picture + link where the platform can share files (phones).
          if (cardFile && navigator.canShare?.({ files: [cardFile] })) {
            await navigator.share({ files: [cardFile], title: 'Beat My 11', text: message });
            return;
          }
          if (navigator.share) {
            await navigator.share({ title: 'Beat My 11', text: shareText, url });
            return;
          }
          // Desktop: save the card and copy the message.
          await navigator.clipboard.writeText(message);
          if (cardFile) {
            $('rs-save').click();
            $('rs-copied').textContent = 'Card saved and link copied. Post them anywhere.';
          } else {
            $('rs-copied').textContent = 'Copied. Paste it anywhere.';
          }
        } catch (err) {
          if (err && err.name === 'AbortError') return; // share sheet dismissed
          try {
            await navigator.clipboard.writeText(message);
            $('rs-copied').textContent = 'Link copied. Paste it anywhere.';
          } catch {
            /* clipboard blocked too — nothing more to do */
          }
        }
      });
    }

    // "Draft again" starts a fresh draft.
    for (const a of document.querySelectorAll('[data-rs-again]')) {
      a.addEventListener('click', () => {
        try {
          localStorage.removeItem('beatmy11.userXI.v1');
          localStorage.removeItem('beatmy11.draft.v1');
        } catch {
          /* storage unavailable — navigation still works */
        }
      });
    }
    run();
  </script>

  <style is:global>
    /* ============ /matchup — Floodlit night (mobile-first) ============ */
    .rs {
      --rs-bg: #04060c;
      --rs-text: #eaf0ff;
      --rs-muted: #9aa6c4;
      --rs-dim: #6b7694;
      --rs-lime: #c6ff3d;
      --rs-loss: #ff6b5e;
      --rs-draw: #9aa6c4;
      --rs-display: 'Bebas Neue', 'Oswald', 'Arial Narrow', sans-serif;
      position: relative; min-height: 100vh; padding: 12px 16px 48px; overflow-x: clip;
      background: var(--rs-bg); color: var(--rs-text); font-family: Inter, system-ui, sans-serif;
    }
    body:has(.rs) { background: #04060c; }
    .rs-lights {
      position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background:
        radial-gradient(60vw 50vh at 6% -12%, rgba(180, 220, 255, 0.2), transparent 60%),
        radial-gradient(60vw 50vh at 94% -12%, rgba(180, 220, 255, 0.2), transparent 60%),
        radial-gradient(90vw 45vh at 50% 115%, rgba(40, 160, 90, 0.22), transparent 70%);
    }
    .rs > *:not(.rs-lights) { position: relative; z-index: 1; }
    .rs :focus-visible { outline: 3px solid var(--rs-lime); outline-offset: 2px; }
    .rs-top { display: flex; align-items: center; justify-content: space-between; max-width: 900px; margin: 0 auto; }
    .rs-brand { font: 400 26px/1 var(--rs-display); letter-spacing: 0.08em; color: var(--rs-text); text-decoration: none; }
    .rs-again-top { color: var(--rs-muted); font: 600 13px Inter, sans-serif; text-decoration: none; padding: 10px 4px; }

    .rs-verdict { text-align: center; max-width: 640px; margin: 22px auto 8px; }
    .rs-eyebrow { margin: 0; font: 600 11px Inter, sans-serif; letter-spacing: 0.3em; text-transform: uppercase; color: var(--rs-muted); }
    .rs-title { margin: 6px 0 4px; font: 400 clamp(40px, 12vw, 76px)/0.95 var(--rs-display); letter-spacing: 0.03em; }
    .rs-verdict.is-win .rs-title { color: var(--rs-lime); text-shadow: 0 0 30px rgba(198, 255, 61, 0.45); }
    .rs-verdict.is-whitewash .rs-title { animation: rs-pulse 1.6s ease-in-out 2; }
    @keyframes rs-pulse { 50% { text-shadow: 0 0 60px rgba(198, 255, 61, 0.9); } }
    .rs-score { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 6px 0 2px; }
    .rs-side { display: flex; flex-direction: column; align-items: center; min-width: 88px; }
    .rs-num { font: 400 clamp(72px, 24vw, 128px)/0.9 var(--rs-display); }
    .rs-lab { font: 600 11px Inter, sans-serif; letter-spacing: 0.2em; text-transform: uppercase; color: var(--rs-muted); }
    .rs-dash { font: 400 56px/1 var(--rs-display); color: var(--rs-dim); margin-top: -18px; }
    .rs-verdict.is-win .rs-side:first-child .rs-num { color: var(--rs-lime); }
    .rs-verdict.is-loss .rs-side:last-child .rs-num { color: var(--rs-loss); }
    .rs-sub { margin: 8px 0 0; min-height: 22px; color: var(--rs-muted); font-size: 15px; }
    .rs-rank { margin: 10px auto 0; display: inline-block; padding: 6px 12px; border-radius: 999px; border: 1px solid rgba(198, 255, 61, 0.4); color: var(--rs-lime); font: 600 13px Inter, sans-serif; }
    .rs-skip { margin: 12px auto 0; display: block; background: none; border: 0; color: var(--rs-dim); text-decoration: underline; font: 500 13px Inter, sans-serif; min-height: 40px; cursor: pointer; }
    .rs-skip[hidden] { display: none; }

    .rs-tests { list-style: none; margin: 14px auto 0; padding: 0; max-width: 640px; display: grid; gap: 10px; }
    .rs-test {
      padding: 12px 14px; border-radius: 14px; border: 1px solid rgba(255, 255, 255, 0.1);
      background: linear-gradient(160deg, #16223a, #0b1020 70%); border-left-width: 4px;
    }
    .rs-test.is-user { border-left-color: var(--rs-lime); }
    .rs-test.is-house { border-left-color: var(--rs-loss); }
    .rs-test.is-draw { border-left-color: var(--rs-draw); }
    .rs-test.is-new { animation: rs-in 0.45s cubic-bezier(0.2, 1.2, 0.4, 1); }
    @keyframes rs-in { from { opacity: 0; transform: translateY(12px) scale(0.98); } to { opacity: 1; transform: none; } }
    .rs-test-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .rs-test-n { font: 400 20px/1 var(--rs-display); letter-spacing: 0.05em; }
    .rs-chip { font: 700 10.5px Inter, sans-serif; letter-spacing: 0.12em; text-transform: uppercase; padding: 4px 8px; border-radius: 6px; }
