---
/**
 * /odi/r/<user>-<house> — a shared ODI series result. The screen is components/SharedResult.astro.
 */
import SharedResult from '../../../components/SharedResult.astro';
import { shareResultsFor, type ShareResult } from '../../../lib/share-results';
import { wbPlayers } from '../../../lib/formats/white-ball-store';
import { ODI_FORMAT } from '../../../lib/formats/draft-format';
import { ODI_RESULT } from '../../../lib/formats/result-format';

export function getStaticPaths() {
  return shareResultsFor({ opponent: ODI_RESULT.opponent, xiNoun: ODI_RESULT.xiNoun }).map((r) => ({ params: { result: r.slug }, props: { r } }));
}

const { r } = Astro.props as { r: ShareResult };
// One name per player id (IPL: a player has several stints; the list shows the name only).
const names: Record<string, [string, string]> = {};
for (const p of wbPlayers('odi')) names[p.id] ??= [p.name, ODI_FORMAT.teamCodes[p.stint?.team ?? p.nation ?? ''] ?? ''];
---
<SharedResult r={r} names={names} eyebrow={ODI_RESULT.eyebrow} opponent={ODI_RESULT.opponent} playHref={ODI_RESULT.playHref} ogImage={`/og/odi/${r.slug}.png`} />
