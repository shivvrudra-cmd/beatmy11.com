---
/**
 * play.astro — the BeatMy11 spin draft, "Floodlit night" design
 * (owner-chosen 2026-09-29, replacing "The Ground").
 *
 * Flow: SPIN → round 1 always draws the Legends era (pick your 1 Legend) →
 * rounds 2–6 draw random era+nation combos (2 picks each) → 11 players →
 * PLAY THE SERIES → /matchup.
 *
 * Layout: a floodlit stage (Era × Nation reels, respins, spin button,
 * status), a pool of trading cards for the current draw, and a fixed
 * bottom dock holding the eleven XI slots — always on screen, so
 * select-then-place never needs scrolling.
 *
 * Ratings are deliberately NOT shown during the draft (owner decision):
 * cards carry real Test stats only and are ordered by role, then name —
 * never by strength — so the best pick is a judgment call. Ratings are
 * revealed on the result screen.
 *
 * All rules live in src/lib/player-logic.ts (createDraft / applySpinResult
 * / applyDraftPick / applyDraftMove / applyDraftDeselect / respins); this
 * page keeps ONE draft object as the source of truth and re-renders from
 * it. The plain player array (slot order) is persisted to
 * `beatmy11.userXI.v1` (/matchup's contract); draft extras live under
 * `beatmy11.draft.v1`.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { allPlayersByEra, legendsSpinCombos, draftSpinCombos } from '@/lib/player-store';

// Escaped so a stray "</" sequence can never break out of the script element.
const json = (v: unknown) => JSON.stringify(v).replace(/<\//g, '<\\/');
const playerDataJson = json(allPlayersByEra());
const legendCombosJson = json(legendsSpinCombos());
const draftCombosJson = json(draftSpinCombos());
---
<BaseLayout
  title="Play Beat My 11 — Draft Your All-Time XI"
  description="Spin to draw an era and nation, draft 11 players across six rounds, then take your XI into a five-Test series against the house team."
>
  <div class="fl" id="bm11-main">
    <div class="fl-lights" aria-hidden="true"></div>
    <a class="fl-skip" href="#fl-pool">Skip to players</a>
    <p id="bm11-live" class="sr-only" role="status" aria-live="polite"></p>

    <header class="fl-top">
      <a class="fl-brand" href="/" aria-label="Beat My 11 home">BEAT MY 11</a>
      <div class="fl-rounds" id="fl-rounds" role="img" aria-label="Round 1 of 6"></div>
      <p class="fl-count"><span id="bm11-count">0/11</span></p>
    </header>

    <main>
      <section class="fl-stage" aria-labelledby="fl-status-title">
        <p class="fl-daily" id="fl-daily" hidden></p>
        <div class="fl-reels">
          <div class="fl-reel" id="fl-reel-nation">
            <span class="fl-reel-cap">Nation</span>
            <span class="fl-reel-val" id="fl-nation">—</span>
          </div>
          <span class="fl-x" aria-hidden="true">×</span>
          <div class="fl-reel" id="fl-reel-era">
            <span class="fl-reel-cap">Era</span>
            <span class="fl-reel-val" id="fl-era">—</span>
          </div>
        </div>
        <div class="fl-respins" id="fl-respins" aria-label="Respins" hidden>
          <button type="button" class="fl-respin" id="fl-respin-nation" hidden></button>
          <button type="button" class="fl-respin" id="fl-respin-era" hidden></button>
        </div>
        <button type="button" class="fl-spin" id="bm11-spin">Spin</button>
        <h1 class="fl-status" id="fl-status-title" tabindex="-1">Spin for your Legend</h1>
        <p class="fl-sub" id="fl-sub"></p>
        <p class="fl-msg" id="bm11-msg" role="status"></p>
      </section>

      <section class="fl-pool" id="fl-pool" aria-labelledby="fl-pool-title" tabindex="-1">
        <h2 class="sr-only" id="fl-pool-title">Players in this draw</h2>
        <p class="fl-pool-meta" id="fl-pool-meta" aria-hidden="true"></p>
        <div class="fl-cards" id="fl-cards"></div>
      </section>

      <div class="fl-finish" id="fl-finish" hidden>
        <a href="/matchup" class="fl-cta is-disabled" id="bm11-cta" aria-disabled="true">Play the series →</a>
        <button type="button" class="fl-link" id="fl-startover" hidden>Start over</button>
      </div>
    </main>

    <nav class="fl-dock" aria-label="Your XI">
      <div class="fl-slots" id="fl-slots"></div>
    </nav>
  </div>

  <!-- Role chooser: only when the tapped slot admits more than one legal
       declaration (e.g. Sangakkara as batter or keeper). -->
  <div id="bm11-role-chooser" class="fl-chooser" hidden>
    <div class="fl-chooser-backdrop" data-fl-chooser-cancel></div>
    <div class="fl-chooser-card" role="dialog" aria-modal="true" aria-labelledby="fl-chooser-title">
      <h2 class="fl-chooser-title" id="fl-chooser-title"></h2>
      <p class="fl-chooser-sub" id="fl-chooser-sub"></p>
      <div class="fl-chooser-opts" id="fl-chooser-opts"></div>
      <button type="button" class="fl-link" data-fl-chooser-cancel>Cancel</button>
    </div>
  </div>

  <script type="application/json" id="bm11-player-data" set:html={playerDataJson}></script>
  <script type="application/json" id="bm11-legend-combos" set:html={legendCombosJson}></script>
  <script type="application/json" id="bm11-draft-combos" set:html={draftCombosJson}></script>

  <script>
    import { animate } from 'motion';
    import {
      createDraft,
      selectionLimitForRound,
      isRoundComplete,
      canSpin,
      validatePoolPick,
      validateSlotPlacement,
      validateSlotMove,
      placementOptions,
      applySpinResult,
      applyDraftPick,
      applyDraftMove,
      applyDraftDeselect,
      canRespinNation,
      canRespinEra,
      applyNationRespin,
      applyEraRespin,
      declarationForSlot,
      deserializeDraft,
      saveDraft,
      loadDraft,
      clearDraft,
      saveUserXI,
      clearUserXI,
      slotByKey,
      orderedXI,
      countsOf,
      reachableShapes,
      isXIValid,
      supplyFor,
      XI_SIZE,
      DRAFT_ROUNDS,
      XI_ROLE_LABELS,
      XI_SLOTS,
      POOL_GROUPS,
    } from '../lib/player-logic';
    import { reportEvent } from '../lib/telemetry';
    import {
      utcDayKey, dayNumber, loadDaily, hasPlayed, activeDailyDay, setActiveDaily, dailySpinIndex, upcomingCombos,
    } from '../lib/daily';

    // ------------------------------------------------------------------ data
    const read = (id) => JSON.parse(document.getElementById(id).textContent || 'null');
    const byEra = read('bm11-player-data') || {};
    const LEGEND_COMBOS = read('bm11-legend-combos') || [];
    const DRAFT_COMBOS = read('bm11-draft-combos') || [];
    const uidIndex = {};
    // Drafts saved before player ids were cleaned up (spaces, capitals, apostrophes).
    const legacyUid = (uid) => String(uid).trim().toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9:-]/g, '');
    for (const eraId of Object.keys(byEra)) for (const p of byEra[eraId]) uidIndex[p.uid] = p;

    // A spin never re-lands on an era×nation combo already drawn, and a
    // nation lands at most twice per draft (unchanged live rules).
    const usedComboKeys = () => new Set(draft.spinHistory.map((s) => `${s.era}|${s.nation}`));
    const nationCounts = () => {
      const counts = {};
      for (const s of draft.spinHistory) counts[s.nation] = (counts[s.nation] || 0) + 1;
      return counts;
    };
    const combosForUpcomingRound = () => upcomingCombos(draft.currentRound, draft.spinHistory, LEGEND_COMBOS, DRAFT_COMBOS);
    // Respins: a nation respin keeps the era; an era respin keeps the nation
    // and never lands on Legends (round 1 owns that era).
    const nationRedrawOptions = () => {
      if (!draft.currentEra) return [];
      const base = draft.currentRound === 1 ? LEGEND_COMBOS : DRAFT_COMBOS;
      const used = usedComboKeys();
      const counts = nationCounts();
      return base.filter(
        (c) => c.era === draft.currentEra && c.nation !== draft.currentNation &&
          !used.has(`${c.era}|${c.nation}`) && (counts[c.nation] || 0) < 2,
      );
    };
    const eraRedrawOptions = () => {
      if (!draft.currentNation) return [];
      const used = usedComboKeys();
      return DRAFT_COMBOS.filter(
        (c) => c.nation === draft.currentNation && c.era !== draft.currentEra && !used.has(`${c.era}|${c.nation}`),
      );
    };

    // ---------------------------------------------------------- presentation
    const ERA_NAMES = {
      legends: 'Legends', '1970s': '1970s', '1980s': '1980s', '1990s': '1990s',
      '2000s': '2000s', '2010s': '2010s', '2020s': '2020s',
    };
    const eraName = (id) => ERA_NAMES[id] || id;
    const ERA_LIST = ['1970s', '1980s', '1990s', '2000s', '2010s', '2020s'];
    const NATIONS = ['Australia', 'Bangladesh', 'England', 'India', 'New Zealand', 'Pakistan', 'South Africa', 'Sri Lanka', 'West Indies', 'Zimbabwe'];
    const NATION_CODES = {
      Australia: 'AUS', England: 'ENG', India: 'IND', Pakistan: 'PAK', 'West Indies': 'WI',
      'New Zealand': 'NZ', 'South Africa': 'SA', 'Sri Lanka': 'SL', Bangladesh: 'BAN', Zimbabwe: 'ZIM',
    };
    const ROLE_LABELS = {
      opener: 'Opener', 'middle-order': 'Middle order', wicketkeeper: 'Wicketkeeper',
      'all-rounder': 'All-rounder', 'fast-bowler': 'Fast bowler', spinner: 'Spinner',
    };
    const ROLE_SHORT = {
      opener: 'OPN', 'middle-order': 'BAT', wicketkeeper: 'WK',
      'all-rounder': 'AR', spinner: 'SPIN', 'fast-bowler': 'PACE',
    };
    // Dock groups, batting to bowling. Two rows on phones: batting (1–6),
    // then the flex pair and the pace attack (7–11).
    const DOCK_GROUPS = [
      { label: 'Openers', keys: ['opener-1', 'opener-2'], row: 1 },
      { label: 'Batting 3–6', keys: ['bat-3', 'bat-4', 'bat-5', 'bat-6'], row: 1 },
      { label: 'Spots 7–8', keys: ['flex-7', 'flex-8'], row: 2 },
      { label: 'Pace', keys: ['fast-1', 'fast-2', 'fast-3'], row: 2 },
    ];
    const CHOOSER_SUB = {
      opener: 'Opens the batting',
      'middle-order': 'Bats in the middle order',
      wicketkeeper: 'Fills your keeper slot',
      'all-rounder': 'Batting and bowling value',
      spinner: 'Frontline spin option',
      'fast-bowler': 'Pace attack',
    };
    const ROLE_PLURALS = {
      opener: ['opener', 'openers'],
      'middle-order': ['middle-order batter', 'middle-order batters'],
      wicketkeeper: ['wicketkeeper', 'wicketkeepers'],
      'all-rounder': ['all-rounder', 'all-rounders'],
      spinner: ['spinner', 'spinners'],
      'fast-bowler': ['fast bowler', 'fast bowlers'],
    };
    const XI_ROLE_ORDER = ['opener', 'middle-order', 'wicketkeeper', 'all-rounder', 'spinner', 'fast-bowler'];

    const esc = (v) =>
      String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
    const fmtAvg = (v) => (v == null || Number.isNaN(Number(v)) || Number(v) === 0 ? '–' : Number(v).toFixed(1));
    const fmtInt = (v) => (v == null || Number.isNaN(Number(v)) ? '–' : Math.round(Number(v)).toLocaleString('en-US'));
    const surname = (n) => String(n || '').split(/\s+/).slice(-1)[0];
    const reduceMotion = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const RESPIN_ICON =
      '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>';

    // Four real Test stats per card, chosen by the player's group. No
    // ratings anywhere during the draft.
    function statCells(p) {
      const s = p.stats || {};
      const bowlAvg = s.testBowlingAverage ?? s.bowlingAverage;
      const cell = (v, l) => `<span class="fl-stat"><b>${esc(v)}</b><i>${esc(l)}</i></span>`;
      const pair = (a, b, l) => cell(`${fmtInt(a)}/${fmtInt(b)}`, l);
      const r = p.primaryRole;
      if (r === 'all-rounder') {
        return cell(fmtInt(s.testMatches), 'Tests') + cell(fmtAvg(s.testAverage), 'Bat avg') +
          cell(fmtInt(s.testWickets), 'Wkts') + cell(fmtAvg(bowlAvg), 'Bowl avg');
      }
      if (r === 'spinner' || r === 'fast-bowler') {
        return cell(fmtInt(s.testMatches), 'Tests') + cell(fmtInt(s.testWickets), 'Wkts') +
          cell(fmtAvg(bowlAvg), 'Bowl avg') + pair(s.fiveWs, s.tenWs, '5W/10W');
      }
      if (r === 'wicketkeeper') {
        return cell(fmtInt(s.testMatches), 'Tests') + cell(fmtInt(s.testRuns), 'Runs') +
          cell(fmtAvg(s.testAverage), 'Avg') + cell(fmtInt(s.dismissals), 'Dismissals');
      }
      return cell(fmtInt(s.testMatches), 'Tests') + cell(fmtInt(s.testRuns), 'Runs') +
        cell(fmtAvg(s.testAverage), 'Avg') + pair(s.testFifties, s.testCenturies, '50s/100s');
    }
    const roleTag = (p) =>
      [p.primaryRole, ...(p.secondaryRoles || []).filter((r) => r !== p.primaryRole)]
        .map((r) => ROLE_SHORT[r] || r).join(' / ');
    const groupLabelList = (p) =>
      [p.primaryRole, ...(p.secondaryRoles || [])].map((g) => ROLE_LABELS[g] || g).join(', ');
    const accessibleName = (p) => `${p.name}, ${groupLabelList(p)}, ${p.nation || ''}`;

    // ------------------------------------------------------------------ state
    // ONE draft object; every mutation goes through player-logic, then
    // persist() + renderAll(). UI-only: selectedUid (pool player awaiting a
    // slot), moveFrom (slot armed for a move), chooserState (role chooser).
    let draft = createDraft();
    // Daily Challenge (/play?daily=1): same spins for everyone each UTC day, no respins.
    let isDaily = false;
    const dailyDay = utcDayKey();
    let selectedUid = null;
    let moveFrom = null;
    let chooserState = null;
    let spinningReel = null; // 'both' | 'era' | 'nation' while a reel animates
    let msgTimer = 0;
    let prevFilled = new Set();

    const $ = (id) => document.getElementById(id);
    const liveEl = $('bm11-live');
    const spinBtn = $('bm11-spin');
    const eraEl = $('fl-era');
    const nationEl = $('fl-nation');
    const respinEraBtn = $('fl-respin-era');
    const respinNationBtn = $('fl-respin-nation');
    const cardsEl = $('fl-cards');
    const slotsEl = $('fl-slots');
    const msgEl = $('bm11-msg');
    const ctaEl = $('bm11-cta');

    const announce = (text) => {
      liveEl.textContent = '';
      requestAnimationFrame(() => { liveEl.textContent = text; });
    };
    const flashMsg = (text) => {
      msgEl.textContent = text || '';
      window.clearTimeout(msgTimer);
      if (text) msgTimer = window.setTimeout(() => { msgEl.textContent = ''; }, 4500);
    };
    const persist = () => {
      saveUserXI(orderedXI(draft));
      saveDraft(draft);
    };

    function currentPool() {
      if (!draft.currentEra || !draft.currentNation) return [];
      const out = [];
      const seen = new Set();
      for (const fileEra of Object.keys(byEra)) {
        for (const p of byEra[fileEra]) {
          const eras = Array.isArray(p.era) ? p.era : [p.era];
          if (!eras.includes(draft.currentEra) || p.nation !== draft.currentNation) continue;
          if (seen.has(p.id)) continue;
          seen.add(p.id);
          out.push(p);
        }
      }
      // Neutral order: role groups batting → bowling, then A–Z. Never by
      // strength — the order must not reveal the best pick.
      const roleRank = (p) => {
        const i = POOL_GROUPS.findIndex((g) => g.roles.includes(p.primaryRole));
        return i < 0 ? POOL_GROUPS.length : i;
      };
      return out.sort((a, b) => roleRank(a) - roleRank(b) || a.name.localeCompare(b.name));
    }
    const draftSupply = () => supplyFor(draft, currentPool());
    function unpickedCount(pool) {
      const ids = new Set(draft.selectedPlayers.map((p) => p.id));
      let n = 0;
      for (const p of pool) if (!ids.has(p.id)) n += 1;
      return n;
    }
    const roundDone = () => isRoundComplete(draft, unpickedCount(currentPool()));

    // ------------------------------------------------------------------ stage
    function setReel(el, text, state) {
      el.textContent = text;
      const reel = el.closest('.fl-reel');
      reel.classList.toggle('is-rolling', state === 'rolling');
      if (state === 'landed') {
        reel.classList.remove('is-landed');
        void reel.offsetWidth; // restart the landing animation
        reel.classList.add('is-landed');
      }
    }

    function status() {
      const r = draft.currentRound;
      if (draft.gameComplete) {
        return isXIValid(draft)
          ? { title: 'Your XI is ready', sub: 'Eleven picked. Time to face the World XI over five Tests.' }
          : { title: 'This XI can’t take the field', sub: 'It isn’t a valid combination — start over to draft again.' };
      }
      if (spinningReel) return { title: 'Spinning…', sub: 'Fate is choosing.' };
      if (r === 0) return { title: 'Spin for your Legend', sub: 'Round 1 always draws the Legends era. You pick one.' };
      const left = selectionLimitForRound(r) - draft.picksThisRound.length;
      if (roundDone()) {
        if (r >= DRAFT_ROUNDS) return { title: 'Draft stalled', sub: 'This draw left your XI short. Start over to try again.' };
        return { title: 'Round done — spin again', sub: `Round ${r} of ${DRAFT_ROUNDS} is locked in.` };
      }
      return {
        title: `Pick ${left} from ${eraName(draft.currentEra)} ${draft.currentNation}`,
        sub: selectedUid
          ? 'Now tap a glowing spot in your XI below.'
          : moveFrom
            ? 'Tap a glowing spot to move them, or tap them again to cancel.'
            : 'Tap a player, then a glowing spot in your XI.',
      };
    }

    function renderStage() {
      if (!spinningReel) {
        if (draft.currentEra && draft.currentNation) {
          eraEl.textContent = eraName(draft.currentEra);
          nationEl.textContent = draft.currentNation;
        } else {
          eraEl.textContent = '—';
          nationEl.textContent = '—';
        }
      }
      const st = status();
      $('fl-status-title').textContent = st.title;
      $('fl-sub').textContent = st.sub;

      const done = roundDone();
      const canGo = !spinningReel && !draft.gameComplete && canSpin(draft, unpickedCount(currentPool()));
      spinBtn.hidden = draft.gameComplete;
      spinBtn.disabled = !canGo;
      spinBtn.textContent = spinningReel ? '…' : draft.currentRound > 0 && done ? 'Spin next' : 'Spin';
      spinBtn.setAttribute(
        'aria-label',
        draft.currentRound === 0
          ? 'Spin to draw your Legend — a random nation from the Legends era'
          : 'Spin to draw a random era and nation',
      );

      // Respins: only after a draw lands and before any pick from it.
      const base = !spinningReel && !draft.gameComplete && draft.currentRound >= 1 && draft.picksThisRound.length === 0;
      const showNation = base && canRespinNation(draft, nationRedrawOptions().length);
      const showEra = base && canRespinEra(draft, eraRedrawOptions().length);
      respinNationBtn.hidden = !showNation;
      respinEraBtn.hidden = !showEra;
      $('fl-respins').hidden = !(showNation || showEra);
      if (showNation) {
        respinNationBtn.innerHTML = `${RESPIN_ICON} New nation <span>${draft.nationRespinsLeft} left</span>`;
        respinNationBtn.setAttribute('aria-label',
          `Respin the nation: replace ${draft.currentNation} with a random nation from ${eraName(draft.currentEra)}. No going back. ${draft.nationRespinsLeft} left.`);
      }
      if (showEra) {
        respinEraBtn.innerHTML = `${RESPIN_ICON} New era <span>${draft.eraRespinsLeft} left</span>`;
        respinEraBtn.setAttribute('aria-label',
          `Respin the era: replace ${eraName(draft.currentEra)} with a random era for ${draft.currentNation}. No going back. ${draft.eraRespinsLeft} left.`);
      }

      // Round progress bars.
      const rounds = $('fl-rounds');
      rounds.innerHTML = Array.from({ length: DRAFT_ROUNDS }, (_, i) => {
        const r = i + 1;
        const cls = r < draft.currentRound || (r === draft.currentRound && (done || draft.gameComplete))
          ? 'is-done' : r === draft.currentRound ? 'is-now' : '';
        return `<span class="fl-round ${cls}"></span>`;
      }).join('');
      rounds.setAttribute('aria-label', `Round ${Math.max(1, draft.currentRound)} of ${DRAFT_ROUNDS}`);
      $('bm11-count').textContent = `${draft.selectedPlayers.length}/${XI_SIZE}`;
    }

    // Reel animation: the era lands first, then the nation — a beat of
    // suspense. `which` limits a respin to its own reel.
    function rollReels(which, target, onDone) {
      spinningReel = which;
      renderAll();
      if (reduceMotion()) {
        spinningReel = null;
        onDone();
        return;
      }
      // Round 1 always draws the Legends era: it stays fixed while only the nation spins.
      const eraFixed = draft.currentRound === 0 && which === 'both';
      if (eraFixed) setReel(eraEl, eraName(target.era), 'landed');
      const eras = ERA_LIST;
      const t0 = performance.now();
      const ERA_STOP = which === 'nation' || eraFixed ? 0 : 900;
      const NATION_STOP = which === 'era' ? 900 : 1500;
      const rollEra = which !== 'nation' && !eraFixed;
      const rollNation = which !== 'era';
      const tick = () => {
        const t = performance.now() - t0;
        if (rollEra) {
          if (t < ERA_STOP) setReel(eraEl, eras[Math.floor(Math.random() * eras.length)], 'rolling');
          else if (eraEl.textContent !== eraName(target.era) || eraEl.closest('.fl-reel').classList.contains('is-rolling')) setReel(eraEl, eraName(target.era), 'landed');
        }
        if (rollNation) {
          if (t < NATION_STOP) setReel(nationEl, NATIONS[Math.floor(Math.random() * NATIONS.length)], 'rolling');
          else if (nationEl.closest('.fl-reel').classList.contains('is-rolling')) setReel(nationEl, target.nation, 'landed');
        }
        if (t < Math.max(ERA_STOP, NATION_STOP) + 20) window.setTimeout(tick, 60 + t / 30);
        else {
          spinningReel = null;
          onDone();
        }
      };
      tick();
    }

    spinBtn.addEventListener('click', () => {
      if (spinningReel || !canSpin(draft, unpickedCount(currentPool()))) return;
      const options = combosForUpcomingRound();
      if (!options.length) return;
      // Daily Challenge: the spin is fixed by the date, so every player draws the same.
      const combo = isDaily
        ? options[dailySpinIndex(dailyDay, draft.currentRound, options.length)]
        : options[Math.floor(Math.random() * options.length)];
      selectedUid = null;
      moveFrom = null;
      flashMsg('');
      rollReels('both', combo, () => {
        draft = applySpinResult(draft, combo.era, combo.nation);
        persist();
        renderAll();
        scrollToPool();
        const pickWord = draft.currentRound === 1 ? 'Pick your Legend — 1 player.' : `Pick ${selectionLimitForRound(draft.currentRound)}.`;
        announce(
          `Round ${draft.currentRound} of ${DRAFT_ROUNDS}. Your draw: ${eraName(combo.era)}, ${combo.nation}. ` +
            `${unpickedCount(currentPool())} players available. ${pickWord}`,
        );
      });
    });

    function runRespin(kind) {
      if (spinningReel) return;
      const opts = kind === 'nation' ? nationRedrawOptions() : eraRedrawOptions();
      const allowed = kind === 'nation' ? canRespinNation(draft, opts.length) : canRespinEra(draft, opts.length);
      if (!allowed || !opts.length) return;
      const choice = opts[Math.floor(Math.random() * opts.length)];
      selectedUid = null;
      scrollToTop();
      rollReels(kind, choice, () => {
        draft = kind === 'nation' ? applyNationRespin(draft, choice.nation) : applyEraRespin(draft, choice.era);
        persist();
        renderAll();
        scrollToPool();
        announce(
          `Respin landed on ${eraName(draft.currentEra)}, ${draft.currentNation}. The old draw is gone. ` +
            `${unpickedCount(currentPool())} players available.`,
        );
      });
    }
    respinNationBtn.addEventListener('click', () => runRespin('nation'));
    respinEraBtn.addEventListener('click', () => runRespin('era'));

    function scrollToTop() {
      window.scrollTo({ top: 0, behavior: reduceMotion() ? 'auto' : 'smooth' });
    }

    function scrollToPool() {
      const behavior = reduceMotion() ? 'auto' : 'smooth';
      // Mobile: scroll just far enough to tuck the reels and spin button away,
      // leaving respins, player cards and the XI slots in view.
      const respins = $('fl-respins');
      const target = window.matchMedia('(max-width: 1023px)').matches && !respins.hidden ? respins : $('fl-pool');
      const rect = target.getBoundingClientRect();
      if (rect.top > window.innerHeight * 0.6 || rect.top < 0 || target === respins) {
        target.scrollIntoView({ behavior, block: 'start' });
      }
    }

    // ------------------------------------------------------------------ pool
    function renderPool() {
      const metaEl = $('fl-pool-meta');
      if (!draft.currentEra || !draft.currentNation) {
        metaEl.textContent = '';
        cardsEl.innerHTML =
          '<p class="fl-empty">Under the lights, fate picks the era and the nation. You pick the XI.</p>';
        return;
      }
      const pool = currentPool();
      metaEl.innerHTML = `${pool.length} players <span class="fl-swipe">· swipe for more →</span>`;
      const done = roundDone();
      const supply = draftSupply();
      cardsEl.innerHTML = pool.map((p) => {
        const pick = draft.selectedPlayers.find((s) => s.id === p.id);
        let cls = '';
        let tag = '';
        let title = '';
        let label = accessibleName(p);
        let pressed = 'false';
        let disabled = false;
        if (pick && pick.roundPicked === draft.currentRound && !draft.gameComplete) {
          cls = 'is-picked';
          tag = '<span class="fl-tag">In your XI · tap to remove</span>';
          label += ' (placed — activate to remove)';
          pressed = 'true';
        } else if (pick) {
          cls = 'is-picked is-locked';
          tag = '<span class="fl-tag">In your XI</span>';
          label += ` (locked in from round ${pick.roundPicked})`;
          pressed = 'true';
          disabled = true;
        } else if (draft.gameComplete || done || spinningReel) {
          cls = 'is-off';
          disabled = true;
        } else if (p.uid === selectedUid) {
          cls = 'is-selected';
          label += ' (selected — choose a glowing spot in your XI, or activate again to cancel)';
          pressed = 'true';
        } else {
          const reason = validatePoolPick(draft, p, supply);
          if (reason) {
            cls = 'is-blocked';
            tag = '<span class="fl-tag fl-tag--warn">Can’t fit</span>';
            title = reason;
            label += `. ${reason}`;
          }
        }
        return (
          `<button type="button" class="fl-card bm11-prow ${cls}" data-bm11-select="${esc(p.uid)}"` +
          ` aria-pressed="${pressed}" aria-label="${esc(label)}"${title ? ` title="${esc(title)}"` : ''}` +
          `${disabled ? ' aria-disabled="true"' : ''}>` +
          `<span class="fl-card-role">${esc(roleTag(p))}</span>` +
          `<span class="fl-card-name">${esc(p.name)}</span>` +
          `<span class="fl-card-from">${esc(NATION_CODES[p.nation] || p.nation)} · ${esc(eraName(draft.currentEra))}</span>` +
          `<span class="fl-card-stats">${statCells(p)}</span>` +
          tag +
          `</button>`
        );
      }).join('');
    }

    cardsEl.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-bm11-select]');
      if (btn) onPoolClick(btn.getAttribute('data-bm11-select'), btn);
    });

    function onPoolClick(uid, btn) {
      const p = uidIndex[uid];
      if (!p || spinningReel) return;
      const existing = draft.selectedPlayers.find((s) => s.id === p.id);
      if (existing) {
        if (existing.roundPicked !== draft.currentRound || draft.gameComplete) {
          const msg = `${p.name} is locked in from round ${existing.roundPicked}.`;
          flashMsg(msg);
          announce(msg);
          return;
        }
        selectedUid = null;
        moveFrom = null;
        draft = applyDraftDeselect(draft, p.id);
        announce(`Removed ${p.name}. ${draft.selectedPlayers.length} of ${XI_SIZE} selected.`);
      } else if (selectedUid === uid) {
        selectedUid = null;
        announce(`Deselected ${p.name}.`);
      } else {
        if (roundDone() || draft.gameComplete) return;
        const reason = validatePoolPick(draft, p, draftSupply());
        if (reason) {
          flashMsg(reason);
          announce(reason);
          if (btn && !reduceMotion()) animate(btn, { x: [0, -6, 6, -4, 4, 0] }, { duration: 0.35 });
          return;
        }
        moveFrom = null;
        hideRoleChooser();
        selectedUid = uid;
        flashMsg('');
        announce(`Selected ${p.name} — ${groupLabelList(p)}. Choose a glowing spot in your XI.`);
      }
      persist();
      renderAll();
    }

    function placeSelected(p, slotKey, role, supply) {
      const slot = slotByKey(slotKey);
      const reason = validateSlotPlacement(draft, p, slotKey, role, supply);
      if (reason) {
        flashMsg(reason);
        announce(reason);
        return;
      }
      draft = applyDraftPick(draft, p, slotKey, role, supply);
      selectedUid = null;
      flashMsg('');
      persist();
      renderAll();
      const as = ` as ${XI_ROLE_LABELS[role]}`;
      if (draft.gameComplete) {
        announce(`XI complete — ${p.name} placed at ${slot.label}${as}. Your XI is ready. Play the series.`);
        $('fl-finish').scrollIntoView({ behavior: reduceMotion() ? 'auto' : 'smooth', block: 'center' });
      } else if (roundDone()) {
        announce(`Placed ${p.name} at ${slot.label}${as}. Round ${draft.currentRound} complete — spin again.`);
        scrollToTop();
      } else {
        const left = selectionLimitForRound(draft.currentRound) - draft.picksThisRound.length;
        announce(`Placed ${p.name} at ${slot.label}${as}. ${left} more pick${left === 1 ? '' : 's'} this round.`);
      }
    }

    // ------------------------------------------------------------------ dock
    // Surname in the dock; add the first initial when two picks share one
    // (e.g. S. Hasan / M. Hasan).
    function dockName(p) {
      const sn = surname(p.name);
      const clash = draft.selectedPlayers.some((o) => o.id !== p.id && surname(o.name) === sn);
      return clash ? `${p.name.trim()[0]}. ${sn}` : sn;
    }
    function slotHTML(slotKey) {
      const slot = slotByKey(slotKey);
      const n = XI_SLOTS.findIndex((s) => s.key === slotKey) + 1;
      const occ = draft.slots[slotKey];
      const occupant = occ ? draft.selectedPlayers.find((s) => s.uid === occ.uid) : null;
      const supply = draftSupply();
      const classes = ['fl-slot', 'bm11-fslot'];
      let label = '';
      let aria = '';
      let top = String(n);
      let bottom = '';
      let removable = false;
      const sameGroupOnly = { sameGroupOnly: draft.gameComplete };

      if (occupant && occ) {
        classes.push('is-filled');
        top = ROLE_SHORT[occ.role] || '';
        bottom = dockName(occupant);
        removable = !draft.gameComplete && occupant.roundPicked === draft.currentRound;
        if (moveFrom === slotKey) {
          classes.push('is-armed');
          aria = `${occupant.name}, ${XI_ROLE_LABELS[occ.role]}, spot ${n} — selected for moving. Activate a glowing spot to move them, or this one to cancel.`;
        } else if (moveFrom && validateSlotMove(draft, moveFrom, slotKey, supply, sameGroupOnly) === null) {
          classes.push('is-glow');
          aria = `${occupant.name}, spot ${n} — activate to swap with the selected player.`;
        } else {
          aria = `${occupant.name}, ${XI_ROLE_LABELS[occ.role]}, spot ${n}. Activate to move.`;
        }
      } else {
        classes.push('is-empty');
        // Keep the empty label honest: when only one role can still fill a
        // multi-role slot, name that role.
        let roleKey = slot.roles[0];
        if (slot.roles.length > 1) {
          const counts = countsOf(draft);
          const shapes = reachableShapes(counts);
          const open = slot.roles.filter((r) => shapes.some((s) => (counts[r] || 0) < s[r]));
          roleKey = open.length === 1 ? open[0] : null;
        }
        bottom = roleKey ? ROLE_SHORT[roleKey] : 'AR/SPIN';
        label = roleKey ? XI_ROLE_LABELS[roleKey] : slot.roles.map((r) => XI_ROLE_LABELS[r]).join(' or ');
        if (selectedUid && uidIndex[selectedUid]) {
          const p = uidIndex[selectedUid];
          const role = declarationForSlot(draft, p, slotKey, supply);
          if (role) {
            classes.push('is-glow');
            const multi = placementOptions(draft, p, slotKey, supply).filter((o) => !o.reason).length > 1;
            aria = `Spot ${n}, ${label} — empty. Activate to place ${p.name}${multi ? ', then choose a role.' : ` as ${XI_ROLE_LABELS[role]}.`}`;
          } else {
            aria = `Spot ${n}, ${label} — empty. ${p.name} can't play here.`;
          }
        } else if (moveFrom && validateSlotMove(draft, moveFrom, slotKey, supply, sameGroupOnly) === null) {
          classes.push('is-glow');
          aria = `Spot ${n}, ${label} — empty. Activate to move the selected player here.`;
        } else {
          aria = `Spot ${n}, ${label} — empty.`;
        }
      }
      return (
        `<div class="fl-slot-wrap">` +
        `<button type="button" class="${classes.join(' ')}" data-bm11-slot="${esc(slotKey)}" aria-label="${esc(aria)}"` +
        `${moveFrom === slotKey ? ' aria-pressed="true"' : ''}>` +
        `<span class="fl-slot-top">${esc(top)}</span><span class="fl-slot-bottom">${esc(bottom)}</span></button>` +
        (removable
          ? `<button type="button" class="fl-slot-x" data-fl-deselect="${esc(occupant.id)}" aria-label="Remove ${esc(occupant.name)}">×</button>`
          : '') +
        `</div>`
      );
    }

    function renderDock() {
      slotsEl.innerHTML = DOCK_GROUPS.map(
        (g) => `<div class="fl-group fl-row-${g.row}" role="group" aria-label="${esc(g.label)}">${g.keys.map(slotHTML).join('')}</div>`,
      ).join('');

      // Newly filled slots pop in.
      const filledNow = new Set(Object.keys(draft.slots).filter((k) => draft.slots[k]));
      if (!reduceMotion()) {
        for (const key of filledNow) {
          if (prevFilled.has(key)) continue;
          const el = slotsEl.querySelector(`[data-bm11-slot="${key}"]`);
          if (el) animate(el, { scale: [0.4, 1.15, 1], opacity: [0, 1, 1] }, { duration: 0.45, easing: [0.22, 1, 0.36, 1] });
        }
      }
      prevFilled = filledNow;
    }

    function onSlotClick(slotKey) {
      const slot = slotByKey(slotKey);
      if (!slot || spinningReel) return;
      const occupied = !!draft.slots[slotKey];
      if (selectedUid) {
        const p = uidIndex[selectedUid];
        if (!p) { selectedUid = null; renderAll(); return; }
        const supply = draftSupply();
        const options = placementOptions(draft, p, slotKey, supply);
        const legal = options.filter((o) => !o.reason);
        if (!legal.length) {
          const blocked = options.find((o) => o.reason);
          const reason = (blocked && blocked.reason) || validatePoolPick(draft, p, supply) || `${p.name} can't play there.`;
          flashMsg(reason);
          announce(reason);
          return;
        }
        if (legal.length === 1) placeSelected(p, slotKey, legal[0].role, supply);
        else showRoleChooser(p, slotKey, legal.map((o) => o.role), supply);
        return;
      }
      if (moveFrom) {
        if (moveFrom === slotKey) {
          moveFrom = null;
          announce('Move cancelled.');
        } else {
          const opts = { sameGroupOnly: draft.gameComplete };
          const reason = validateSlotMove(draft, moveFrom, slotKey, draftSupply(), opts);
          if (reason) { flashMsg(reason); announce(reason); return; }
          const mover = draft.selectedPlayers.find((s) => s.uid === draft.slots[moveFrom]?.uid);
          draft = applyDraftMove(draft, moveFrom, slotKey, draftSupply(), opts);
          moveFrom = null;
          flashMsg('');
          announce(mover ? `${mover.name} ${occupied ? 'swapped' : 'moved'} to ${slot.label}.` : `Moved to ${slot.label}.`);
        }
      } else if (occupied) {
        const p = draft.selectedPlayers.find((s) => s.uid === draft.slots[slotKey].uid);
        moveFrom = slotKey;
        announce(`Selected ${p ? p.name : slot.label} to move. Choose a glowing spot, or the same spot to cancel.`);
      } else {
        const hint = 'Pick a player from the draw first — then choose their spot.';
        flashMsg(hint);
        announce(hint);
        return;
      }
      persist();
      renderAll();
    }

    document.addEventListener('click', (e) => {
      const opt = e.target.closest('[data-fl-chooser-role]');
      if (opt) {
        const st = chooserState;
        const p = st && uidIndex[st.uid];
        const role = opt.getAttribute('data-fl-chooser-role');
        hideRoleChooser();
        if (st && p && role) placeSelected(p, st.slotKey, role, st.supply);
        return;
      }
      if (e.target.closest('[data-fl-chooser-cancel]')) {
        hideRoleChooser();
        announce('Role choice cancelled.');
        return;
      }
      const rm = e.target.closest('[data-fl-deselect]');
      if (rm) {
        const rawId = rm.getAttribute('data-fl-deselect');
        const p = draft.selectedPlayers.find((s) => s.id === rawId);
        if (!p) return;
        selectedUid = null;
        moveFrom = null;
        draft = applyDraftDeselect(draft, rawId);
        persist();
        renderAll();
        announce(`Removed ${p.name}. ${draft.selectedPlayers.length} of ${XI_SIZE} selected.`);
        return;
      }
      const slotBtn = e.target.closest('[data-bm11-slot]');
      if (slotBtn) onSlotClick(slotBtn.getAttribute('data-bm11-slot'));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (chooserState) { hideRoleChooser(); announce('Role choice cancelled.'); return; }
      if (!selectedUid && !moveFrom) return;
      selectedUid = null;
      moveFrom = null;
      renderAll();
      announce('Selection cancelled.');
    });

    // ---------------------------------------------------------- role chooser
    function showRoleChooser(p, slotKey, roles, supply) {
      const slot = slotByKey(slotKey);
      const suggested = declarationForSlot(draft, p, slotKey, supply);
      chooserState = { uid: p.uid, slotKey, supply };
      $('fl-chooser-title').textContent = `Play ${p.name} as…`;
      $('fl-chooser-sub').textContent = `${slot ? slot.label : 'This spot'} takes ${p.name} ${roles.length === 2 ? 'two' : roles.length} ways.`;
      $('fl-chooser-opts').innerHTML = roles.map((role) => {
        const sugg = role === suggested;
        return (
          `<button type="button" class="fl-chooser-opt${sugg ? ' is-suggested' : ''}" data-fl-chooser-role="${role}" data-bm11-chooser-role="${role}">` +
          `<span class="fl-chooser-name">${esc(XI_ROLE_LABELS[role])}${sugg ? ' <em>Suggested</em>' : ''}</span>` +
          `<span class="fl-chooser-desc">${esc(CHOOSER_SUB[role] || '')}</span></button>`
        );
      }).join('');
      const box = $('bm11-role-chooser');
      box.hidden = false;
      (box.querySelector('.fl-chooser-opt.is-suggested') || box.querySelector('.fl-chooser-opt'))?.focus();
      announce(`${p.name} can play ${roles.map((r) => XI_ROLE_LABELS[r]).join(' or ')} here. Choose a role.`);
    }
    function hideRoleChooser() {
      chooserState = null;
      $('bm11-role-chooser').hidden = true;
    }

    // ---------------------------------------------------------------- finish
    function renderFinish() {
      const ready = isXIValid(draft);
      const stalled = !draft.gameComplete && draft.currentRound >= DRAFT_ROUNDS && draft.currentRound > 0 && roundDone();
      const deadEnd = stalled || (draft.gameComplete && !ready);
      $('fl-finish').hidden = !(draft.gameComplete || stalled);
      ctaEl.hidden = !ready;
      ctaEl.classList.toggle('is-disabled', !ready);
      ctaEl.setAttribute('aria-disabled', ready ? 'false' : 'true');
      $('fl-startover').hidden = !deadEnd;
    }
    ctaEl.addEventListener('click', (e) => {
      if (isXIValid(draft)) return; // let the link through
      e.preventDefault();
      const need = XI_SIZE - draft.selectedPlayers.length;
      const msg = draft.gameComplete
        ? 'This XI is not a valid combination — start over to draft a valid XI.'
        : `Place ${need} more player${need === 1 ? '' : 's'} to complete your XI.`;
      flashMsg(msg);
      announce(msg);
    });
    $('fl-startover').addEventListener('click', () => {
      setActiveDaily(null);
      isDaily = false;
      $('fl-daily').hidden = true;
      draft = createDraft();
      selectedUid = null;
      moveFrom = null;
      clearUserXI();
      clearDraft();
      flashMsg('');
      renderAll();
      announce('Draft reset. Spin to begin a new draft.');
      window.scrollTo({ top: 0, behavior: 'auto' });
      spinBtn.focus({ preventScroll: true });
    });

    // ---------------------------------------------------------------- render
    function renderAll() {
      renderStage();
      renderPool();
      renderDock();
      renderFinish();
    }

    (function restore() {
      if (new URLSearchParams(location.search).get('daily') === '1') {
        if (hasPlayed(loadDaily(), dailyDay)) {
          location.replace('/');
          return;
        }
        if (activeDailyDay() !== dailyDay) {
          // A fresh daily replaces any draft in progress.
          const saved = loadDraft();
          const inProgress = saved && Array.isArray(saved.picks) && saved.picks.length > 0;
          if (inProgress && !window.confirm('Starting the Daily Challenge will replace your draft in progress. Continue?')) {
            location.replace('/play');
            return;
          }
          clearUserXI();
          clearDraft();
          setActiveDaily(dailyDay);
        }
      }
      isDaily = activeDailyDay() === dailyDay;
      if (isDaily) {
        const tag = $('fl-daily');
        tag.textContent = `Daily Challenge #${dayNumber(dailyDay)} · same spins for everyone today · no respins`;
        tag.hidden = false;
        draft = { ...draft, eraRespinsLeft: 0, nationRespinsLeft: 0 };
      }
      if (new URLSearchParams(location.search).get('daily') === '1' && isDaily) reportEvent('daily_started');
      const raw = loadDraft();
      if (raw) {
        const restored = deserializeDraft(raw, (uid) => uidIndex[uid] || uidIndex[legacyUid(uid)] || null);
        if (restored && restored.selectedPlayers.length) {
          draft = isDaily ? { ...restored, eraRespinsLeft: 0, nationRespinsLeft: 0 } : restored;
          renderAll();
          announce(
            draft.gameComplete
              ? 'Welcome back — your XI is complete. Play the series.'
              : `Welcome back — round ${draft.currentRound} of ${DRAFT_ROUNDS}, ${draft.selectedPlayers.length} of ${XI_SIZE} picked.`,
          );
          return;
        }
        clearDraft();
      }
      renderAll();
    })();

    // Keep the page's bottom padding equal to the fixed dock's real height, so
    // content that fits the screen never needs scrolling.
    const dockEl = document.querySelector('.fl-dock');
    if (dockEl && 'ResizeObserver' in window) {
      new ResizeObserver(() => {
        document.querySelector('.fl').style.setProperty('--fl-dock-h', `${dockEl.offsetHeight}px`);
      }).observe(dockEl);
    }
  </script>

  <style is:global>
    /* ============ /play — Floodlit night ============
       Tokens are local to the game screen; the page is dark by design
       (a night match under lights), so it does not follow the OS theme. */
    .fl {
      --fl-bg: #04060c;
      --fl-panel: #0b1020;
      --fl-panel-2: #16223a;
      --fl-line: rgba(255, 255, 255, 0.1);
      --fl-text: #eaf0ff;
      --fl-muted: #9aa6c4;
      --fl-dim: #6b7694;
      --fl-lime: #c6ff3d;
      --fl-lime-soft: rgba(198, 255, 61, 0.14);
      --fl-warn: #ff6b5e;
      --fl-display: 'Bebas Neue', 'Oswald', 'Arial Narrow', sans-serif;
      position: relative;
      min-height: 100vh;
      background: var(--fl-bg);
      color: var(--fl-text);
      font-family: Inter, system-ui, sans-serif;
      padding: 12px 16px calc(var(--fl-dock-h, 190px) + 8px);
      overflow-x: clip;
    }
    body:has(.fl) { background: #04060c; }
    .fl-lights {
      position: fixed; inset: 0; pointer-events: none; z-index: 0;
      background:
        radial-gradient(60vw 50vh at 6% -12%, rgba(180, 220, 255, 0.2), transparent 60%),
        radial-gradient(60vw 50vh at 94% -12%, rgba(180, 220, 255, 0.2), transparent 60%),
        radial-gradient(90vw 45vh at 50% 115%, rgba(40, 160, 90, 0.24), transparent 70%);
    }
    .fl > *:not(.fl-lights):not(.fl-dock) { position: relative; z-index: 1; }
    .fl-skip { position: absolute; left: -9999px; }
    .fl-skip:focus { left: 16px; top: 8px; z-index: 50; background: var(--fl-lime); color: #04060c; padding: 8px 12px; border-radius: 8px; }
    .fl :focus-visible { outline: 3px solid var(--fl-lime); outline-offset: 2px; }

    .fl-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; max-width: 1100px; margin: 0 auto; }
    .fl-brand { font: 400 26px/1 var(--fl-display); letter-spacing: 0.08em; color: var(--fl-text); text-decoration: none; }
    .fl-rounds { display: flex; gap: 5px; }
    .fl-round { width: 20px; height: 6px; border-radius: 3px; background: rgba(255, 255, 255, 0.14); }
    .fl-round.is-done { background: var(--fl-lime); }
    .fl-round.is-now { background: #fff; box-shadow: 0 0 10px #fff; }
    .fl-brand, .fl-count { white-space: nowrap; flex-shrink: 0; }
    .fl-count { margin: 0; font: 400 30px/1 var(--fl-display); }

    .fl-stage { text-align: center; max-width: 900px; margin: 18px auto 6px; }
    .fl-reels { display: flex; align-items: flex-start; justify-content: center; gap: 10px; }
    .fl-x { align-self: center; margin-top: -24px; font: 400 32px var(--fl-display); color: var(--fl-dim); }
    .fl-reel {
      flex: 1; max-width: 340px; min-width: 0; padding: 10px 8px 12px; border-radius: 16px;
      background: linear-gradient(180deg, #0c1222, #070a14);
      border: 1px solid rgba(198, 255, 61, 0.22);
      box-shadow: inset 0 18px 24px -18px rgba(0, 0, 0, 0.9), inset 0 -18px 24px -18px rgba(0, 0, 0, 0.9);
      display: flex; flex-direction: column; align-items: center;
    }
    .fl-reel-cap { font: 600 11px Inter, sans-serif; letter-spacing: 0.3em; text-transform: uppercase; color: var(--fl-muted); }
    .fl-reel-val {
      display: block; max-width: 100%; margin-top: 4px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      font: 400 clamp(30px, 8vw, 62px)/1 var(--fl-display); letter-spacing: 0.04em;
      color: #fff; text-shadow: 0 0 18px rgba(198, 255, 61, 0.45);
    }
    .fl-reel.is-rolling .fl-reel-val { color: #9aa6c4; text-shadow: none; filter: blur(1px); }
    .fl-reel.is-landed { border-color: var(--fl-lime); box-shadow: 0 0 28px rgba(198, 255, 61, 0.3); }
    .fl-reel.is-landed .fl-reel-val { animation: fl-land 0.4s cubic-bezier(0.2, 1.6, 0.4, 1); }
