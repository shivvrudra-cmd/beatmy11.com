---
/**
 * play.astro — the BeatMy11 spin-draft game flow.
 *
 * ONE continuous drafting interface (no steps, no era chooser):
 *   SPIN → round 1 always draws the Legends era (pick your 1 Legend) →
 *   rounds 2–6 draw random era+nation combos (2 picks each) →
 *   11 players → COMPARE XIs → /matchup.
 *
 * Server-rendered: Navbar, spin zone shell, Footer, the full normalized
 * player pool embedded as a JSON blob, and the 60 valid spin combos as a
 * second blob. A hidden PlayerCard instance is rendered so that component's
 * global bm11-* styles are emitted on this page (the client script mirrors
 * PlayerCard's markup verbatim).
 *
 * Client <script type="module"> keeps ONE draft state object (see
 * src/lib/player-logic.ts — createDraft / applySpinResult / applyDraftPick /
 * applyDraftMove / applyDraftDeselect) as the single source of truth and
 * re-renders from it. Drafting is two-step: select a player in the pool,
 * then select a glowing slot in the XI panel; afterwards players can be
 * moved between any slots their roles allow. The plain normalized-player
 * array (in slot order) is persisted to `beatmy11.userXI.v1` (/matchup's
 * contract); draft extras live under `beatmy11.draft.v1`.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import PlayerCard from '@/components/PlayerCard.astro';
import PoolToolbar from '@/components/PoolToolbar.tsx';
import { playersForEra, allPlayersByEra, legendsSpinCombos, draftSpinCombos } from '@/lib/player-store';

// Full normalized pool (uid-keyed per era) for the client game. Escaped so a
// stray "</" sequence can never break out of the script element.
const playerDataJson = JSON.stringify(allPlayersByEra()).replace(/<\//g, '<\\/');
// Round 1 spins only the Legends era (pick your Legend); rounds 2–6 spin the
// remaining eras. Dead combos are excluded at build time in both pools.
const legendCombosJson = JSON.stringify(legendsSpinCombos());
const draftCombosJson = JSON.stringify(draftSpinCombos());
// Style seed: one real card so PlayerCard's global styles ship on this page.
const styleSeed = playersForEra('legends')[0];
---
<BaseLayout
  title="Play Beat My 11 — Draft Your All-Time XI"
  description="Spin to draw an era and nation, draft 11 players across six rounds, then take your XI into battle against the fixed house team."
>
  <Navbar />
  <main id="bm11-main" class="bm11-play">
    <a class="bm11-skip" href="#bm11-game">Skip to game</a>
    <p id="bm11-live" class="sr-only" role="status" aria-live="polite"></p>

    <!-- Toss panel — the era + nation draw ceremony -->
    <section class="bm11-spinzone" aria-labelledby="bm11-spin-heading">
      <div class="bm11-wrap">
        <p class="bm11-eyebrow">The draft</p>
        <h1 class="bm11-h1" id="bm11-spin-heading" tabindex="-1">Build your XI</h1>
        <div class="bm11-draw" id="bm11-draw">
          <div class="bm11-reels">
            <div class="bm11-reel bm11-reel--era">
              <span class="bm11-reel-cap">Era</span>
              <div class="bm11-reel-window">
                <span class="bm11-reel-value" id="bm11-draw-era">Fate</span>
              </div>
              <button
                type="button"
                class="bm11-reel-respin"
                id="bm11-respin-era"
                hidden
              >
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                Era
                <span class="bm11-respin-left" id="bm11-respin-era-left">1 left</span>
              </button>
            </div>
            <div class="bm11-toss" aria-hidden="true">
              <span class="bm11-toss-coin" id="bm11-toss-coin"></span>
              <span class="bm11-toss-label">toss</span>
            </div>
            <div class="bm11-reel bm11-reel--nation">
              <span class="bm11-reel-cap">Nation</span>
              <div class="bm11-reel-window">
                <span class="bm11-reel-value" id="bm11-draw-nation">awaits&hellip;</span>
              </div>
              <button
                type="button"
                class="bm11-reel-respin"
                id="bm11-respin-nation"
                hidden
              >
                <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
                Nation
                <span class="bm11-respin-left" id="bm11-respin-nation-left">1 left</span>
              </button>
            </div>
          </div>
          <button
            type="button"
            class="bm11-btn bm11-btn-primary bm11-spin-btn"
            id="bm11-spin"
            aria-label="Spin to draw a random era and nation"
          >
            Spin
          </button>
          <div
            class="bm11-round-progress"
            id="bm11-progress"
            role="img"
            aria-label="6 rounds, 11 players"
          >
            <div class="bm11-roundbar" id="bm11-roundbar" aria-hidden="true"></div>
            <p class="bm11-progress-label" id="bm11-progress-label" aria-hidden="true"></p>
          </div>
        </div>
      </div>
    </section>

    <div id="bm11-game" class="bm11-wrap" tabindex="-1">
      <!-- Persistent game bar: XI progress · current draw · round -->
      <div class="bm11-gamebar" id="bm11-gamebar">
        <div class="bm11-gamebar-xi">
          <span class="bm11-gamebar-count" id="bm11-count">0/11</span>
          <span class="bm11-gamebar-track" aria-hidden="true">
            <span class="bm11-gamebar-fill" id="bm11-progress-fill"></span>
          </span>
        </div>
        <p class="bm11-gamebar-draw" id="bm11-gamebar-draw">
          <span class="bm11-gamebar-draw-idle">Spin to begin</span>
        </p>
        <p class="bm11-gamebar-round" id="bm11-gamebar-round">Round 1 of 6</p>
      </div>

      <div class="bm11-draft-layout">
        <div class="bm11-stage">
          <!-- Your XI, on the field -->
          <section class="bm11-field-section" aria-labelledby="bm11-field-heading">
            <div class="bm11-field-head">
              <h2 class="bm11-h2" id="bm11-field-heading" tabindex="-1">Your XI</h2>
              <p class="bm11-comp" id="bm11-comp" aria-live="polite"></p>
            </div>
            <div class="bm11-field" id="bm11-field">
              <div class="bm11-ground" aria-hidden="true">
                <span class="bm11-ground-ring"></span>
                <span class="bm11-pitch">
                  <span class="bm11-crease bm11-crease--top"></span>
                  <span class="bm11-crease bm11-crease--bottom"></span>
                </span>
              </div>
              <div class="bm11-fslots" id="bm11-fslots"></div>
            </div>
            <p class="bm11-summary-msg" id="bm11-msg" role="status"></p>
            <div class="bm11-field-actions">
              <button
                type="button"
                class="bm11-btn bm11-btn-ghost bm11-btn-sm"
                id="bm11-startover"
                hidden
              >
                Start over
              </button>
              <a href="/matchup" class="bm11-btn bm11-btn-primary bm11-cta is-disabled" id="bm11-cta" aria-disabled="true">
                Compare XIs
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          </section>

          <!-- Spin history -->
          <section class="bm11-history" aria-labelledby="bm11-history-heading">
            <h2 class="bm11-h2" id="bm11-history-heading">Spin history</h2>
            <ol class="bm11-history-list" id="bm11-history">
              <li class="bm11-history-empty">No spins yet — your draws will be listed here.</li>
            </ol>
          </section>
        </div>

        <!-- Player drawer: bottom sheet on mobile, side panel on desktop -->
        <aside class="bm11-drawer" id="bm11-summary" aria-label="Player drawer">
          <div class="bm11-drawer-head">
            <div class="bm11-drawer-titles">
              <h2 class="bm11-drawer-title" id="bm11-sheet-title">Your draw</h2>
              <p class="bm11-drawer-draw" id="bm11-sheet-draw"></p>
            </div>
            <button
              type="button"
              class="bm11-drawer-toggle"
              id="bm11-toggle"
              aria-expanded="false"
              aria-controls="bm11-summary-body"
            >
              <span class="sr-only">Toggle drawer</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m18 15-6-6-6 6" />
              </svg>
            </button>
          </div>
          <!-- The pop grows upward as an overlay (mobile): the header is the
               drawer's only in-flow child, so it never moves and opening the
               sheet can't cause layout shift. -->
          <div class="bm11-drawer-pop">
          <!-- Mobile only: respin tokens ride directly above the drawer
               and travel with it as it opens/closes. -->
          <div class="bm11-sheet-respins" id="bm11-sheet-respins" hidden>
            <button
              type="button"
              class="bm11-reel-respin bm11-sheet-respin--era"
              id="bm11-respin-era-sheet"
              hidden
            >
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
              Era
              <span class="bm11-respin-left" id="bm11-respin-era-sheet-left">1 left</span>
            </button>
            <button
              type="button"
              class="bm11-reel-respin bm11-sheet-respin--nation"
              id="bm11-respin-nation-sheet"
              hidden
            >
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
              Nation
              <span class="bm11-respin-left" id="bm11-respin-nation-sheet-left">1 left</span>
            </button>
          </div>
          <div class="bm11-drawer-body" id="bm11-summary-body">
            <PoolToolbar client:load />
            <h3 class="sr-only" id="bm11-pool-heading">Your draw</h3>
            <p class="bm11-lede" id="bm11-pool-lede">
              Your drawn players will appear here after your first spin.
            </p>
            <div id="bm11-groups"></div>
          </div>
          </div><!-- /.bm11-drawer-pop -->
        </aside>
      </div>
    </div>

    <div hidden aria-hidden="true">
      <PlayerCard player={styleSeed} />
    </div>

    <script type="application/json" id="bm11-player-data" set:html={playerDataJson}></script>
    <script type="application/json" id="bm11-legend-combos" set:html={legendCombosJson}></script>
    <script type="application/json" id="bm11-draft-combos" set:html={draftCombosJson}></script>
  </main>


  <!-- Role chooser: shown only when a tapped player/slot has more than one
       legal declaration (e.g. Sangakkara as batter or keeper). -->
  <div id="bm11-role-chooser" class="bm11-chooser" hidden>
    <div class="bm11-chooser-backdrop" data-bm11-chooser-cancel></div>
    <div
      class="bm11-chooser-card"
      role="dialog"
      aria-modal="true"
      aria-labelledby="bm11-chooser-title"
    >
      <h3 class="bm11-chooser-title" id="bm11-chooser-title"></h3>
      <p class="bm11-chooser-sub" id="bm11-chooser-sub"></p>
      <div class="bm11-chooser-options" id="bm11-chooser-options"></div>
      <button
        type="button"
        class="bm11-chooser-cancel"
        data-bm11-chooser-cancel
      >
        Cancel
      </button>
    </div>
  </div>

  <Footer />

  <script>
    import { animate } from 'motion';
    import {
      createDraft,
      selectionLimitForRound,
      isRoundComplete,
      canSpin,
      validatePoolPick,
      validateSlotPlacement,
      validateSlotMove,
      moveDeclaration,
      placementOptions,
      applySpinResult,
      applyDraftPick,
      applyDraftMove,
      applyDraftDeselect,
      canRespinNation,
      canRespinEra,
      applyNationRespin,
      applyEraRespin,
      declarationForSlot,
      deserializeDraft,
      saveDraft,
      loadDraft,
      clearDraft,
      saveUserXI,
      clearUserXI,
      playerGroups,
      slotByKey,
      orderedXI,
      countsOf,
      reachableShapes,
      isXIValid,
      supplyFor,
      XI_SIZE,
      DRAFT_ROUNDS,
      XI_ROLE_LABELS,
      XI_SLOTS,
      XI_SLOT_GROUP_LABELS,
      POOL_GROUPS,
    } from '../lib/player-logic';

    // ------------------------------------------------------------------ data
    const byEra = JSON.parse(
      document.getElementById('bm11-player-data').textContent || '{}'
    );
    const LEGEND_COMBOS = JSON.parse(
      document.getElementById('bm11-legend-combos').textContent || '[]'
    );
    const DRAFT_COMBOS = JSON.parse(
      document.getElementById('bm11-draft-combos').textContent || '[]'
    );
    // Round 1 (draft.currentRound === 0) always spins the Legends era — the
    // user picks their one Legend first; rounds 2–6 spin the other eras.
    // A spin can never re-land on an era×nation combo already drawn in this
    // draft: a repeat would shrink the user's options (picked players are
    // removed from the pool). And a nation can land at most twice per draft,
    // so no single pool dominates the six rounds.
    const usedComboKeys = () =>
      new Set(draft.spinHistory.map((s) => `${s.era}|${s.nation}`));
    const nationCounts = () => {
      const counts = {};
      for (const s of draft.spinHistory)
        counts[s.nation] = (counts[s.nation] || 0) + 1;
      return counts;
    };
    const combosForUpcomingRound = () => {
      const base = draft.currentRound === 0 ? LEGEND_COMBOS : DRAFT_COMBOS;
      const used = usedComboKeys();
      const counts = nationCounts();
      const fresh = base.filter(
        (c) =>
          !used.has(`${c.era}|${c.nation}`) && (counts[c.nation] || 0) < 2,
      );
      if (fresh.length > 0) return fresh;
      // Defensive: relax the nation cap first, then the pair rule — with
      // dozens of combos and at most 5 prior spins the pool can never run
      // dry, but never let the spin dead-end if it does.
      const pairFresh = base.filter((c) => !used.has(`${c.era}|${c.nation}`));
      return pairFresh.length > 0 ? pairFresh : base;
    };
    // Respin redraws: the rejected pair is excluded (no going back) and the
    // no-repeat rule still holds. A nation respin keeps the era; an era respin
    // keeps the nation but never lands on Legends — round 1 owns that era.
    // The nation cap applies to respins too (an era respin needs no check:
    // it keeps the current nation, so the counts don't change).
    const nationRedrawOptions = () => {
      if (!draft.currentEra) return [];
      const base = draft.currentRound === 1 ? LEGEND_COMBOS : DRAFT_COMBOS;
      const used = usedComboKeys();
      const counts = nationCounts();
      return base.filter(
        (c) =>
          c.era === draft.currentEra &&
          c.nation !== draft.currentNation &&
          !used.has(`${c.era}|${c.nation}`) &&
          (counts[c.nation] || 0) < 2,
      );
    };
    const eraRedrawOptions = () => {
      if (!draft.currentNation) return [];
      const used = usedComboKeys();
      return DRAFT_COMBOS.filter(
        (c) =>
          c.nation === draft.currentNation &&
          c.era !== draft.currentEra &&
          !used.has(`${c.era}|${c.nation}`),
      );
    };
    const uidIndex = {};
    for (const eraId of Object.keys(byEra)) {
      for (const p of byEra[eraId]) uidIndex[p.uid] = p;
    }

    // ------------------------------------------------- presentation mirrors
    // These mirror PlayerCard.astro / PlayerAvatar.astro so client-rendered
    // cards pick up the component's global styles verbatim. (A hidden
    // PlayerCard instance is rendered above so those styles are emitted.)
    const ERA_ACCENTS = {
      legends: '#C9A227',
      '1970s': '#C26936',
      '1980s': '#D64045',
      '1990s': '#2AA198',
      '2000s': '#3B82F6',
      '2010s': '#8B5CF6',
      '2020s': '#2DD4BF',
    };
    // Short nation codes — mirrors PlayerCard.astro (results pages).
    const NATION_CODES = {
      Australia: 'AUS',
      England: 'EG',
      India: 'IND',
      Pakistan: 'PAK',
      'West Indies': 'WI',
      'New Zealand': 'NZ',
      'South Africa': 'SA',
      'Sri Lanka': 'SL',
      Bangladesh: 'BAN',
      Zimbabwe: 'ZIM',
    };
    const ROLE_LABELS = {
      opener: 'Opener',
      'middle-order': 'Middle Order',
      wicketkeeper: 'Wicketkeeper',
      'all-rounder': 'All-Rounder',
      'fast-bowler': 'Fast Bowler',
      spinner: 'Spinner',
    };
    // Your-XI slot groups, in batting-to-bowling order, derived from the
    // shared XI_SLOTS model so labels and keys can't drift: 2 fixed
    // openers, batting spots 3–6 (middle order / wicketkeeper), spots 7–8
    // (all-rounder / spinner), then the 3 fast bowlers. Eleven fixed slots,
    // always rendered, even before the first pick.
    const SLOT_GROUPS = ['openers', 'batting', 'flex', 'fast'].map((g) => ({
      key: g,
      label: XI_SLOT_GROUP_LABELS[g],
      keys: XI_SLOTS.filter((s) => s.group === g).map((s) => s.key),
    }));
    // Field positions: slot key -> spot on the cricket ground, as
    // percentages of the field box. Display only — the XI_SLOTS model
    // (groups, roles, rules) is untouched. Openers at the crease, the
    // keeper behind the stumps, batters in the inner ring, the flex pair
    // mid-field, the pace attack on the boundary.
    const FIELD_POSITIONS = {
      'opener-1': { x: 50, y: 68 },
      'opener-2': { x: 50, y: 28 },
      'bat-3': { x: 28, y: 78 },
      'bat-4': { x: 15, y: 57 },
      'bat-5': { x: 82, y: 72 },
      'bat-6': { x: 50, y: 88 },
      'flex-7': { x: 86, y: 35 },
      'flex-8': { x: 70, y: 55 },
      'fast-1': { x: 15, y: 35 },
      'fast-2': { x: 30, y: 15 },
      'fast-3': { x: 70, y: 15 },
    };
    // Friendly default names inside the flexible slot cards: the keeper's
    // home (bat-6) and the all-rounder/spinner pair (flex-7/8). The
    // reachable-shape narrowing in slotButtonHTML can still override these
    // for the flex pair; bat-6 is keeper-only so its label never changes.
    const SLOT_LABEL_OVERRIDES = {
      'bat-6': 'Wicketkeeper',
      'flex-7': 'All-rounder/Spinner',
      'flex-8': 'All-rounder/Spinner',
    };
    const ERA_NAMES = {
      legends: 'Legends',
      '1970s': '1970s',
      '1980s': '1980s',
      '1990s': '1990s',
      '2000s': '2000s',
      '2010s': '2010s',
      '2020s': '2020s',
    };
    const eraName = (id) => ERA_NAMES[id] || id;

    const esc = (v) =>
      String(v ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    // Lucide icon paths (ISC-licensed), inlined for the vanilla client
    // script: 24x24, stroke-based, matching lucide-react's artwork.
    const ICONS = {
      plus: '<path d="M5 12h14"/><path d="M12 5v14"/>',
      check: '<path d="M20 6 9 17l-5-5"/>',
      search: '<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>',
      x: '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
      chevron: '<path d="m6 9 6 6 6-6"/>',
      respin:
        '<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/>',
      sparkles:
        '<path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3Z"/>',
      arrow: '<path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>',
    };
    const icon = (name, size = 16) =>
      `<svg viewBox="0 0 24 24" width="${size}" height="${size}" fill="none" ` +
      `stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" ` +
      `aria-hidden="true">${ICONS[name] || ''}</svg>`;
    // Pool-sheet averages show one decimal (55.1, not 55.10).

    const fmtAvg = (v) =>
      v == null || Number.isNaN(Number(v)) ? '–' : Number(v).toFixed(1);
    const fmtInt = (v) =>
      v == null || Number.isNaN(Number(v)) ? '–' : Math.round(Number(v)).toLocaleString('en-US');
    // Compact card initials for the mobile field-view XI (e.g. "Steve Waugh" -> "SW").
    const initials = (name) =>
      String(name || '')
        .split(/\s+/)
        .filter(Boolean)
        .map((w) => w[0])
        .slice(0, 2)
        .join('')
        .toUpperCase();

    // Inline SVG medallion — same artwork as PlayerAvatar.astro (data URI).
    function avatarSrc(era) {
      const accent = ERA_ACCENTS[era] || '#a5a8c9';
      const figure = '#DDE6F2';
      const svg =
        `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">` +
        `<defs><radialGradient id="bm11av" cx="35%" cy="28%" r="85%">` +
        `<stop offset="0%" stop-color="${accent}" stop-opacity="0.38"/>` +
        `<stop offset="100%" stop-color="#12122b" stop-opacity="1"/>` +
        `</radialGradient></defs>` +
        `<circle cx="32" cy="32" r="30.5" fill="url(#bm11av)" stroke="${accent}" stroke-opacity="0.55" stroke-width="1.6"/>` +
        `<ellipse cx="30" cy="55" rx="13" ry="2.4" fill="#000000" opacity="0.35"/>` +
        `<circle cx="33" cy="12.5" r="6.4" fill="${figure}"/>` +
        `<g stroke="${figure}" stroke-linecap="round" fill="none">` +
        `<path d="M33 21 C31.5 27 30.5 32 30 38" stroke-width="9"/>` +
        `<path d="M31 27 L21 34" stroke-width="6.5"/>` +
        `<path d="M20 35 L8.5 16.5" stroke-width="6"/>` +
        `<path d="M30 38 L23 53" stroke-width="7.5"/>` +
        `<path d="M30 38 L39 52" stroke-width="7.5"/>` +
        `</g></svg>`;
      return 'data:image/svg+xml,' + encodeURIComponent(svg);
    }

    // 3 key ministats per card — same logic as PlayerCard.astro.
    // Stat columns for a pool row, in the 82-0.com style: label on top,
    // value below. Tailored to the player's display group:
    // batters → M / Runs / Avg / 50s / 100s; all-rounders → M / Runs /
    // Wkts / Bat Avg / Bowl Avg; bowlers → M / Wkts / Bowl Avg / 5W / 10W.
    // Two hero stats per card — 82-0.com style (label over value), trimmed
    // from five columns to keep the drawer scannable: batters → Avg / 100s;
    // all-rounders → Bat Avg / Wkts; bowlers → Wkts / Bowl Avg.
    function poolStatCells(p, kind) {
      const s = p.stats || {};
      const bowlAvg = s.testBowlingAverage ?? s.bowlingAverage;
      const cell = (v, l) =>
        `<span class="bm11-prow-stat"><i>${esc(l)}</i><b>${esc(v)}</b></span>`;
      if (kind === 'ar') {
        return (
          cell(fmtAvg(s.testAverage), 'Bat Avg') +
          cell(fmtInt(s.testWickets), 'Wkts') +
          cell(fmtAvg(bowlAvg), 'Bowl Avg')
        );
      }
      if (kind === 'bowl') {
        return (
          cell(fmtInt(s.testWickets), 'Wkts') +
          cell(fmtAvg(bowlAvg), 'Bowl Avg') +
          cell(fmtInt(s.fiveWs), '5Ws')
        );
      }
      // Batting groups: keepers get dismissals, the defining keeper stat.
      if (p.primaryRole === 'wicketkeeper') {
        return (
          cell(fmtAvg(s.testAverage), 'Avg') +
          cell(fmtInt(s.dismissals), 'Dis') +
          cell(fmtInt(s.testCenturies), '100s')
        );
      }
      return (
        cell(fmtAvg(s.testAverage), 'Avg') +
        cell(fmtInt(s.testCenturies), '100s') +
        cell(fmtInt(s.testFifties), '50s')
      );
    }
    function accessibleName(p) {
      const roles = [
        p.primaryRole,
        ...(p.secondaryRoles || []).filter((r) => r !== p.primaryRole),
      ]
        .filter(Boolean)
        .map((r) => ROLE_LABELS[r] || r);
      return `${p.name}, ${roles.join(', ') || 'player'}, ${p.nation || ''}`;
    }

    // Pool player row: 82-0.com style — avatar + name on the left, five
    // stat columns on the right. The row shows the era of the current draw,
    // not the player's first-listed era (multi-era players like Shaun
    // Pollock are shown under the era the spin landed on), plus every group
    // the data marks the player eligible for (e.g. "Middle Order,
    // Wicketkeeper").
    // Pool player card: era-accented initials medallion, name + nation +
    // role, two hero stats, and a plus/check affordance. Selection state
    // (is-selected / is-disabled / is-locked + the check badge) is owned by
    // updateCardStates — this just renders the card.
    function cardHTML(p, kind) {
      const drawEra = draft.currentEra || p.displayEra;
      const accent = ERA_ACCENTS[drawEra] || '#a5a8c9';
      const nationCode = NATION_CODES[p.nation] || p.nation || '';
      const roleLabel = ROLE_LABELS[p.primaryRole] || p.primaryRole || '';
      return (
        `<button type="button" class="bm11-prow" data-bm11-select="${esc(p.uid)}"` +
        ` aria-pressed="false" aria-label="${esc(accessibleName(p))}" style="--era-accent:${accent};">` +
        `<span class="bm11-prow-main">` +
        `<span class="bm11-prow-name">${esc(p.name)}</span>` +
        `<span class="bm11-prow-meta">` +
        `<span class="bm11-nation-code">${esc(nationCode)}</span>` +
        `<span class="bm11-prow-role">${esc(roleLabel)}</span>` +
        `</span></span>` +
        `<span class="bm11-prow-stats">${poolStatCells(p, kind)}</span>` +
        `<span class="bm11-prow-cta" aria-hidden="true">${icon('plus', 16)}</span>` +
        `<span class="bm11-check-badge" aria-hidden="true" hidden>${icon('check', 11)}</span>` +
        `</button>`
      );
    }
    // ------------------------------------------------------------------ state
    // ONE draft object = the single source of truth. Every mutation goes
    // through the pure transitions in player-logic.ts, then persist() +
    // renderAll(). Two extra pieces of UI-only state drive the two-step
    // flow: `selectedUid` (the pool player waiting for a slot) and
    // `moveFrom` (the slot whose occupant is being repositioned). The
    // tapped slot decides a multi-role player's declaration — no separate
    // role choice. None is persisted — they reset on reload and round
    // changes.
    let draft = createDraft();
    let selectedUid = null;
    let moveFrom = null;
    let chooserState = null; // { uid, slotKey, supply } while the role chooser is open
    let msgTimer = 0;
    // Slots filled since the last render — drives the Motion pop when a
    // player lands on the field.
    let prevFilled = new Set();
    const reduceMotion = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const $ = (id) => document.getElementById(id);
    const liveEl = $('bm11-live');
    const spinBtn = $('bm11-spin');
    const progressEl = $('bm11-progress');
    const roundBarEl = $('bm11-roundbar');
    const progressLabelEl = $('bm11-progress-label');
    const eraSlot = $('bm11-draw-era');
    const nationSlot = $('bm11-draw-nation');
    const respinNationBtn = $('bm11-respin-nation');
    const respinEraBtn = $('bm11-respin-era');
    const respinNationLeft = $('bm11-respin-nation-left');
    const respinEraLeft = $('bm11-respin-era-left');
    // Mobile twins: the same tokens rendered above the draw sheet.
    const respinBar = $('bm11-sheet-respins');
    const respinNationSheetBtn = $('bm11-respin-nation-sheet');
    const respinEraSheetBtn = $('bm11-respin-era-sheet');
    const respinNationSheetLeft = $('bm11-respin-nation-sheet-left');
    const respinEraSheetLeft = $('bm11-respin-era-sheet-left');
    // Sync one token's reel button + sheet button together.
    function syncRespinBtn(btn, sheetBtn, leftEl, sheetLeftEl, show, leftText, label) {
      btn.hidden = !show;
      sheetBtn.hidden = !show;
      if (show) {
        leftEl.textContent = leftText;
        sheetLeftEl.textContent = leftText;
        btn.setAttribute('aria-label', label);
        sheetBtn.setAttribute('aria-label', label);
      }
    }
    const groupsEl = $('bm11-groups');
    const historyEl = $('bm11-history');
    const summaryEl = $('bm11-summary');
    const msgEl = $('bm11-msg');
    const ctaEl = $('bm11-cta');

    // Mobile (<1024px) swaps the panels: the fixed bottom sheet hosts the
    // drawn pool, and Your XI lives as a static section in the page flow.
    // Desktop keeps the pool in the main column and the XI sticky sidebar.
    const mqMobile = window.matchMedia('(max-width: 1023.98px)');

    // The drawer is a fixed bottom sheet on mobile and a sticky side panel
    // on desktop; the field lives in the page flow on both. Nothing moves
    // between breakpoints anymore, so this just keeps the sheet closed on
    // desktop.
    function layoutPanels() {
      if (!mqMobile.matches) setSheetOpen(false);
    }
    function setSheetOpen(open) {
      summaryEl.classList.toggle('is-open', open);
      $('bm11-toggle').setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    // Pop the draw sheet up (mobile only). Returns whether it did anything,
    // so callers can fall back to a page scroll on desktop.
    function revealDrawSheet() {
      if (!mqMobile.matches) return false;
      setSheetOpen(true);
      $('bm11-summary-body').scrollTop = 0;
      return true;
    }

    // Spin/respin landing: let the landed era + nation breathe in the spin
    // zone before the sheet takes over — the landing should read as an
    // event, not a flash. Skips the beat when already open (e.g. the user
    // beat the timer to the toggle) and under reduced motion.
    function revealDrawSheetAfterLanding() {
      if (!mqMobile.matches) return;
      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;
      window.setTimeout(() => {
        if (!summaryEl.classList.contains('is-open')) revealDrawSheet();
      }, reduceMotion ? 0 : 1200);
    }

    const announce = (text) => {
      liveEl.textContent = '';
      requestAnimationFrame(() => {
        liveEl.textContent = text;
      });
    };
    const flashMsg = (text) => {
      msgEl.textContent = text || '';
      window.clearTimeout(msgTimer);
      if (text) msgTimer = window.setTimeout(() => { msgEl.textContent = ''; }, 4500);
    };
    const persist = () => {
      // /matchup's contract: a plain array of 11 players. Saved in slot
      // (batting) order so the XI reads top-to-bottom naturally.
      saveUserXI(orderedXI(draft));
      saveDraft(draft);
    };

    /** "Middle Order, Wicketkeeper" — every group the data marks a player eligible for. */
    const groupLabelList = (p) =>
      playerGroups(p)
        .map((g) => ROLE_LABELS[g] || XI_ROLE_LABELS[g] || g)
        .join(', ');

    // ------------------------------------------------------------ pool logic
    // Eligible pool for the current draw: era id ∈ player.era (string or
    // array) AND nation matches, deduped by raw id across era files.
    function currentPool() {
      if (!draft.currentEra || !draft.currentNation) return [];
      const out = [];
      const seen = new Set();
      for (const fileEra of Object.keys(byEra)) {
        for (const p of byEra[fileEra]) {
          const eras = Array.isArray(p.era) ? p.era : [p.era];
          if (!eras.includes(draft.currentEra) || p.nation !== draft.currentNation) continue;
          if (seen.has(p.id)) continue;
          seen.add(p.id);
          out.push(p);
        }
      }
      return out;
    }

    // Supply context for the hard block: the current draw's pool plus how
    // many picks later rounds still owe, so a pick that strands a needed
    // role (e.g. the keeper) with nobody left in this draw is refused.
    const draftSupply = () => supplyFor(draft, currentPool());

    function unpickedCount(pool) {
      const ids = new Set(draft.selectedPlayers.map((p) => p.id));
      let n = 0;
      for (const p of pool) if (!ids.has(p.id)) n += 1;
      return n;
    }

    const roundDone = () => isRoundComplete(draft, unpickedCount(currentPool()));
    // UI-only pool filtering (drawer search + role chips). Never touches
    // eligibility, the draft model, or persistence.
    let poolUI = { q: '', role: 'All' };
    window.addEventListener('bm11:pool-filter', (e) => {
      const d = (e && e.detail) || {};
      poolUI = { q: String(d.q || ''), role: String(d.role || 'All') };
      renderPool();
    });
    function resetPoolFilter() {
      poolUI = { q: '', role: 'All' };
      window.dispatchEvent(new CustomEvent('bm11:pool-filter-reset'));
    }


    // ------------------------------------------------------------------ spin
    function previewDraw(era, nation) {
      eraSlot.textContent = eraName(era);
      nationSlot.textContent = nation;
      const accent = ERA_ACCENTS[era] || '#a5a8c9';
      const win = eraSlot.closest('.bm11-reel-window');
      if (win) win.style.setProperty('--era-accent', accent);
    }

    // Visual progress: a 6-segment round bar (dim = upcoming, gold pulse =
    // current, green = done) with a text label for the round and XI count.
    // Screen readers get the same info from the container's aria-label.
    function renderProgress(done) {
      roundBarEl.innerHTML = '';
      for (let i = 1; i <= DRAFT_ROUNDS; i += 1) {
        const seg = document.createElement('span');
        seg.className = 'bm11-roundbar-seg';
        const isDone = i < draft.currentRound || (i === draft.currentRound && done);
        const isCurrent =
          i === draft.currentRound && !done && draft.currentRound >= 1;
        if (isDone) seg.classList.add('is-done');
        if (isCurrent) seg.classList.add('is-current');
        roundBarEl.appendChild(seg);
      }
      const placed = draft.selectedPlayers.length;
      const roundText =
        draft.currentRound === 0
          ? `Round 1 of ${DRAFT_ROUNDS}`
          : `Round ${draft.currentRound} of ${DRAFT_ROUNDS}`;
      progressLabelEl.textContent = `${roundText} · ${placed} of ${XI_SIZE} picked`;
      progressEl.setAttribute(
        'aria-label',
        draft.currentRound === 0
          ? `${DRAFT_ROUNDS} rounds, ${XI_SIZE} players`
          : `Round ${draft.currentRound} of ${DRAFT_ROUNDS}, ${placed} of ${XI_SIZE} players placed`
      );
    }

    function renderSpinZone() {
      if (draft.currentEra && draft.currentNation) {
        previewDraw(draft.currentEra, draft.currentNation);
      } else {
        eraSlot.textContent = 'Fate';
        nationSlot.textContent = 'awaits…';
      }

      const done = roundDone();
      let btnLabel = 'Spin';
      let btnEnabled = false;

      if (draft.gameComplete) {
        btnLabel = 'Spin';
        btnEnabled = false;
      } else if (draft.isSpinning) {
        btnLabel = 'Spinning…';
        btnEnabled = false;
      } else if (draft.currentRound === 0) {
        btnLabel = 'Spin';
        btnEnabled = true;
      } else if (draft.currentRound >= DRAFT_ROUNDS && done && !draft.gameComplete) {
        // Defensive: a tiny pool left the draft short of 11 players.
        btnLabel = 'Spin';
        btnEnabled = false;
      } else if (done) {
        btnLabel = 'Spin again';
        btnEnabled = true;
      } else {
        btnLabel = 'Spin';
        btnEnabled = false;
      }

      renderProgress(done);
      spinBtn.innerHTML =
        icon('sparkles', 18) + '<span>' + esc(btnLabel) + '</span>';
      spinBtn.disabled = !btnEnabled;
      spinBtn.hidden = draft.gameComplete;
      spinBtn.setAttribute(
        'aria-label',
        btnLabel === 'Spin again'
          ? 'Spin again to draw the next era and nation'
          : draft.currentRound === 0
            ? 'Spin to draw your Legend — a random nation from the Legends era'
            : 'Spin to draw a random era and nation'
      );

      // Respin tokens: each button sits directly under its own reel on
      // desktop and rides above the draw sheet on mobile. Both appear only
      // while that token can actually be used — after a draw lands and
      // before any pick is made from it.
      const nationOpts = nationRedrawOptions();
      const eraOpts = eraRedrawOptions();
      const base =
        !draft.gameComplete &&
        !draft.isSpinning &&
        draft.currentRound >= 1 &&
        draft.picksThisRound.length === 0;
      const showNation = base && canRespinNation(draft, nationOpts.length);
      const showEra = base && canRespinEra(draft, eraOpts.length);
      syncRespinBtn(
        respinNationBtn,
        respinNationSheetBtn,
        respinNationLeft,
        respinNationSheetLeft,
        showNation,
        `${draft.nationRespinsLeft} left`,
        `Forced redraw: replace ${draft.currentNation} with a random nation from ${eraName(draft.currentEra)}. No going back.`
      );
      syncRespinBtn(
        respinEraBtn,
        respinEraSheetBtn,
        respinEraLeft,
        respinEraSheetLeft,
        showEra,
        `${draft.eraRespinsLeft} left`,
        `Forced redraw: replace ${eraName(draft.currentEra)} with a random era for ${draft.currentNation}. No going back.`
      );
      respinBar.hidden = !(showNation || showEra);
    }

    spinBtn.addEventListener('click', () => {
      if (draft.isSpinning) return; // double-spin guard
      if (!canSpin(draft, unpickedCount(currentPool()))) return;
      draft = { ...draft, isSpinning: true };
      document.getElementById('bm11-toss-coin')?.classList.add('is-flipping');
      renderSpinZone();

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const pool = combosForUpcomingRound();
      const draw = () =>
        pool.length
          ? pool[Math.floor(Math.random() * pool.length)]
          : null;

      if (reduceMotion || pool.length === 0) {
        settleSpin(draw());
        return;
      }
      let ticks = 0;
      const timer = window.setInterval(() => {
        const c = draw();
        if (c) previewDraw(c.era, c.nation);
        if (++ticks >= 9) {
          window.clearInterval(timer);
          settleSpin(draw());
        }
      }, 70);
    });

    function settleSpin(combo) {
      document.getElementById('bm11-toss-coin')?.classList.remove('is-flipping');
      if (!combo) {
        draft = { ...draft, isSpinning: false };
        renderSpinZone();
        return;
      }
      draft = applySpinResult(draft, combo.era, combo.nation);
      persist();
      resetPoolFilter();
      renderAll();
      // Mobile: the draw sheet pops up with the fresh pool — but only after
      // the landing has had its moment in the spin zone. Desktop: the pool
      // sits in the main column, so bring it into view instead.
      const poolHeading = document.getElementById('bm11-pool-heading');
      if (mqMobile.matches) {
        revealDrawSheetAfterLanding();
      } else if (poolHeading) {
        const reduceMotion = window.matchMedia(
          '(prefers-reduced-motion: reduce)'
        ).matches;
        poolHeading.scrollIntoView({
          behavior: reduceMotion ? 'auto' : 'smooth',
          block: 'start',
        });
      }
      const available = unpickedCount(currentPool());
      const pickWord =
        draft.currentRound === 1
          ? 'Select your Legend — 1 player.'
          : `Select ${selectionLimitForRound(draft.currentRound)}.`;
      announce(
        `Round ${draft.currentRound} of ${DRAFT_ROUNDS}. Your draw: ${eraName(combo.era)}, ${combo.nation}. ` +
          `${available} players available. ${pickWord}`
      );
    }

    // ------------------------------------------------------------ respins
    // One era respin + one nation respin per draft, forced redraw: the new
    // draw replaces the old one and there is no going back.
    function runRespin(kind) {
      if (draft.isSpinning) return; // double-spin guard
      const opts =
        kind === 'nation' ? nationRedrawOptions() : eraRedrawOptions();
      const allowed =
        kind === 'nation'
          ? canRespinNation(draft, opts.length)
          : canRespinEra(draft, opts.length);
      if (!allowed || opts.length === 0) return;
      draft = { ...draft, isSpinning: true };
      document.getElementById('bm11-toss-coin')?.classList.add('is-flipping');
      renderAll();

      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;
      const draw = () => opts[Math.floor(Math.random() * opts.length)];
      const settle = (choice) => {
        // Clear the spinning flag first: apply*Respin re-validates, and a
        // spinning draft is never respinnable.
        draft = { ...draft, isSpinning: false };
        const before = kind === 'nation' ? draft.currentNation : draft.currentEra;
        draft =
          kind === 'nation'
            ? applyNationRespin(draft, choice.nation)
            : applyEraRespin(draft, choice.era);
        persist();
        renderAll();
        // A respun draw is a fresh draw — same landing beat, then the sheet.
        revealDrawSheetAfterLanding();
        const after = kind === 'nation' ? draft.currentNation : draft.currentEra;
        if (after !== before) {
          announce(
            `Forced redraw — your ${kind} respin landed on ${eraName(draft.currentEra)}, ${draft.currentNation}. ` +
              `The old draw is gone. ${unpickedCount(currentPool())} players available.`
          );
        } else {
          announce('Respin unavailable — the draft state changed.');
        }
      };

      if (reduceMotion || opts.length === 0) {
        settle(draw());
        return;
      }
      let ticks = 0;
      const timer = window.setInterval(() => {
        const c = draw();
        if (c) previewDraw(c.era, c.nation);
        if (++ticks >= 9) {
          window.clearInterval(timer);
          settle(draw());
        }
      }, 70);
    }

    respinNationBtn.addEventListener('click', () => runRespin('nation'));
    respinEraBtn.addEventListener('click', () => runRespin('era'));
    respinNationSheetBtn.addEventListener('click', () => runRespin('nation'));
    respinEraSheetBtn.addEventListener('click', () => runRespin('era'));

    // Full draft reset. The button lives only in dead-end states (a stalled
    // draft that can never reach 11, or a complete-but-invalid XI) and on
    // the results page — never during a live draft.
    function startOver() {
      draft = createDraft();
      selectedUid = null;
      moveFrom = null;
      clearUserXI();
      clearDraft();
      resetPoolFilter();
      flashMsg('');
      renderAll();
      announce('Draft reset. Spin to begin a new draft.');
      window.scrollTo({ top: 0, behavior: 'auto' });
      spinBtn.focus({ preventScroll: true });
    }
    $('bm11-startover').addEventListener('click', startOver);

    // ------------------------------------------------------------ player grid
    const cardEls = new Map();

    function groupHTML(g) {
      return (
        `<section class="bm11-role-group" aria-label="${esc(g.label)}">` +
        `<h3 class="bm11-role-title">${esc(g.label)} <span class="bm11-role-count">${g.players.length}</span></h3>` +
        `<div class="bm11-prow-list">${g.players.map((p) => cardHTML(p, g.kind)).join('')}</div>` +
        `</section>`
      );
    }

    function renderPool() {
      const heading = $('bm11-pool-heading');
      const lede = $('bm11-pool-lede');
      if (!draft.currentEra || !draft.currentNation) {
        heading.textContent = 'Your draw';
        lede.textContent = 'Your drawn players will appear here after your first spin.';
        $('bm11-sheet-draw').textContent = '';
        groupsEl.innerHTML =
          '<p class="bm11-pool-idle">Hit <strong>Spin</strong> above to draw your first era + nation.</p>';
        cardEls.clear();
        return;
      }
      const pool = currentPool();
      heading.textContent = `Your draw — ${eraName(draft.currentEra)} · ${draft.currentNation}`;
      const limit = selectionLimitForRound(draft.currentRound);
      const picked = draft.picksThisRound.length;
      lede.textContent =
        `${unpickedCount(pool)} players available · ` +
        `pick ${limit - picked} more this round — select a player, then choose their slot in your XI`;
      // Mobile draw-sheet header mirrors the draw.
      $('bm11-sheet-draw').textContent = `${eraName(draft.currentEra)} · ${draft.currentNation}`;

      if (pool.length === 0) {
        // Defensive: cannot happen — spins only draw combos with players.
        groupsEl.innerHTML =
          '<p class="bm11-pool-idle">No players in this draw — spin again.</p>';
        cardEls.clear();
        return;
      }

      const groups = POOL_GROUPS.map((g) => ({
        ...g,
        players: pool.filter((p) => g.roles.includes(p.primaryRole)),
      })).filter((g) => g.players.length > 0);
      const others = pool.filter(
        (p) => !POOL_GROUPS.some((g) => g.roles.includes(p.primaryRole))
      );
      if (others.length) groups.push({ label: 'Squad', kind: 'bat', players: others });

      // UI-only filtering: search query + role chip from the drawer
      // toolbar. The underlying pool and eligibility are untouched.
      const fq = poolUI.q.trim().toLowerCase();
      let view = groups;
      if (poolUI.role !== 'All') view = view.filter((g) => g.label === poolUI.role);
      if (fq) {
        view = view
          .map((g) => ({
            ...g,
            players: g.players.filter((p) => p.name.toLowerCase().includes(fq)),
          }))
          .filter((g) => g.players.length > 0);
      }
      if (view.length === 0) {
        groupsEl.innerHTML =
          '<p class="bm11-pool-empty">No players match — try a different search or role filter.</p>';
        cardEls.clear();
        return;
      }

      groupsEl.innerHTML = view.map((g) => groupHTML(g)).join('');
      cardEls.clear();
      for (const btn of groupsEl.querySelectorAll('[data-bm11-select]')) {
        cardEls.set(btn.getAttribute('data-bm11-select'), btn);
      }
      updateCardStates();
    }

    function updateCardStates() {
      const done = roundDone();
      for (const [uid, btn] of cardEls) {
        const p = uidIndex[uid];
        if (!p) continue;
        const pick = draft.selectedPlayers.find((s) => s.id === p.id);
        const badge = btn.querySelector('.bm11-check-badge');
        const setBadge = (show) => {
          if (badge) badge.hidden = !show;
        };
        if (pick && pick.roundPicked === draft.currentRound && !draft.gameComplete) {
          // Placed this round — shown picked; activate to remove the pick.
          btn.classList.add('is-selected');
          btn.classList.remove('is-disabled', 'is-locked');
          btn.setAttribute('aria-pressed', 'true');
          btn.removeAttribute('aria-disabled');
          btn.removeAttribute('title');
          btn.setAttribute('aria-label', `${accessibleName(p)} (placed — activate to remove)`);
          setBadge(true);
        } else if (pick) {
          // Picked in an earlier round (or draft complete) — locked in.
          btn.classList.add('is-selected', 'is-locked');
          btn.classList.remove('is-disabled');
          btn.setAttribute('aria-pressed', 'true');
          btn.setAttribute('aria-disabled', 'true');
          btn.setAttribute('aria-label', `${accessibleName(p)} (locked in from round ${pick.roundPicked})`);
          btn.title = `Locked in from round ${pick.roundPicked}`;
          setBadge(true);
        } else if (draft.gameComplete || done) {
          btn.classList.add('is-disabled');
          btn.classList.remove('is-selected', 'is-locked');
          btn.setAttribute('aria-pressed', 'false');
          btn.setAttribute('aria-disabled', 'true');
          btn.removeAttribute('title');
          btn.setAttribute('aria-label', accessibleName(p));
          setBadge(false);
        } else if (uid === selectedUid) {
          // The candidate waiting for a slot.
          btn.classList.add('is-selected');
          btn.classList.remove('is-disabled', 'is-locked');
          btn.setAttribute('aria-pressed', 'true');
          btn.removeAttribute('aria-disabled');
          btn.removeAttribute('title');
          btn.setAttribute(
            'aria-label',
            `${accessibleName(p)} (selected — choose a glowing slot in your XI, or activate again to cancel)`
          );
          setBadge(false);
        } else {
          // The hard block: a reason means no placement of this player can
          // keep a valid XI reachable (role caps, bad combinations, or the
          // pick would strand a needed role with nobody left in this draw).
          const reason = validatePoolPick(draft, p, draftSupply());
          btn.classList.remove('is-selected', 'is-locked');
          btn.classList.toggle('is-disabled', reason !== null);
          btn.setAttribute('aria-pressed', 'false');
          if (reason) {
            btn.setAttribute('aria-disabled', 'true');
            btn.title = reason;
          } else {
            btn.removeAttribute('aria-disabled');
            btn.removeAttribute('title');
          }
          btn.setAttribute('aria-label', accessibleName(p));
          setBadge(false);
        }
      }
    }

    groupsEl.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-bm11-select]');
      if (!btn) return;
      onPoolClick(btn.getAttribute('data-bm11-select'), btn);
    });

    // Step 1 of drafting: select a pool player as the candidate. They only
    // join the XI once placed into a slot (step 2). Activating the same
    // card again cancels the selection.
    function onPoolClick(uid, btn) {
      const p = uidIndex[uid];
      if (!p || draft.isSpinning) return;
      let justSelected = false;
      const existing = draft.selectedPlayers.find((s) => s.id === p.id);
      if (existing) {
        if (existing.roundPicked !== draft.currentRound || draft.gameComplete) {
          const msg = `${p.name} is locked in from round ${existing.roundPicked} and can't be changed now.`;
          flashMsg(msg);
          announce(msg);
          return;
        }
        // Remove this round's pick (frees its slot too).
        if (selectedUid === uid) {
          selectedUid = null;
        }
        if (moveFrom) moveFrom = null;
        draft = applyDraftDeselect(draft, p.id);
        announce(`Removed ${p.name}. ${draft.selectedPlayers.length} of ${XI_SIZE} selected.`);
      } else if (selectedUid === uid) {
        selectedUid = null;
        announce(`Deselected ${p.name}.`);
      } else {
        const reason = validatePoolPick(draft, p, draftSupply());
        if (reason) {
          flashMsg(reason);
          announce(reason);
          if (btn) {
            btn.classList.add('bm11-nudge');
            window.setTimeout(() => btn.classList.remove('bm11-nudge'), 350);
          }
          return;
        }
        // A pool selection takes over from a pending move or chooser.
        moveFrom = null;
        hideRoleChooser();
        selectedUid = uid;
        justSelected = true;
        flashMsg('');
        announce(
          `Selected ${p.name} — ${groupLabelList(p)}. Choose a glowing slot in your XI.`
        );
      }
      persist();
      renderAll();
      // Mobile: the sheet drops away to reveal the Your XI slots for
      // placement; the toggle brings it back any time.
      if (justSelected && mqMobile.matches) {
        setSheetOpen(false);
        const xiHeading = $('bm11-field-heading');
        if (xiHeading) {
          const reduceMotion = window.matchMedia(
            '(prefers-reduced-motion: reduce)'
          ).matches;
          xiHeading.scrollIntoView({
            behavior: reduceMotion ? 'auto' : 'smooth',
            block: 'start',
          });
        }
      }
    }

    // Shared placement tail: validate once more, then commit the pick with
    // its declared role.
    function placeSelected(p, slotKey, role, supply) {
      const slot = slotByKey(slotKey);
      const reason = validateSlotPlacement(draft, p, slotKey, role, supply);
      if (reason) {
        flashMsg(reason);
        announce(reason);
        return;
      }
      draft = applyDraftPick(draft, p, slotKey, role, supply);
      selectedUid = null;
      flashMsg('');
      persist();
      renderAll();
      // Mobile: when the round still needs picks, the draw sheet pops back
      // up for the next selection. When the round is done (or the XI is
      // complete), it stays down on Your XI with Spin up top to continue.
      if (mqMobile.matches && !draft.gameComplete && !roundDone()) {
        revealDrawSheet();
      } else if (mqMobile.matches && !draft.gameComplete && roundDone()) {
        // Round done on mobile: bring the spin zone back into view so the
        // next spin is one tap away — no manual scroll-up needed.
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        requestAnimationFrame(() => {
          document.querySelector('.bm11-spinzone')?.scrollIntoView({
            behavior: reduceMotion ? 'auto' : 'smooth',
            block: 'start',
          });
        });
      }
      // Note when a placement fills every slot of its group.
      const group = SLOT_GROUPS.find((g) => g.keys.includes(slotKey));
      const filledNote =
        group && group.keys.length > 1 && group.keys.every((k) => draft.slots[k])
          ? ` ${group.label} filled.`
          : '';
      const roleNote = ` as ${XI_ROLE_LABELS[role]}`;
      if (draft.gameComplete) {
        announce(
          `XI complete — ${p.name} placed at ${slot.label}${roleNote}.${filledNote} Your XI of ${XI_SIZE} is ready. Compare XIs to face the house team.`
        );
      } else if (roundDone()) {
        announce(
          `Placed ${p.name} at ${slot.label}${roleNote}.${filledNote} Round ${draft.currentRound} complete — spin again for the next draw.`
        );
      } else {
        const left =
          selectionLimitForRound(draft.currentRound) - draft.picksThisRound.length;
        announce(
          `Placed ${p.name} at ${slot.label}${roleNote}.${filledNote} ${left} more pick${left === 1 ? '' : 's'} this round. ` +
            `${draft.selectedPlayers.length} of ${XI_SIZE} total.`
        );
      }
    }

    // Step 2 of drafting: place the selected pool player into a slot —
    // or, with no pool selection, reposition an XI player (move / swap).
    function onSlotClick(slotKey) {
      const slot = slotByKey(slotKey);
      if (!slot || draft.isSpinning) return;
      const occupantUid = draft.slots[slotKey];

      if (selectedUid) {
        const p = uidIndex[selectedUid];
        if (!p) {
          selectedUid = null;
          renderAll();
          return;
        }
        const supply = draftSupply();
        const options = placementOptions(draft, p, slotKey, supply);
        const legal = options.filter((o) => !o.reason);
        if (!legal.length) {
          const blocked = options.find((o) => o.reason);
          const reason =
            (blocked && blocked.reason) ||
            validatePoolPick(draft, p, supply) ||
            `${p.name} has no legal slot right now.`;
          flashMsg(reason);
          announce(reason);
          return;
        }
        if (legal.length === 1) {
          placeSelected(p, slotKey, legal[0].role, supply);
          return;
        }
        // More than one legal declaration — ask the user which role the
        // player takes (e.g. Sangakkara as batter or keeper). The
        // slot-first default is marked Suggested.
        showRoleChooser(p, slotKey, legal.map((o) => o.role), supply);
        return;
      } else if (moveFrom) {
        if (moveFrom === slotKey) {
          moveFrom = null;
          announce('Move cancelled.');
        } else {
          const reason = validateSlotMove(draft, moveFrom, slotKey, draftSupply(), {
            sameGroupOnly: draft.gameComplete,
          });
          if (reason) {
            flashMsg(reason);
            announce(reason);
            return;
          }
          const mover = draft.selectedPlayers.find(
            (s) => s.uid === draft.slots[moveFrom]?.uid
          );
          const targetOccupied = !!draft.slots[slotKey];
          draft = applyDraftMove(draft, moveFrom, slotKey, draftSupply(), {
            sameGroupOnly: draft.gameComplete,
          });
          moveFrom = null;
          flashMsg('');
          announce(
            mover
              ? `${mover.name} ${targetOccupied ? 'swapped' : 'moved'} to ${slot.label}.`
              : `Moved to ${slot.label}.`
          );
        }
      } else if (occupantUid) {
        // Arm a move: the next slot activated becomes the destination.
        const p = draft.selectedPlayers.find((s) => s.uid === occupantUid);
        moveFrom = slotKey;
        announce(
          p
            ? `Selected ${p.name} from ${slot.label} — ${groupLabelList(p)}. Choose a glowing slot to move them, or ${slot.label} again to cancel.`
            : `Selected ${slot.label}. Choose a glowing slot, or ${slot.label} again to cancel.`
        );
      } else {
        const hint = 'Select a player from your draw first — then choose a slot.';
        flashMsg(hint);
        announce(hint);
        return;
      }
      persist();
      renderAll();
    }

    // Delegated at document level: on mobile the XI slots live outside the
    // aside (static in-page section), so aside-scoped delegation would miss.
    document.addEventListener('click', (e) => {
      const chooserOpt = e.target.closest('[data-bm11-chooser-role]');
      if (chooserOpt) {
        const st = chooserState;
        const role = chooserOpt.getAttribute('data-bm11-chooser-role');
        const p = st && uidIndex[st.uid];
        hideRoleChooser();
        if (st && p && role) placeSelected(p, st.slotKey, role, st.supply);
        return;
      }
      if (e.target.closest('[data-bm11-chooser-cancel]')) {
        hideRoleChooser();
        announce('Role choice cancelled.');
        return;
      }
      const rm = e.target.closest('[data-bm11-deselect]');
      if (rm) {
        const rawId = rm.getAttribute('data-bm11-deselect');
        const p = draft.selectedPlayers.find((s) => s.id === rawId);
        if (!p) return;
        if (selectedUid) {
          selectedUid = null;
        }
        if (moveFrom) moveFrom = null;
        draft = applyDraftDeselect(draft, rawId);
        persist();
        renderAll();
        announce(`Removed ${p.name}. ${draft.selectedPlayers.length} of ${XI_SIZE} selected.`);
        return;
      }
      const slotBtn = e.target.closest('[data-bm11-slot]');
      if (slotBtn) onSlotClick(slotBtn.getAttribute('data-bm11-slot'));
    });

    // Escape cancels a pending pool selection or move.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (chooserState) {
        hideRoleChooser();
        announce('Role choice cancelled.');
        return;
      }
      if (!selectedUid && !moveFrom) return;
      selectedUid = null;
      moveFrom = null;
      renderAll();
      announce('Selection cancelled.');
    });

    // ------------------------------------------------------------ spin history
    function renderHistory() {
      if (!draft.spinHistory.length) {
        historyEl.innerHTML =
          '<li class="bm11-history-empty">No spins yet — your draws will be listed here.</li>';
        return;
      }
      historyEl.innerHTML = draft.spinHistory
        .map((s) => {
          const n = s.picks.length;
          const tail = n > 0 ? ` — ✓ ${n} selected` : ' — no picks';
          return (
            `<li><span class="bm11-history-round">Round ${s.round}</span>` +
            ` — ${esc(eraName(s.era))} · ${esc(s.nation)}${esc(tail)}</li>`
          );
        })
        .join('');
    }

    // ----------------------------------------------------------------- summary
    // The XI panel always renders all 11 fixed slots, grouped in batting
    // Slot-first placement: the tapped position decides the declaration
    // (first legal role in slot order — an all-rounder who can bat
    // middle-order declares as middle-order on a batting slot), except a
    // still-needed keeper-capable player declares as wicketkeeper.
    // No separate role step.

    // Declaration for a slot tap — also what keeps dead-end slots from
    // glowing (null = can't legally fill it).
    function declaredRoleForSlot(p, slotKey, supply) {
      return declarationForSlot(draft, p, slotKey, supply);
    }

    // One-line explainer per role inside the chooser.
    const CHOOSER_SUB = {
      opener: 'Opens the batting',
      'middle-order': 'Bats in the middle order',
      wicketkeeper: 'Fills your keeper slot',
      'all-rounder': 'Batting and bowling value',
      spinner: 'Frontline spin option',
      'fast-bowler': 'Pace attack',
    };

    // Role chooser: only when the tapped slot admits more than one legal
    // declaration. The slot-first default (keeper-preferred) is Suggested;
    // the user can override it.
    function showRoleChooser(p, slotKey, roles, supply) {
      const slot = slotByKey(slotKey);
      const suggested = declarationForSlot(draft, p, slotKey, supply);
      chooserState = { uid: p.uid, slotKey, supply };
      $('bm11-chooser-title').textContent = p.name;
      $('bm11-chooser-sub').textContent =
        `${slot ? slot.label : 'This slot'} takes ${p.name} ` +
        `${roles.length === 2 ? 'two' : roles.length} ways — pick a role:`;
      $('bm11-chooser-options').innerHTML = roles
        .map((role) => {
          const isSugg = role === suggested;
          return (
            `<button type="button" class="bm11-chooser-opt${isSugg ? ' is-suggested' : ''}" ` +
            `data-bm11-chooser-role="${role}">` +
            `<span class="bm11-chooser-opt-name">${esc(XI_ROLE_LABELS[role])}` +
            (isSugg ? ' <span class="bm11-chooser-badge">Suggested</span>' : '') +
            `</span><span class="bm11-chooser-opt-sub">${esc(CHOOSER_SUB[role] || '')}</span></button>`
          );
        })
        .join('');
      const box = $('bm11-role-chooser');
      box.hidden = false;
      const focusTarget =
        box.querySelector('.bm11-chooser-opt.is-suggested') ||
        box.querySelector('.bm11-chooser-opt');
      if (focusTarget) focusTarget.focus();
      announce(
        `${p.name} can play ${roles.map((r) => XI_ROLE_LABELS[r]).join(' or ')} here. Choose a role.`
      );
    }
    function hideRoleChooser() {
      chooserState = null;
      const box = $('bm11-role-chooser');
      if (box) box.hidden = true;
    }
    // One field slot (chip on the cricket ground). Handles four visual
    // states: empty, empty-but-legal-for-the-selected-player (emerald
    // glow), occupied, and occupied-armed-for-move (gold). Slot-first
    // declaration behavior is unchanged — declaredRoleForSlot decides.
    function slotButtonHTML(slotKey) {
      const slot = slotByKey(slotKey);
      const occ = draft.slots[slotKey];
      const occupantUid = occ ? occ.uid : null;
      const occupant = occupantUid
        ? draft.selectedPlayers.find((s) => s.uid === occupantUid)
        : null;
      const pos = FIELD_POSITIONS[slotKey] || { x: 50, y: 50 };
      const classes = ['bm11-fslot'];
      let sub = '';
      let hint = '';
      let ariaLabel = '';
      let pressed = null;
      const slotRoles = slot.roles.map((r) => XI_ROLE_LABELS[r]).join(' · ');
      const accentFor = (p) => ERA_ACCENTS[p.draftEra || p.displayEra] || '#8b5cf6';

      if (occupant && occ) {
        classes.push('is-filled');
        const declared = XI_ROLE_LABELS[occ.role];
        const removable =
          !draft.gameComplete && occupant.roundPicked === draft.currentRound;
        if (moveFrom === slotKey) {
          classes.push('is-armed');
          pressed = 'true';
          sub = 'Selected — tap a glowing slot to move';
          ariaLabel =
            `${occupant.name}, ${declared}, ${slot.label} — selected for moving. ` +
            `Activate a glowing slot to move them, or this slot again to cancel.`;
        } else if (moveFrom && validateSlotMove(draft, moveFrom, slotKey, draftSupply(), {
            sameGroupOnly: draft.gameComplete,
          }) === null) {
          classes.push('is-glow');
          sub = 'Tap to swap';
          ariaLabel =
            `${occupant.name}, ${declared}, ${slot.label} — activate to swap with the selected player.`;
        } else {
          sub = 'Tap to select for moving';
          ariaLabel =
            `${occupant.name}, ${declared}, ${slot.label}. ` +
            `Activate to select for moving.`;
        }
        return (
          `<div class="bm11-fslot-wrap" style="--fx:${pos.x}%;--fy:${pos.y}%;">` +
          `<button type="button" class="${classes.join(' ')}" data-bm11-slot="${esc(slotKey)}"` +
          (pressed ? ` aria-pressed="${pressed}"` : '') +
          ` aria-label="${esc(ariaLabel)}"` +
          ` style="--bm11-era-accent:${esc(accentFor(occupant))}">` +
          `<span class="bm11-fslot-ring"><span class="bm11-fslot-initials">${esc(
            initials(occupant.name)
          )}</span></span>` +
          `<span class="bm11-fslot-label">${esc(occupant.name)}</span>` +
          `<span class="bm11-fslot-sub">${esc(declared)}</span>` +
          `</button>` +
          (removable
            ? `<button type="button" class="bm11-slot-remove" data-bm11-deselect="${esc(
                occupant.id
              )}" aria-label="Remove ${esc(occupant.name)} from XI">×</button>`
            : '') +
          `</div>`
        );
      }

      // Empty slot: the reachable-shapes narrowing keeps labels honest
      // (e.g. the lone open batting slot reads "Wicketkeeper").
      classes.push('is-empty');
      let displayLabel = SLOT_LABEL_OVERRIDES[slotKey] || slot.label;
      if (slot.roles.length > 1) {
        const labelCounts = countsOf(draft);
        const openShapes = reachableShapes(labelCounts);
        const stillOpen = slot.roles.filter((r) =>
          openShapes.some((s) => (labelCounts[r] || 0) < s[r])
        );
        if (stillOpen.length === 1) displayLabel = XI_ROLE_LABELS[stillOpen[0]];
      }
      if (selectedUid && uidIndex[selectedUid]) {
        const p = uidIndex[selectedUid];
        const role = declaredRoleForSlot(p, slotKey, draftSupply());
        if (role) {
          classes.push('is-glow');
          const rl = XI_ROLE_LABELS[role];
          const multi =
            placementOptions(draft, p, slotKey, draftSupply()).filter((o) => !o.reason)
              .length > 1;
          hint = multi ? `Place as ${rl} — choose` : `Place as ${rl}`;
          ariaLabel =
            `${displayLabel} — empty. Activate to place ${p.name}` +
            (multi ? ', then choose a role.' : ` as ${rl}.`);
        } else {
          ariaLabel =
            `${displayLabel} — empty (${slotRoles}). ${p.name} can't play here.`;
        }
      } else if (moveFrom && validateSlotMove(draft, moveFrom, slotKey, draftSupply(), {
            sameGroupOnly: draft.gameComplete,
          }) === null) {
        classes.push('is-glow');
        const moveRole = moveDeclaration(draft, moveFrom, slotKey);
        const curRole = draft.slots[moveFrom]?.role;
        if (moveRole && curRole && moveRole !== curRole) {
          const mrl = XI_ROLE_LABELS[moveRole];
          hint = `Move here as ${mrl}`;
          ariaLabel = `${displayLabel} — empty. Activate to move the selected player here as ${mrl}.`;
        } else {
          hint = 'Move here';
          ariaLabel = `${displayLabel} — empty. Activate to move the selected player here.`;
        }
      } else {
        ariaLabel = `${displayLabel} — empty (${slotRoles}).`;
      }
      return (
        `<div class="bm11-fslot-wrap" style="--fx:${pos.x}%;--fy:${pos.y}%;">` +
        `<button type="button" class="${classes.join(' ')}" data-bm11-slot="${esc(slotKey)}"` +
        ` aria-label="${esc(ariaLabel)}">` +
        `<span class="bm11-fslot-ring">${icon('plus', 20)}</span>` +
        `<span class="bm11-fslot-label">${esc(displayLabel)}</span>` +
        (hint ? `<span class="bm11-fslot-hint">${esc(hint)}</span>` : '') +
        `</button></div>`
      );
    }
    // Composition status: live role counts plus what every reachable XI
    // shape still needs. A valid XI is exactly: 2 openers, 3 middle-order,
    // 1 wicketkeeper, 3 fast bowlers, and a flex pair of 2 all-rounders,
    // all-rounder + spinner, or 2 spinners.
    const ROLE_PLURALS = {
      opener: ['opener', 'openers'],
      'middle-order': ['middle-order batter', 'middle-order batters'],
      wicketkeeper: ['wicketkeeper', 'wicketkeepers'],
      'all-rounder': ['all-rounder', 'all-rounders'],
      spinner: ['spinner', 'spinners'],
      'fast-bowler': ['fast bowler', 'fast bowlers'],
    };
    const XI_ROLE_ORDER = [
      'opener',
      'middle-order',
      'wicketkeeper',
      'all-rounder',
      'spinner',
      'fast-bowler',
    ];

    function renderComposition() {
      const el = $('bm11-comp');
      const counts = countsOf(draft);
      const bits = XI_ROLE_ORDER.map((r) => {
        const n = counts[r];
        const [one, many] = ROLE_PLURALS[r];
        return `${n} ${n === 1 ? one : many}`;
      });
      let needHTML = '';
      if (isXIValid(draft)) {
        needHTML = `<span class="bm11-comp-need is-done">Valid XI combination</span>`;
      } else {
        const shapes = reachableShapes(counts);
        const must = [];
        if (shapes.length) {
          for (const r of XI_ROLE_ORDER) {
            const need = Math.min(...shapes.map((s) => s[r] - counts[r]));
            if (need > 0) {
              const [one, many] = ROLE_PLURALS[r];
              must.push(`${need} ${need === 1 ? one : many}`);
            }
          }
        }
        if (must.length) {
          needHTML = `<span class="bm11-comp-need">Still need: ${esc(must.join(', '))}</span>`;
        }
      }
      el.innerHTML =
        `<span class="bm11-comp-counts">${esc(bits.join(' · '))}</span>` + needHTML;
    }

    // Single render entry: updates the XI field, the persistent game bar
    // (x/11, current draw, round), the composition status, and the
    // Compare-XIs CTA.
    function renderSummary() {
      const placed = draft.selectedPlayers.length;
      $('bm11-count').textContent = `${placed}/${XI_SIZE}`;
      $('bm11-progress-fill').style.width = `${(placed / XI_SIZE) * 100}%`;

      // Persistent game bar: current draw + round, always visible.
      const drawBar = $('bm11-gamebar-draw');
      if (draft.currentEra && draft.currentNation) {
        drawBar.innerHTML =
          `<span class="bm11-gamebar-era">${esc(eraName(draft.currentEra))}</span>` +
          `<span class="bm11-gamebar-nation">${esc(draft.currentNation)}</span>`;
      } else {
        drawBar.innerHTML =
          '<span class="bm11-gamebar-draw-idle">Spin to begin</span>';
      }
      $('bm11-gamebar-round').textContent =
        draft.currentRound === 0
          ? `Round 1 of ${DRAFT_ROUNDS}`
          : `Round ${draft.currentRound} of ${DRAFT_ROUNDS}`;

      // The XI, on the field: all 11 fixed slots, positioned.
      const fslotsEl = $('bm11-fslots');
      fslotsEl.innerHTML = XI_SLOTS.map((s) => slotButtonHTML(s.key)).join('');

      // Newly filled slots pop onto the field (Motion; skipped under
      // reduced motion, and skipped when slots are re-rendered without
      // new placements).
      const filledNow = new Set(
        Object.keys(draft.slots).filter((k) => draft.slots[k])
      );
      if (!reduceMotion()) {
        for (const key of filledNow) {
          if (prevFilled.has(key)) continue;
          const el = fslotsEl.querySelector(`[data-bm11-slot="${key}"]`);
          if (el) {
            animate(
              el,
              { scale: [0.3, 1.12, 1], opacity: [0, 1, 1] },
              { duration: 0.5, easing: [0.22, 1, 0.36, 1] }
            );
          }
        }
      }
      prevFilled = filledNow;

      renderComposition();

      // Compare XIs unlocks only on a valid XI — exactly the combinations
      // the hard block enforces during the draft. Guarded anyway for drafts
      // restored from older saves.
      const ready = isXIValid(draft);
      ctaEl.classList.toggle('is-disabled', !ready);
      ctaEl.setAttribute('aria-disabled', ready ? 'false' : 'true');

      const stalled =
        !draft.gameComplete &&
        draft.currentRound >= DRAFT_ROUNDS &&
        roundDone() &&
        draft.currentRound > 0;
      if (stalled) {
        flashMsg(
          'XI incomplete — a tiny pool left your draft short of 11. Start over to try again.'
        );
      }

      // Start over is only offered when the draft is a dead end: stalled
      // short of 11, or complete but not a valid combination. A live draft
      // never shows it.
      const deadEnd = stalled || (draft.gameComplete && !isXIValid(draft));
      $('bm11-startover').hidden = !deadEnd;
    }
    ctaEl.addEventListener('click', (e) => {
      if (isXIValid(draft)) return; // let the link through
      e.preventDefault();
      if (draft.gameComplete) {
        const msg =
          'This XI is not a valid combination — start over to draft a valid XI.';
        flashMsg(msg);
        announce(msg);
        $('bm11-startover').hidden = false;
      } else {
        const need = XI_SIZE - draft.selectedPlayers.length;
        flashMsg(`Place ${need} more player${need === 1 ? '' : 's'} to complete your XI.`);
        announce(`Your XI is incomplete. ${need} more needed.`);
      }
    });

    $('bm11-toggle').addEventListener('click', () => {
      setSheetOpen(!summaryEl.classList.contains('is-open'));
    });

    // ------------------------------------------------------------------ render
    function renderAll() {
      renderSpinZone();
      renderPool();
      renderHistory();
      renderSummary();
    }

    // --------------------------------------------------------------- restore
    // Panels must be in their breakpoint-correct homes before the first
    // render populates them.
    layoutPanels();
    // Re-slice the XI groups when crossing the mobile breakpoint.
    mqMobile.addEventListener('change', () => {
      layoutPanels();
      renderSummary();
    });
    (function restore() {
      const raw = loadDraft();
      if (!raw) {
        renderAll();
        return;
      }
      const restored = deserializeDraft(raw, (uid) => uidIndex[uid] || null);
      if (!restored || !restored.selectedPlayers.length) {
        clearDraft();
        renderAll();
        return;
      }
      draft = restored;
      renderAll();
      // Mobile: if the restored draft has a live draw with picks remaining,
      // reopen the draw sheet so choosing can continue where it left off.
      if (
        mqMobile.matches &&
        !draft.gameComplete &&
        draft.currentEra &&
        draft.currentNation &&
        !roundDone()
      ) {
        revealDrawSheet();
      }
      if (draft.gameComplete) {
        announce('Welcome back — your XI is complete. Compare XIs to face the house team.');
      } else {
        announce(
          `Welcome back — restored your draft: round ${draft.currentRound} of ${DRAFT_ROUNDS}, ` +
            `${draft.selectedPlayers.length} of ${XI_SIZE} selected.`
        );
      }
    })();
  </script>

