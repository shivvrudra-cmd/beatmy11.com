---
/**
 * /play — the Test draft. The screen itself is src/components/DraftGame.astro; this page
 * supplies the Test players, spin combos and labels.
 */
import DraftGame from '@/components/DraftGame.astro';
import { allPlayersByEra, legendsSpinCombos, draftSpinCombos } from '@/lib/player-store';
import { TEST_FORMAT } from '@/lib/formats/draft-format';
---
<DraftGame
  format={TEST_FORMAT}
  title="Play Beat My 11 — Draft Your All-Time XI"
  description="Spin to draw an era and nation, draft 11 players across six rounds, then take your XI into a five-Test series against the house team."
  playersByEra={allPlayersByEra()}
  round1Combos={legendsSpinCombos()}
  draftCombos={draftSpinCombos()}
/>
