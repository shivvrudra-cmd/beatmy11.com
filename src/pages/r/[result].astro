---
/**
 * /r/<user>-<house> — a shared Test series result. The screen is components/SharedResult.astro.
 */
import SharedResult from '../../components/SharedResult.astro';
import { SHARE_RESULTS, type ShareResult } from '../../lib/share-results';
import { ERA_IDS, playersForEra } from '../../lib/player-store';
import { TEST_FORMAT } from '../../lib/formats/draft-format';

export function getStaticPaths() {
  return SHARE_RESULTS.map((r) => ({ params: { result: r.slug }, props: { r } }));
}

const { r } = Astro.props as { r: ShareResult };
const names: Record<string, [string, string]> = {};
for (const era of ERA_IDS) for (const p of playersForEra(era)) names[p.id] ??= [p.name, TEST_FORMAT.teamCodes[p.nation] ?? p.nation];
---
<SharedResult r={r} names={names} eyebrow="The five-Test series" opponent="World XI" playHref="/play" ogImage={`/og/${r.slug}.png`} />
