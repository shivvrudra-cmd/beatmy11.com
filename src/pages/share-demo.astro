---
/**
 * share-demo — an internal gallery of the link-preview images: the default
 * one and one per series scoreline, each linked to the /r page that uses
 * it. Regenerate the images with `npx tsx scripts/gen-og-images.ts`.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FloodlitShell from '../components/FloodlitShell.astro';
import { SHARE_RESULTS } from '../lib/share-results';

const title = 'Share Previews | Beat My 11';
const description = 'The link-preview images Beat My 11 shows when a page or a series result is shared.';

const previews = [
  { src: '/og-image.png', label: 'Default', title: 'Every page', href: '/' },
  ...SHARE_RESULTS.map((r) => ({ src: `/og/${r.slug}.png`, label: r.slug.replace('-', '–'), title: r.title, href: `/r/${r.slug}` })),
];
---

<BaseLayout title={title} description={description}>
  <meta name="robots" content="noindex, nofollow" slot="head" />
  <FloodlitShell wide>
    <section class="sd" aria-labelledby="sd-title">
      <p class="fs-eyebrow">Internal</p>
      <h1 class="fs-title" id="sd-title">Share previews</h1>
      <p class="fs-lede">
        What a shared link shows in WhatsApp, X, iMessage and the rest. “Share result” links to
        the scoreline’s page, so the preview matches the result.
      </p>
      <ul class="sd-grid">
        {previews.map((p) => (
          <li class="sd-item">
            <a href={p.href} class="sd-card">
              <img src={p.src} width="1200" height="630" loading="lazy" alt={`Link preview: ${p.title}`} />
              <span class="sd-meta">
                <span class="sd-label">{p.label}</span>
                <span class="sd-title">{p.title}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </FloodlitShell>

  <style is:global>
    .sd { margin: 6vh auto 0; text-align: center; }
    .sd-grid { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 16px; text-align: left; }
    .sd-card {
      display: block; overflow: hidden; border-radius: 14px; background: var(--fs-card);
      border: 1px solid rgba(255, 255, 255, 0.1); color: var(--fs-text); text-decoration: none;
      transition: border-color 0.15s, transform 0.15s;
    }
    .sd-card:hover { border-color: rgba(198, 255, 61, 0.5); transform: translateY(-2px); }
    .sd-card img { display: block; width: 100%; height: auto; }
    .sd-meta { display: flex; align-items: baseline; gap: 10px; padding: 10px 14px; }
    .sd-label { font: 400 24px/1 var(--fs-display); letter-spacing: 0.05em; color: var(--fs-lime); }
    .sd-title { font-size: 14px; color: var(--fs-muted); }
    @media (min-width: 760px) {
      .sd-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (prefers-reduced-motion: reduce) {
      .sd-card { transition: none; }
    }
  </style>
</BaseLayout>
