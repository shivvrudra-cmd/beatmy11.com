{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beatmy11",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "beatmy11.com", "custom_domain": true },
    { "pattern": "www.beatmy11.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beatmy11",
      "database_id": "f59d23b5-4d3d-4149-a97a-71ea6fae4c85",
      "migrations_dir": "migrations"
    }
  ],
  // Branch/PR previews run against a separate empty database, never production.
  "previews": {
    "d1_databases": [
      {
        "binding": "DB",
        "database_id": "e118ee36-991e-478e-904c-749a73a9bfdb"
      }
    ],
    // Previews do not inherit the production limiter below; same limit, its own counter.
    "ratelimits": [
      { "name": "API_LIMIT", "namespace_id": "3418", "simple": { "limit": 120, "period": 60 } }
    ]
  },
  // The ids must be unique in the whole Cloudflare account: on 2026-10-03 production with id 1101 refused
  // from the 11th request, not the 120th, so the id was moved to a fresh one.
  // Rate limiting for /api/* (worker/index.ts). Counted by Cloudflare per location, for at most a
  // minute; nothing is stored by the site. Generous on purpose: many phone users in India share one
  // address (carrier-grade NAT), and the counters are fire-and-forget anyway.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "3417", "simple": { "limit": 120, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
